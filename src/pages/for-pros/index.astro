---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SplitSection from "../../components/SplitSection.astro";
import Faq from "../../components/Faq.astro";
import Tile from "../../components/Tile.astro";
import { needPlaces, coverage } from "../../config/coverage";
import { places } from "../../data/places";
import { counties, type CountyId } from "../../data/permits";

const inputClass =
  "w-full rounded-lg border border-secondary-300 bg-white px-4 py-3 text-secondary-900 outline-hidden transition focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20";
const services = ["Tree removal", "Emergency tree removal", "Tree trimming and pruning", "Stump grinding", "Arborist assessments", "Crane work", "Palm trimming"];

const faqs = [
  {
    q: "What does a listing include?",
    a: `A company page in the directory with your services, counties and cities, your phone number and website, and links from the city and county pages that match your area. Featured placement is available as a sponsored listing. Applications are reviewed by hand and listings are added manually.`,
  },
  {
    q: "Does SF Tree Removal verify licenses and insurance?",
    a: `No. Listings show what each company says about itself, labeled as the company's own statements, and visitors are told to ask for proof. You are responsible for the accuracy of what you submit.`,
  },
  {
    q: "Do you guarantee leads?",
    a: `No. Visitors choose whom to contact, and no volume of calls or requests is promised.`,
  },
  {
    q: "How are sponsored listings marked?",
    a: `They are labeled "Sponsored", placed above other listings, and links to the company carry rel="sponsored" so search engines treat them as paid placements.`,
  },
];
---

<BaseLayout
  title="For Tree Pros: Get Listed in the SF Tree Removal Directory"
  description="Tree service companies in South Florida can get a listing in the SF Tree Removal directory, with standard or sponsored featured placement."
>
  <PageHero
    badge="FOR TREE PROS"
    title="Get Your Tree Company Listed"
    lead="Reach South Florida homeowners looking for tree removal, trimming and stump grinding."
    actions={false}
    image="crane-lift"
  />

  <section class="bg-secondary-50 py-12">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <p class="topper mb-3">Where we need tree companies</p>
      <h2 class="font-heading text-2xl font-extrabold text-secondary-900">Homeowners Ask, We Need Professionals</h2>
      <p class="mx-auto mt-3 max-w-2xl text-secondary-600">We are active in {coverage.activeLabel.toLowerCase()}. Requests come in from the cities below and have no professional behind them yet. Apply to cover one.</p>
      <ul class="mt-6 flex flex-wrap justify-center gap-3">
        {needPlaces().map((p) => <li><a href={`/for-pros/?city=${encodeURIComponent(p.name)}#apply`} class="rounded-full border border-primary-300 bg-white px-5 py-2 text-sm font-semibold text-primary-800 shadow-sm transition hover:bg-primary-50">{p.name}</a></li>)}
        <li><a href="/areas/#coverage" class="rounded-full border border-secondary-300 bg-white px-5 py-2 text-sm font-semibold text-secondary-700 shadow-sm transition hover:bg-secondary-50">All cities →</a></li>
      </ul>
    </div>
  </section>

  <section id="apply" class="scroll-mt-28 py-section">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <SectionHeading topper="How it works" title="List Your Company" description="Fill in the form. Applications go to SF Tree Removal only, are reviewed by hand, and listings are added manually." />
      <form data-lead-form="pro-listing" data-lead-ignore data-steps class="form-card" novalidate>
        <input type="hidden" name="lead_type" value="Directory listing application (manual review, not shared with any company)" />
        <!-- Progress -->
        <div data-progress class="relative mb-10">
          <div class="absolute left-[16.6%] right-[16.6%] top-5 h-1 rounded-full bg-secondary-100" aria-hidden="true">
            <div data-fill class="h-full w-0 rounded-full bg-primary-600 transition-all duration-500"></div>
          </div>
          <ol class="relative grid grid-cols-3 text-center">
            {["Your company", "Coverage", "Listing"].map((t, i) => (
              <li class="flex flex-col items-center gap-2">
                <span data-dot class:list={["grid size-10 place-items-center rounded-full font-heading font-bold transition", i === 0 ? "bg-primary-600 text-white" : "bg-secondary-100 text-secondary-500"]}>{i + 1}</span>
                <span data-label class:list={["text-xs font-semibold sm:text-sm", i === 0 ? "text-secondary-900" : "text-secondary-400"]}>{t}</span>
              </li>
            ))}
          </ol>
        </div>

        <!-- Step 1 -->
        <fieldset data-step class="is-current space-y-5">
          <legend class="mb-1 font-heading text-2xl font-extrabold text-secondary-900">Tell us about your company</legend>
          <p class="-mt-2 text-secondary-600">We use this to review your listing and contact you.</p>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="field-label">Company name *</span><input name="company" required autocomplete="organization" class="field-input" /></label>
            <label class="block"><span class="field-label">Your name *</span><input name="name" required autocomplete="name" class="field-input" /></label>
            <label class="block"><span class="field-label">Phone *</span><input name="phone" type="tel" required autocomplete="tel" placeholder="(954) 555-0100" class="field-input" /></label>
            <label class="block"><span class="field-label">Email *</span><input name="email" type="email" required autocomplete="email" placeholder="you@company.com" class="field-input" /></label>
            <label class="block sm:col-span-2"><span class="field-label">Website</span><input name="website" type="url" placeholder="https://" class="field-input" /><span class="field-hint">Optional. Shown on your listing if approved.</span></label>
          </div>
        </fieldset>

        <!-- Step 2 -->
        <fieldset data-step class="space-y-6">
          <legend class="mb-1 font-heading text-2xl font-extrabold text-secondary-900">Where and what do you work on?</legend>
          <div>
            <p class="field-label">Counties you serve</p>
            <div class="grid gap-3 sm:grid-cols-3">
              {(Object.keys(counties) as CountyId[]).map((c) => <Tile type="checkbox" name="counties" value={counties[c]} label={counties[c]} icon="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z" />)}
            </div>
          </div>
          <div>
            <p class="field-label">Services</p>
            <div class="grid gap-3 sm:grid-cols-2">
              {services.map((s) => <Tile type="checkbox" name="services" value={s} label={s} />)}
            </div>
          </div>
          <label class="block"><span class="field-label">Cities you serve</span><input name="cities" placeholder="Fort Lauderdale, Plantation, Davie…" class="field-input" /></label>
        </fieldset>

        <!-- Step 3 -->
        <fieldset data-step class="space-y-6">
          <legend class="mb-1 font-heading text-2xl font-extrabold text-secondary-900">Choose your listing</legend>
          <div class="grid gap-3 sm:grid-cols-3">
            <Tile name="listing" value="Standard listing" label="Standard listing" description="Your company page and links from matching city pages." checked />
            <Tile name="listing" value="Sponsored featured listing" label="Sponsored listing" description="Featured placement above others, marked Sponsored." />
            <Tile name="listing" value="Not sure yet" label="Not sure yet" description="Tell us about your company and we will explain the options." />
          </div>
          <label class="block"><span class="field-label">License and insurance details</span><textarea name="credentials" rows="3" class="field-input" placeholder="Shown on your listing only if you provide them, as your own statements."></textarea><span class="field-hint">We do not verify licenses or insurance; listings say so.</span></label>
          <label class="block"><span class="field-label">Anything else?</span><textarea name="message" rows="3" class="field-input" placeholder="Equipment, specialties, anything we should know"></textarea></label>
          <input name="website_hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <p data-lead-error hidden class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></p>
        </fieldset>

        <!-- Controls -->
        <div class="mt-8 flex items-center justify-between gap-4 border-t border-secondary-100 pt-6">
          <button type="button" data-back class="btn btn-outline js-only !px-5">← Back</button>
          <div class="ml-auto flex items-center gap-3">
            <button type="button" data-next class="btn btn-accent js-only">Continue →</button>
            <button type="submit" data-submit class="btn btn-accent">Send for review</button>
          </div>
        </div>
        <p class="mt-4 text-xs text-secondary-500">By sending this form you agree to our <a href="/privacy-policy/" class="underline">Privacy Policy</a>. No obligation, and no volume of requests is promised.</p>
      </form>
    </div>
  </section>

  <SplitSection
    topper="What a listing does"
    title="Be Found Where Homeowners Look"
    image="canopy-climber"
    tone="tint"
    html={`<p>Your company gets a page with your services, counties, cities and contact details, and links from the city and county pages that match your area. Homeowners reading about permits, costs and storm damage can click through to you.</p><p>Sponsored placement puts your listing above the others and on matching city pages, clearly marked as sponsored.</p>`}
  />

  <Faq faqs={faqs} tone="white" />

  <script>
    const city = new URLSearchParams(location.search).get("city");
    const input = document.querySelector<HTMLInputElement>('input[name="cities"]');
    if (city && input && !input.value) input.value = city;
  </script>
</BaseLayout>
