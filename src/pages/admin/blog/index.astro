---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../../lib/supabaseAdmin";
import { supabase } from "../../../lib/supabase";

const db = supabaseAdmin ?? supabase;

const { data: postsRaw } = await db
  .from("blog_posts")
  .select("id, title, slug, category, status, cover_image_url, published_at, updated_at")
  .order("updated_at", { ascending: false });

const posts = postsRaw || [];
---

<AdminLayout>
  <div class="dash-shell flex-1"><div class="dash-scroll">
    <div class="w-full space-y-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <a href="/admin" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-zinc-200 text-[11px] font-bold uppercase tracking-wider text-zinc-600 hover:bg-zinc-50">← Back</a>
          <div>
            <span class="dash-eyebrow text-blue-700">// Content</span>
            <h1 class="mt-1.5 text-2xl font-bold text-slate-950 tracking-tight">Blog</h1>
            <p class="text-[10px] font-mono text-slate-400 mt-1 uppercase">Total: {posts.length}</p>
          </div>
        </div>
        <a href="/admin/blog/new" class="inline-flex h-11 items-center gap-2 px-5 rounded-xl bg-green-500 text-xs font-bold text-slate-900 hover:bg-green-400 transition-all">
          + New Post
        </a>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <input
          id="blogSearch"
          type="text"
          placeholder="Search by title..."
          class="flex-1 h-11 rounded-lg border border-zinc-200 bg-white px-4 text-sm text-slate-900 placeholder-zinc-400 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500"
        />
        <select id="blogStatusFilter" class="h-11 rounded-lg border border-zinc-200 bg-white px-4 text-sm text-slate-900 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
          <option value="">All statuses</option>
          <option value="published">Published</option>
          <option value="draft">Draft</option>
        </select>
      </div>

      <div class="rounded-2xl border border-zinc-200 bg-white overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-zinc-100 bg-zinc-50">
                <th class="px-6 py-4 text-left text-[10px] font-bold uppercase tracking-wider text-zinc-600">Post</th>
                <th class="px-6 py-4 text-left text-[10px] font-bold uppercase tracking-wider text-zinc-600">Category</th>
                <th class="px-6 py-4 text-center text-[10px] font-bold uppercase tracking-wider text-zinc-600">Status</th>
                <th class="px-6 py-4 text-left text-[10px] font-bold uppercase tracking-wider text-zinc-600">Updated</th>
                <th class="px-6 py-4 text-right text-[10px] font-bold uppercase tracking-wider text-zinc-600">Action</th>
              </tr>
            </thead>
            <tbody id="blogTable">
              {posts.map((p: any) => (
                <tr class="blogRow border-b border-zinc-100 hover:bg-zinc-50/50 transition-colors" data-id={p.id} data-title={p.title} data-status={p.status}>
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      {p.cover_image_url ? (
                        <img src={p.cover_image_url} alt="" class="w-10 h-10 rounded-lg object-cover border border-zinc-200 shrink-0" />
                      ) : (
                        <div class="w-10 h-10 rounded-lg bg-zinc-100 border border-zinc-200 shrink-0"></div>
                      )}
                      <p class="text-[13px] font-bold text-slate-900">{p.title}</p>
                    </div>
                  </td>
                  <td class="px-6 py-4"><p class="text-[11px] text-slate-500">{p.category || '—'}</p></td>
                  <td class="px-6 py-4 text-center">
                    <span class={`inline-flex items-center justify-center rounded-full px-2.5 py-1 text-[9px] font-bold uppercase ${p.status === 'published' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-amber-50 text-amber-700 border border-amber-200'}`}>
                      {p.status}
                    </span>
                  </td>
                  <td class="px-6 py-4"><p class="text-[10px] text-zinc-400 font-mono">{new Date(p.updated_at).toLocaleDateString()}</p></td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <a href={`/admin/blog/${p.id}`} class="inline-flex h-8 items-center px-3 rounded-lg bg-blue-50 border border-blue-200 text-[10px] font-bold text-blue-700 hover:bg-blue-100 transition-colors">Edit</a>
                      <button class="delete-post-btn inline-flex h-8 items-center px-3 rounded-lg border border-red-200 text-[10px] font-bold text-red-600 hover:bg-red-50 transition-colors" data-id={p.id}>Delete</button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {posts.length === 0 && (
          <div class="px-6 py-12 text-center">
            <p class="text-slate-400 text-sm">No posts yet — click "+ New Post" to write one.</p>
          </div>
        )}
      </div>
    </div>
  </div></div>
</AdminLayout>

<script>
  import { supabase } from "../../../lib/supabase";

  async function adminFetch(url: string, init: RequestInit = {}) {
    const { data } = await supabase.auth.getSession();
    const token = data.session?.access_token;
    return fetch(url, { ...init, headers: { ...(init.headers || {}), ...(token ? { Authorization: `Bearer ${token}` } : {}) } });
  }

  const search = document.getElementById('blogSearch') as HTMLInputElement;
  const statusFilter = document.getElementById('blogStatusFilter') as HTMLSelectElement;
  const rows = Array.from(document.querySelectorAll('.blogRow'));

  function applyFilters() {
    const query = search.value.toLowerCase();
    const status = statusFilter.value;
    rows.forEach((row) => {
      const title = ((row as HTMLElement).dataset.title || '').toLowerCase();
      const rowStatus = (row as HTMLElement).dataset.status || '';
      const matches = title.includes(query) && (!status || rowStatus === status);
      (row as HTMLElement).classList.toggle('hidden', !matches);
    });
  }

  search?.addEventListener('input', applyFilters);
  statusFilter?.addEventListener('change', applyFilters);

  document.querySelectorAll<HTMLButtonElement>('.delete-post-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this post permanently?')) return;
      const id = btn.dataset.id;
      const res = await adminFetch(`/api/blog-posts?id=${id}`, { method: 'DELETE' });
      if (res.ok) {
        document.querySelector(`.blogRow[data-id="${id}"]`)?.remove();
      } else {
        alert('Could not delete post.');
      }
    });
  });
</script>
