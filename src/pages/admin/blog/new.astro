---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout>
  <div class="dash-shell flex-1"><div class="dash-scroll">
    <div class="w-full max-w-5xl mx-auto space-y-6">
      <div class="flex items-center gap-3">
        <a href="/admin/blog" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-zinc-200 text-[11px] font-bold uppercase tracking-wider text-zinc-600 hover:bg-zinc-50">← Back</a>
        <div>
          <span class="dash-eyebrow text-blue-700">// Content</span>
          <h1 class="mt-1.5 text-2xl font-bold text-slate-950 tracking-tight">New Post</h1>
        </div>
      </div>

      <form id="postForm" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
          <div class="rounded-2xl border border-zinc-200 bg-white p-6">
            <label class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-slate-600">Post Title *</label>
            <input id="postTitle" type="text" required placeholder="Enter your post title..." class="w-full h-12 rounded-xl border border-zinc-200 px-4 text-sm" />
          </div>

          <div class="rounded-2xl border border-zinc-200 bg-white p-6">
            <label class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-slate-600">Excerpt / Summary</label>
            <textarea id="postExcerpt" rows="3" maxlength="200" placeholder="Write a brief summary of your post..." class="w-full rounded-xl border border-zinc-200 p-4 text-sm"></textarea>
            <p class="mt-2 text-[10px] text-zinc-400"><span id="excerptCount">0</span>/200 characters — shown in the blog listing.</p>
          </div>

          <div class="rounded-2xl border border-zinc-200 bg-white p-6">
            <label class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-slate-600">Content *</label>
            <textarea id="postContent" rows="16" required placeholder="Start writing your post content here... You can use HTML." class="w-full rounded-xl border border-zinc-200 p-4 text-sm font-mono"></textarea>
          </div>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl border border-zinc-200 bg-white p-6">
            <label class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-slate-600">Cover Image</label>
            <input id="coverFile" type="file" accept="image/*" class="hidden" />
            <button type="button" id="coverUploadBtn" class="w-full h-40 rounded-xl border-2 border-dashed border-zinc-200 flex flex-col items-center justify-center gap-2 text-zinc-400 hover:border-blue-300 transition-colors overflow-hidden">
              <img id="coverPreview" class="hidden w-full h-full object-cover" />
              <span id="coverPlaceholder" class="text-[11px]">Click to upload<br />PNG, JPG up to 5MB</span>
            </button>
          </div>

          <div class="rounded-2xl border border-zinc-200 bg-white p-6">
            <label class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-slate-600">Category *</label>
            <input id="postCategory" type="text" placeholder="e.g. Tree Care Tips" class="w-full h-11 rounded-xl border border-zinc-200 px-4 text-sm" />
          </div>

          <div class="rounded-2xl border border-zinc-200 bg-white p-6">
            <label class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-slate-600">Tags</label>
            <div class="flex gap-2">
              <input id="tagInput" type="text" placeholder="Add a tag..." class="flex-1 h-10 rounded-lg border border-zinc-200 px-3 text-sm" />
              <button type="button" id="addTagBtn" class="h-10 px-4 rounded-lg border border-zinc-200 text-xs font-bold text-slate-600 hover:bg-zinc-50">Add</button>
            </div>
            <div id="tagList" class="mt-3 flex flex-wrap gap-2"></div>
            <p class="mt-2 text-[10px] text-zinc-400">Press Enter to add a tag.</p>
          </div>

          <div class="rounded-2xl border border-zinc-200 bg-white p-6 space-y-4">
            <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-600">SEO</h3>
            <div>
              <label class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Meta Title *</label>
              <input id="postMetaTitle" type="text" class="w-full h-10 rounded-lg border border-zinc-200 px-3 text-sm" />
            </div>
            <div>
              <label class="mb-2 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Meta Description *</label>
              <textarea id="postMetaDescription" rows="3" class="w-full rounded-lg border border-zinc-200 p-3 text-sm"></textarea>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <button type="submit" id="publishBtn" class="h-12 rounded-xl bg-blue-600 text-xs font-bold uppercase tracking-wider text-white hover:bg-blue-700">Publish</button>
            <button type="submit" id="saveDraftBtn" class="h-12 rounded-xl border border-zinc-200 text-xs font-bold uppercase tracking-wider text-slate-600 hover:bg-zinc-50">Save Draft</button>
            <p id="formMsg" class="text-[11px] text-center"></p>
          </div>
        </div>
      </form>
    </div>
  </div></div>
</AdminLayout>

<script>
  import { supabase } from "../../../lib/supabase";

  async function adminFetch(url: string, init: RequestInit = {}) {
    const { data } = await supabase.auth.getSession();
    const token = data.session?.access_token;
    return fetch(url, { ...init, headers: { ...(init.headers || {}), ...(token ? { Authorization: `Bearer ${token}` } : {}) } });
  }

  let tags: string[] = [];
  let coverImageBase64: string | null = null;

  function renderTags() {
    const list = document.getElementById('tagList')!;
    list.innerHTML = tags.map((t, i) => `
      <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-100 px-3 py-1.5 text-[11px] font-bold text-slate-700">
        ${t}
        <button type="button" data-idx="${i}" class="remove-tag-btn text-zinc-400 hover:text-red-600">×</button>
      </span>
    `).join('');
    list.querySelectorAll<HTMLButtonElement>('.remove-tag-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        tags.splice(Number(btn.dataset.idx), 1);
        renderTags();
      });
    });
  }

  function addTagFromInput() {
    const input = document.getElementById('tagInput') as HTMLInputElement;
    const value = input.value.trim();
    if (value && !tags.includes(value)) {
      tags.push(value);
      renderTags();
    }
    input.value = '';
  }

  document.getElementById('addTagBtn')?.addEventListener('click', addTagFromInput);
  document.getElementById('tagInput')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') {
      e.preventDefault();
      addTagFromInput();
    }
  });

  const excerptEl = document.getElementById('postExcerpt') as HTMLTextAreaElement;
  const excerptCount = document.getElementById('excerptCount')!;
  excerptEl?.addEventListener('input', () => {
    excerptCount.textContent = excerptEl.value.length.toString();
    excerptCount.className = excerptEl.value.length > 200 ? 'text-red-600' : '';
  });

  const coverFile = document.getElementById('coverFile') as HTMLInputElement;
  const coverPreview = document.getElementById('coverPreview') as HTMLImageElement;
  const coverPlaceholder = document.getElementById('coverPlaceholder')!;
  document.getElementById('coverUploadBtn')?.addEventListener('click', () => coverFile.click());
  coverFile?.addEventListener('change', () => {
    const file = coverFile.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      coverImageBase64 = reader.result as string;
      coverPreview.src = coverImageBase64;
      coverPreview.classList.remove('hidden');
      coverPlaceholder.classList.add('hidden');
    };
    reader.readAsDataURL(file);
  });

  async function submitPost(status: 'draft' | 'published') {
    const msg = document.getElementById('formMsg')!;
    const title = (document.getElementById('postTitle') as HTMLInputElement).value.trim();
    if (!title) {
      msg.textContent = 'Title is required.';
      msg.className = 'text-[11px] text-center text-red-600';
      return;
    }

    const publishBtn = document.getElementById('publishBtn') as HTMLButtonElement;
    const saveDraftBtn = document.getElementById('saveDraftBtn') as HTMLButtonElement;
    publishBtn.disabled = true;
    saveDraftBtn.disabled = true;
    msg.textContent = 'Saving...';
    msg.className = 'text-[11px] text-center text-slate-400';

    const payload: Record<string, unknown> = {
      title,
      excerpt: excerptEl.value.trim(),
      content: (document.getElementById('postContent') as HTMLTextAreaElement).value,
      category: (document.getElementById('postCategory') as HTMLInputElement).value.trim(),
      tags,
      status,
      meta_title: (document.getElementById('postMetaTitle') as HTMLInputElement).value.trim(),
      meta_description: (document.getElementById('postMetaDescription') as HTMLTextAreaElement).value.trim(),
    };
    if (coverImageBase64) payload.coverImageBase64 = coverImageBase64;

    const res = await adminFetch('/api/blog-posts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json().catch(() => ({}));

    if (!res.ok || !result.ok) {
      msg.textContent = `Error: ${result.error || 'unknown error'}`;
      msg.className = 'text-[11px] text-center text-red-600';
      publishBtn.disabled = false;
      saveDraftBtn.disabled = false;
      return;
    }

    window.location.href = `/admin/blog/${result.post.id}`;
  }

  document.getElementById('postForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const submitter = (e as SubmitEvent).submitter as HTMLButtonElement | null;
    submitPost(submitter?.id === 'saveDraftBtn' ? 'draft' : 'published');
  });
</script>
