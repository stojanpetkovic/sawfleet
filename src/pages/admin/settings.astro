  // --- Paginacija liste naloga (10 po strani), primenjena NAKON pretrage ---
  const BULK_CREDIT_PAGE_SIZE = 10;
  const allBulkCreditRows = Array.from(document.querySelectorAll<HTMLElement>('.bulk-credit-row'));
  let bulkCreditPage = 0;

  function renderBulkCreditPage() {
    const q = (document.getElementById('bulkCreditSearch') as HTMLInputElement)?.value.trim().toLowerCase() || '';
    const matching = allBulkCreditRows.filter((row) => !q || (row.dataset.name || '').includes(q));
    const totalPages = Math.max(1, Math.ceil(matching.length / BULK_CREDIT_PAGE_SIZE));
    bulkCreditPage = Math.min(bulkCreditPage, totalPages - 1);
    const start = bulkCreditPage * BULK_CREDIT_PAGE_SIZE;
    const visible = new Set(matching.slice(start, start + BULK_CREDIT_PAGE_SIZE));

    allBulkCreditRows.forEach((row) => { row.style.display = matching.includes(row) && visible.has(row) ? '' : 'none'; });

    const pagination = document.getElementById('bulkCreditPagination')!;
    pagination.classList.toggle('hidden', matching.length <= BULK_CREDIT_PAGE_SIZE);
    pagination.classList.toggle('flex', matching.length > BULK_CREDIT_PAGE_SIZE);
    document.getElementById('bulkCreditPageInfo')!.textContent = `Page ${bulkCreditPage + 1} of ${totalPages} (${matching.length} match${matching.length === 1 ? '' : 'es'})`;
    (document.getElementById('bulkCreditPrevPage') as HTMLButtonElement).disabled = bulkCreditPage === 0;
    (document.getElementById('bulkCreditNextPage') as HTMLButtonElement).disabled = bulkCreditPage >= totalPages - 1;
  }

  document.getElementById('bulkCreditSearch')?.addEventListener('input', () => {
    bulkCreditPage = 0;
    renderBulkCreditPage();
  });
  document.getElementById('bulkCreditPrevPage')?.addEventListener('click', () => { bulkCreditPage--; renderBulkCreditPage(); });
  document.getElementById('bulkCreditNextPage')?.addEventListener('click', () => { bulkCreditPage++; renderBulkCreditPage(); });
