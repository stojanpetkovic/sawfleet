  function renderRoutingCheckboxes(container: HTMLElement, items: { id: string; label: string }[], name: string, checkedIds: string[]) {
    container.innerHTML = items.length
      ? items.map((item) => `
        <label class="flex items-center gap-2 text-xs text-slate-700">
          <input type="checkbox" name="${name}" value="${item.id}" class="h-4 w-4 accent-green-600" ${checkedIds.includes(item.id) ? 'checked' : ''} />
          ${escapeHtml(item.label)}
        </label>`).join('')
