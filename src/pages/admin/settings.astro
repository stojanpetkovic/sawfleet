  async function loadOAuthSettings() {
    const form = document.getElementById('oauthSettingsForm') as HTMLFormElement;
    const msg = document.getElementById('oauthMsg') as HTMLElement;
    const localSaved = getStoredOAuthSettings();

    form.style.opacity = '1';

    const { data, error } = await supabase
      .from('tracking_settings')
      .select('google_oauth_client_id, google_oauth_client_secret')
      .eq('id', 1)
      .maybeSingle();

    const saved = {
      clientId: data?.google_oauth_client_id || localSaved.clientId || '',
      clientSecret: data?.google_oauth_client_secret || localSaved.clientSecret || '',
    };

    (document.getElementById('googleClientId') as HTMLInputElement).value = saved.clientId;
    (document.getElementById('googleClientSecret') as HTMLInputElement).value = saved.clientSecret;

    if (error) {
      msg.textContent = '⚠️ Loaded fallback values from this browser because the database query failed.';
      msg.className = 'text-[11px] text-amber-600 mt-2';
      return;
    }

    if (saved.clientId && saved.clientSecret) {
      msg.textContent = '✓ OAuth settings loaded from the database.';
      msg.className = 'text-[11px] text-green-600 mt-2';
    } else {
      msg.textContent = '✓ Check Supabase Dashboard → Authentication → Providers → Google for full OAuth configuration';
      msg.className = 'text-[11px] text-blue-600 mt-2';
    }
  }

  document.getElementById('oauthSettingsForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('saveOAuthBtn') as HTMLButtonElement;
    const msg = document.getElementById('oauthMsg') as HTMLElement;

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    const clientId = (document.getElementById('googleClientId') as HTMLInputElement).value.trim();
    const clientSecret = (document.getElementById('googleClientSecret') as HTMLInputElement).value.trim();

    if (!clientId || !clientSecret) {
      msg.textContent = '❌ Please enter both Client ID and Client Secret';
      msg.className = 'text-[11px] text-red-600 mt-2';
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save OAuth Settings';
      return;
    }

    const payload = {
      id: 1,
      google_oauth_client_id: clientId,
      google_oauth_client_secret: clientSecret,
    };

    const { error } = await supabase.from('tracking_settings').upsert(payload, { onConflict: 'id' });

    if (error) {
      saveStoredOAuthSettings({ clientId, clientSecret });
      msg.textContent = '⚠️ Saved to this browser as fallback because the database save failed.';
      msg.className = 'text-[11px] text-amber-600 mt-2';
    } else {
      msg.textContent = '✓ OAuth settings saved to the database.';
      msg.className = 'text-[11px] text-green-600 mt-2';
    }

    setTimeout(() => {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save OAuth Settings';
