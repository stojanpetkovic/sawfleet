  async function loadExternalLeadRouting() {
    const response = await adminFetch('/api/external-lead-routing');
    const result = await response.json().catch(() => ({}));
    const rulesEl = document.getElementById('externalLeadRoutingRules')!;
    if (!response.ok || !result.ok) {
      rulesEl.innerHTML = '<p class="text-xs text-red-600">Could not load routing rules.</p>';
      return;
    }

    routingContractors = result.contractors || [];
    routingTruckOwners = result.truckOwners || [];

    const rules = result.rules || [];
    rulesEl.innerHTML = rules.length ? rules.map((r: any) => {
      const contractorNames = (r.contractor_ids || []).map((id: string) => routingContractors.find((c) => c.user_id === id)?.company_name || 'Unknown').join(', ') || '—';
      const truckOwnerNames = (r.truck_owner_ids || []).map((id: string) => routingTruckOwners.find((o) => o.id === id)?.company_name || 'Unknown').join(', ') || '—';
      return `
        <div class="flex flex-col gap-2 rounded-xl border border-slate-200 p-4 sm:flex-row sm:items-center sm:justify-between" data-rule-id="${r.id}">
          <div class="min-w-0">
            <p class="text-xs font-bold text-slate-900">${escapeHtml(r.source_domain)} <span class="ml-2 rounded-full px-2 py-0.5 text-[9px] font-bold uppercase ${r.enabled ? 'bg-green-50 text-green-700' : 'bg-slate-100 text-slate-500'}">${r.enabled ? 'Enabled' : 'Disabled'}</span></p>
            <p class="mt-1 text-[10px] text-slate-400">Contractors: ${escapeHtml(contractorNames)}</p>
            <p class="text-[10px] text-slate-400">Truck owners: ${escapeHtml(truckOwnerNames)}</p>
          </div>
          <div class="flex shrink-0 gap-2">
            <button class="edit-routing-rule h-8 rounded-lg border border-slate-200 px-3 text-[10px] font-bold uppercase tracking-wider text-slate-600 hover:bg-slate-50" data-rule-id="${r.id}">Edit</button>
            <button class="delete-routing-rule h-8 rounded-lg border border-red-200 px-3 text-[10px] font-bold uppercase tracking-wider text-red-600 hover:bg-red-50" data-rule-id="${r.id}">Delete</button>
          </div>
        </div>`;
    }).join('') : '<p class="text-xs text-slate-400">No routing rules yet — add one below.</p>';

    resetRoutingForm();

    rulesEl.querySelectorAll<HTMLButtonElement>('.edit-routing-rule').forEach((btn) => {
      btn.addEventListener('click', () => {
        const rule = rules.find((r: any) => r.id === btn.dataset.ruleId);
        if (!rule) return;
        (document.getElementById('routingRuleId') as HTMLInputElement).value = rule.id;
        (document.getElementById('routingDomain') as HTMLInputElement).value = rule.source_domain;
        (document.getElementById('routingEnabled') as HTMLInputElement).checked = rule.enabled;
        renderRoutingCheckboxes(document.getElementById('routingContractorList')!, routingContractors.map((c) => ({ id: c.user_id, label: c.company_name || c.contact_name || c.user_id })), 'routingContractor', rule.contractor_ids || []);
        renderRoutingCheckboxes(document.getElementById('routingTruckOwnerList')!, routingTruckOwners.map((o) => ({ id: o.id, label: o.company_name || o.contact_name || o.id })), 'routingTruckOwner', rule.truck_owner_ids || []);
        document.getElementById('cancelRoutingEditBtn')?.classList.remove('hidden');
        document.getElementById('routingDomain')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    rulesEl.querySelectorAll<HTMLButtonElement>('.delete-routing-rule').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this routing rule? Contractors/truck owners on this list will stop getting priority leads from this domain.')) return;
        await adminFetch(`/api/external-lead-routing?id=${btn.dataset.ruleId}`, { method: 'DELETE' });
        loadExternalLeadRouting();
      });
    });
  }

