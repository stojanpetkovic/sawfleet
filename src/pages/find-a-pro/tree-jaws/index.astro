---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import SplitSection from "../../../components/SplitSection.astro";
import Faq from "../../../components/Faq.astro";
import CtaBand from "../../../components/CtaBand.astro";
import ProRequestForm from "../../../components/ProRequestForm.astro";
import { pros, proDisclosure } from "../../../data/pros";
import { business } from "../../../config/business";

const pro = pros.find((p) => p.slug === "tree-jaws")!;

const faqs = [
  {
    q: `What services does ${pro.name} list?`,
    a: `${pro.name} lists ${pro.services.join(", ").toLowerCase()}. Details come from the company's own site and have not been verified by SF Tree Removal.`,
  },
  {
    q: `Where does ${pro.name} work?`,
    a: `The company serves ${pro.area} in Broward County. Ask them whether they cover your exact address. See <a href="/areas/fort-lauderdale-tree-removal/">tree removal in Fort Lauderdale</a>.`,
  },
  {
    q: `Is ${pro.name} licensed and insured?`,
    a: `The company states that it is licensed, bonded and insured. SF Tree Removal has not verified this, so ask for proof of license and insurance, in writing, before work starts.`,
  },
  {
    q: "What does “sponsored” mean?",
    a: `${pro.name} has a featured placement in this directory. That is advertising, not a recommendation, review or endorsement by SF Tree Removal.`,
  },
  {
    q: "How do I get an estimate?",
    a: `Call the company, visit its website, or send one <a href="/contact-us/">request</a> through SF Tree Removal and an independent local professional will contact you.`,
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${business.url}/find-a-pro/${pro.slug}/#company`,
  name: pro.name,
  url: pro.website,
  description: pro.description.join(" "),
  telephone: pro.phone,
  areaServed: [{ "@type": "City", name: "Fort Lauderdale" }, { "@type": "AdministrativeArea", name: "Broward County" }],
  knowsAbout: pro.services,
  sameAs: [pro.instagram].filter(Boolean),
};
---

<BaseLayout
  title="Tree Jaws | Tree Service in Fort Lauderdale (Sponsored)"
  description="Tree Jaws is a sponsored listing: a tree service company serving Fort Lauderdale and the surrounding area. Services, coverage and how to contact them."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <PageHero
    badge="SPONSORED LISTING"
    title={pro.name}
    lead={`${pro.tagline}. Serving ${pro.area}.`}
    actions={false}
    image="crane-lift"
  />

  <section class="py-section">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="mb-8 rounded-xl border border-accent-500 bg-accent-100 p-5 text-sm leading-relaxed text-secondary-800">
        <strong>Sponsored.</strong> {proDisclosure}
      </div>

      <div class="grid gap-8 md:grid-cols-[1.4fr_1fr]">
        <div class="prose-sf max-w-none">
          <h2 class="!mt-0">About {pro.name}</h2>
          {pro.description.map((p) => <p>{p}</p>)}
          <h2>Services listed</h2>
          <ul>{pro.services.map((s) => <li>{s}</li>)}</ul>
          <h2>Area</h2>
          <p>
            {pro.name} serves {pro.area}. Read about <a href="/areas/fort-lauderdale-tree-removal/">tree removal in Fort Lauderdale</a>,
            the <a href="/permit-checker/?j=fort-lauderdale">Fort Lauderdale permit rules</a> and <a href="/areas/broward-county-tree-removal/">Broward County</a>.
            If you are outside this area, <a href="/contact-us/">send one request</a> and a local professional will contact you.
          </p>
        </div>

        <aside class="space-y-5">
          <div class="card-static p-6">
            <h2 class="font-heading text-lg font-bold text-secondary-900">Contact</h2>
            <div class="mt-4 flex flex-col gap-3">
              <a href="#request" class="btn btn-accent" data-track={`${pro.slug}_request_click`}>Request a quote</a>
              {pro.phone && pro.phoneHref && <a href={pro.phoneHref} class="btn btn-outline" data-track={`${pro.slug}_call_click`}>Call {pro.phone}</a>}
              <a href={pro.website} class="btn btn-outline" data-track={`${pro.slug}_website_click`} target="_blank" rel="sponsored nofollow noopener noreferrer">Visit {pro.name} ↗</a>
              {pro.instagram && <a href={pro.instagram} class="text-center text-sm font-semibold text-primary-700 underline" target="_blank" rel="sponsored nofollow noopener noreferrer">Instagram</a>}
            </div>
          </div>
          <div class="card-static p-6">
            <h2 class="font-heading text-lg font-bold text-secondary-900">What the company states</h2>
            <ul class="mt-3 space-y-2 text-sm text-secondary-700">
              {pro.claims.map((c) => <li class="flex gap-2"><span class="text-primary-600" aria-hidden="true">•</span>{c}</li>)}
            </ul>
            <p class="mt-4 text-xs leading-relaxed text-secondary-500">These statements come from the company and have not been verified by SF Tree Removal. Ask for proof.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="pb-section">
    <div class="mx-auto max-w-4xl px-4 sm:px-6"><ProRequestForm pro={pro} where="profile" /></div>
  </section>

  <SplitSection
    topper="Ask before you hire"
    title="Questions to Ask Any Tree Company"
    image="arborist-inspect"
    tone="tint"
    html={`<ul><li>Can I see proof of license and insurance, in writing?</li><li>What exactly is included: removal, stump grinding, cleanup, haul-away?</li><li>How will a large tree near my house, pool or power lines come down?</li><li>Who gets the permit if one is needed? Check the <a href="/permit-checker/">permit checker</a>.</li><li>What are the payment terms and when can you start?</li></ul><p>Read <a href="/how-it-works/">how to compare estimates</a> and <a href="/tree-care-guides/tree-removal-cost-south-florida/">what drives the price</a>.</p>`}
  />

  <Faq faqs={faqs} tone="white" />

  <CtaBand title="Want More Than One Estimate?" text="Send one request and an independent local professional will contact you with a free estimate. No obligation." />
</BaseLayout>
