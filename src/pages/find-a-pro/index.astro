---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SplitSection from "../../components/SplitSection.astro";
import ProCard from "../../components/ProCard.astro";
import Faq from "../../components/Faq.astro";
import CtaBand from "../../components/CtaBand.astro";
import { pros, proDisclosure } from "../../data/pros";
import { business } from "../../config/business";

const sponsored = pros.filter((p) => p.sponsored);
const listed = pros.filter((p) => !p.sponsored);

const faqs = [
  {
    q: "What is the SF Tree Removal directory?",
    a: `A list of tree care companies in South Florida, starting with the Fort Lauderdale area. Sponsored companies get a featured placement at the top; other listings follow, and more areas are added as companies join. You can contact a company directly, or send one <a href="/contact-us/">request</a> and let a local professional contact you.`,
  },
  {
    q: "What does “Sponsored” mean?",
    a: `A sponsored listing has a featured placement. It is advertising, not a recommendation or a review by SF Tree Removal. Sponsored links are marked so search engines treat them as such.`,
  },
  {
    q: "Are the listed companies licensed and insured?",
    a: `Listings show what each company says about itself. SF Tree Removal does not verify licenses, insurance or reviews, so ask for proof of license and insurance, in writing, before work starts. See <a href="/how-it-works/">how to compare estimates</a>.`,
  },
  {
    q: "How do I get my tree company listed?",
    a: `Use the <a href="/for-pros/">for pros</a> page. Tell us your company, services, counties and cities, and we will review the details. Featured placement is available as a sponsored listing.`,
  },
  {
    q: "How do I choose a tree company?",
    a: `Compare the written scope (which trees, stump, cleanup, haul-away), price and payment terms, proof of license and insurance, who handles any permit, and timing. Read <a href="/tree-care-guides/tree-removal-cost-south-florida/">what drives the price</a> and the <a href="/free-tree-removal/">warning signs of a bad offer</a>.`,
  },
];

const listSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Tree service companies in South Florida",
  itemListOrder: "https://schema.org/ItemListUnordered",
  numberOfItems: pros.length,
  itemListElement: pros.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: { "@type": "Organization", name: p.name, url: `${business.url}/find-a-pro/${p.slug}/`, areaServed: p.area },
  })),
};
---

<BaseLayout
  title="Find a Tree Service Pro in South Florida | Directory"
  description="Directory of tree service companies in South Florida, starting with Fort Lauderdale, with sponsored listings marked. Compare and ask for a free estimate."
  pageType="CollectionPage"
>
  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />

  <PageHero
    badge="DIRECTORY"
    title="Find a Tree Service Pro in South Florida"
    lead="Tree care companies serving South Florida, starting with Fort Lauderdale. Sponsored listings are marked."
    actions={false}
    image="aerial-lift"
  />

  <section class="py-section">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <SectionHeading topper="Featured in Fort Lauderdale" title="Sponsored Listing" description="Featured placement for the Fort Lauderdale area. This is advertising, not a recommendation." />
      <p class="-mt-8 mb-8 text-center"><a href="/find-a-pro/fort-lauderdale/" class="font-semibold text-primary-700 underline">Tree service in Fort Lauderdale: local guide →</a></p>
      <div class="space-y-6">
        {sponsored.map((p) => <ProCard pro={p} featured />)}
      </div>

      {
        listed.length > 0 && (
          <div class="mt-14">
            <SectionHeading topper="More companies" title="Other Listings" />
            <div class="space-y-6">{listed.map((p) => <ProCard pro={p} />)}</div>
          </div>
        )
      }

      <div class="card-static mt-10 border-dashed p-8 text-center">
        <h3 class="font-heading text-xl font-bold text-secondary-900">Your tree company here</h3>
        <p class="mx-auto mt-2 max-w-xl text-secondary-600">Reach South Florida homeowners searching for tree removal, trimming and stump grinding, with a standard or featured listing.</p>
        <a href="/for-pros/" class="btn btn-accent mt-5">Get listed</a>
      </div>

      <p class="mt-8 rounded-xl bg-secondary-50 p-5 text-sm leading-relaxed text-secondary-600">{proDisclosure}</p>
    </div>
  </section>

  <SplitSection
    topper="Before you hire"
    title="How to Choose a Tree Company"
    image="climber-rope"
    tone="tint"
    html={`<ul><li><strong>Proof of license and insurance,</strong> in writing, and the insurer's name if you want to verify it.</li><li><strong>A written scope:</strong> which trees and limbs, stump grinding, cleanup and haul-away.</li><li><strong>A clear price</strong> and payment terms. Be wary of anyone who asks for full payment up front.</li><li><strong>How the work will be done,</strong> especially for large trees near the house, pool or power lines.</li><li><strong>Who handles any permit,</strong> and whether it is in the price. Check the <a href="/permit-checker/">permit checker</a>.</li><li><strong>Timing,</strong> and what happens if it rains or a storm comes.</li></ul>`}
  />

  <Faq faqs={faqs} tone="white" />

  <CtaBand title="Rather Not Call Around?" text="Send one request and an independent local professional will contact you with a free estimate. No obligation." />
</BaseLayout>
