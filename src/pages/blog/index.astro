---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/layout/Header.astro";
import MobileNav from "../../components/layout/MobileNav.astro";
import Footer from "../../components/layout/Footer.astro";
import { supabase } from "../../lib/supabase";
import { supabaseAdmin } from "../../lib/supabaseAdmin";

const db = supabaseAdmin ?? supabase;

const { data: postsRaw } = await db
  .from("blog_posts")
  .select("id, title, slug, excerpt, cover_image_url, category, published_at")
  .eq("status", "published")
  .order("published_at", { ascending: false });

const posts = postsRaw || [];
const categories = [...new Set(posts.map((p) => p.category).filter(Boolean))].sort() as string[];
---

<MainLayout title="Blog | SF Tree Removal" description="Tips, guides, and news from SF Tree Removal — tree care, dispatch, and industry insights.">
  <Header />
  <MobileNav />

  <main class="min-h-screen bg-slate-50 pb-24 pt-28 md:pt-36">
    <div class="mx-auto w-full max-w-6xl px-5 md:px-8">
      <div class="mb-8">
        <span class="text-[10px] font-mono font-bold uppercase tracking-[0.22em] text-green-700">// Blog</span>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">From the field</h1>
        <p class="mt-2 text-sm text-slate-500">Tips, guides, and stories from SF Tree Removal.</p>
      </div>

      <div class="mb-6 flex flex-col gap-4">
        <label class="relative">
          <span class="sr-only">Search posts</span>
          <input id="blogSearch" type="search" placeholder="Search posts by title..." class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm outline-none transition focus:border-green-500 focus:ring-4 focus:ring-green-500/10" />
        </label>
        <div class="flex flex-wrap gap-2">
          <button class="category-pill is-active rounded-full border border-green-500 bg-green-500 px-4 py-2 text-[11px] font-bold uppercase tracking-wider text-white" data-category="">All</button>
          {categories.map((cat) => (
            <button class="category-pill rounded-full border border-slate-200 bg-white px-4 py-2 text-[11px] font-bold uppercase tracking-wider text-slate-600 hover:border-green-300" data-category={cat}>{cat}</button>
          ))}
        </div>
      </div>

      <div id="postGrid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="post-card group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-lg"
            data-search={`${post.title} ${post.excerpt || ""}`.toLowerCase()}
            data-category={post.category || ""}
          >
            <div class="aspect-[16/10] w-full overflow-hidden bg-slate-100">
              {post.cover_image_url ? (
                <img src={post.cover_image_url} alt={post.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
              ) : (
                <div class="h-full w-full bg-gradient-to-br from-green-50 to-slate-100"></div>
              )}
              {post.category && <span class="absolute mt-3 ml-3 rounded-full bg-white/90 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wider text-green-700">{post.category}</span>}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <span class="text-[10px] font-mono text-slate-400">{post.published_at ? new Date(post.published_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : ""}</span>
              <h2 class="mt-2 text-base font-bold text-slate-950 leading-snug">{post.title}</h2>
              {post.excerpt && <p class="mt-2 text-sm text-slate-500 line-clamp-3">{post.excerpt}</p>}
            </div>
          </a>
        ))}
      </div>

      <div id="emptyBlog" class={`py-16 text-center ${posts.length > 0 ? "hidden" : ""}`}>
        <p class="text-sm text-slate-400">No posts yet — check back soon.</p>
      </div>
      <div id="noResults" class="hidden py-16 text-center">
        <p class="text-sm text-slate-400">No posts match your search.</p>
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>

<script>
  const search = document.getElementById("blogSearch") as HTMLInputElement;
  const pills = Array.from(document.querySelectorAll(".category-pill")) as HTMLButtonElement[];
  const cards = Array.from(document.querySelectorAll(".post-card")) as HTMLElement[];
  let activeCategory = "";

  function render() {
    const query = search.value.trim().toLowerCase();
    let visibleCount = 0;
    cards.forEach((card) => {
      const matches = (!query || (card.dataset.search || "").includes(query)) && (!activeCategory || card.dataset.category === activeCategory);
      card.classList.toggle("hidden", !matches);
      if (matches) visibleCount++;
    });
    document.getElementById("noResults")?.classList.toggle("hidden", visibleCount > 0 || cards.length === 0);
  }

  search?.addEventListener("input", render);
  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      activeCategory = pill.dataset.category || "";
      pills.forEach((p) => {
        const isActive = p === pill;
        p.classList.toggle("is-active", isActive);
        p.classList.toggle("border-green-500", isActive);
        p.classList.toggle("bg-green-500", isActive);
        p.classList.toggle("text-white", isActive);
        p.classList.toggle("border-slate-200", !isActive);
        p.classList.toggle("bg-white", !isActive);
        p.classList.toggle("text-slate-600", !isActive);
      });
      render();
    });
  });
</script>
