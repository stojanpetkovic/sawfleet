---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/layout/Header.astro";
import MobileNav from "../../components/layout/MobileNav.astro";
import Footer from "../../components/layout/Footer.astro";
import { supabase } from "../../lib/supabase";
import { supabaseAdmin } from "../../lib/supabaseAdmin";
import { ChevronRight } from "lucide-astro";

const { slug } = Astro.params;
const db = supabaseAdmin ?? supabase;

const { data: post } = await db
  .from("blog_posts")
  .select("*")
  .eq("slug", slug)
  .eq("status", "published")
  .maybeSingle();

if (!post) return Astro.redirect("/404");

const title = post.meta_title || `${post.title} | SF Tree Removal`;
const description = post.meta_description || post.excerpt || "";
const canonical = `https://sftreeremoval.com/blog/${post.slug}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonical}#post`,
  headline: post.title,
  description,
  url: canonical,
  datePublished: post.published_at,
  dateModified: post.updated_at,
  image: post.cover_image_url || undefined,
  author: { "@type": "Organization", name: "SF Tree Removal" },
};
---

<MainLayout title={title} description={description} image={post.cover_image_url || undefined} structuredData={schema}>
  <Header />
  <MobileNav />

  <main class="min-h-screen bg-slate-50 pb-24 pt-28 md:pt-36">
    <div class="mx-auto w-full max-w-3xl px-5 md:px-8">
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest text-slate-400">
        <a href="/" class="hover:text-green-700 transition-colors">Home</a>
        <ChevronRight size={10} />
        <a href="/blog" class="hover:text-green-700 transition-colors">Blog</a>
        <ChevronRight size={10} />
        <span class="text-slate-600 line-clamp-1">{post.title}</span>
      </nav>

      {post.category && (
        <span class="mb-4 inline-block rounded-full bg-green-50 border border-green-200 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-green-700">{post.category}</span>
      )}

      <h1 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">{post.title}</h1>

      <div class="mt-4 flex items-center gap-3 text-[11px] font-mono text-slate-400">
        <span>SF Tree Removal</span>
        {post.published_at && <span>· {new Date(post.published_at).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</span>}
      </div>

      {post.cover_image_url && (
        <img src={post.cover_image_url} alt={post.title} class="mt-8 w-full rounded-2xl border border-slate-200 object-cover" />
      )}

      <article class="post-content mt-8 text-[15px] leading-relaxed text-slate-700" set:html={post.content} />

      {post.tags && post.tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2 border-t border-slate-200 pt-6">
          {post.tags.map((tag: string) => (
            <span class="rounded-full bg-slate-100 px-3 py-1.5 text-[11px] font-bold text-slate-600">{tag}</span>
          ))}
        </div>
      )}

      <div class="mt-10 border-t border-slate-200 pt-6">
        <a href="/blog" class="text-sm font-bold text-green-700 hover:underline">← Back to Blog</a>
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>

<style>
  .post-content :global(h2) { font-size: 1.5rem; font-weight: 700; margin-top: 2rem; margin-bottom: 0.75rem; color: #0f172a; }
  .post-content :global(h3) { font-size: 1.25rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.5rem; color: #0f172a; }
  .post-content :global(p) { margin-bottom: 1rem; }
  .post-content :global(ul), .post-content :global(ol) { margin: 1rem 0 1rem 1.5rem; }
  .post-content :global(li) { margin-bottom: 0.375rem; }
  .post-content :global(a) { color: #15803d; text-decoration: underline; }
  .post-content :global(img) { border-radius: 1rem; margin: 1.5rem 0; max-width: 100%; }
  .post-content :global(code) { background: #f1f5f9; padding: 0.125rem 0.375rem; border-radius: 0.375rem; font-size: 0.875em; }
  .post-content :global(blockquote) { border-left: 3px solid #22c55e; padding-left: 1rem; color: #64748b; font-style: italic; margin: 1rem 0; }
</style>
