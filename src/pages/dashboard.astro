---
import ContractorLayout from "../layouts/ContractorLayout.astro";
import { supabase } from "../lib/supabase";
import { Inbox, CheckCircle2, Truck, FileText, UserCircle } from "lucide-astro";

const { data: territories } = await supabase
  .from('service_territories')
  .select('*')
  .order('name', { ascending: true });

const navItems = [
  { label: 'Available', tab: 'available', icon: Inbox },
  { label: 'Claimed', tab: 'claimed', icon: CheckCircle2 },
  { label: 'Truck network', tab: 'trucks', icon: Truck },
  { label: 'Permit Leads', tab: 'permits', icon: FileText },
  { label: 'Profile', tab: 'profile', icon: UserCircle },
];
---

<ContractorLayout navItems={navItems} activeTab="available">
  <!-- STATE: LOADING -->
  <div id="stateLoading" class="flex flex-col items-center justify-center py-32 text-center">
    <div class="w-8 h-8 border-2 border-zinc-200 border-t-green-500 rounded-full animate-spin"></div>
    <p class="mt-4 text-xs text-zinc-500 font-mono uppercase tracking-widest">Loading dashboard...</p>
  </div>

  <!-- STATE: NOT LOGGED IN / NOT A CONTRACTOR -->
  <div id="stateNoAccess" class="hidden flex-col items-center justify-center py-32 text-center max-w-md mx-auto px-4">
    <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-red-600">// Access Denied</span>
    <h1 class="mt-4 text-2xl font-bold text-slate-900">Account not registered</h1>
    <p class="mt-3 text-sm text-slate-600">If you believe this is an error, please contact the administrator.</p>
    <a href="/login" class="mt-8 inline-flex h-12 px-8 items-center justify-center rounded-xl bg-green-500 text-sm font-bold text-slate-50 hover:bg-green-400 transition-all w-full sm:w-auto">Back to login</a>
  </div>

  <!-- STATE: PENDING APPROVAL -->
  <div id="statePending" class="hidden flex-col items-center justify-center py-32 text-center max-w-md mx-auto px-4">
    <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-amber-600">// Pending Approval</span>
    <h1 class="mt-4 text-2xl font-bold text-slate-900">Awaiting approval</h1>
    <p class="mt-3 text-sm text-slate-600">The administrator has not yet activated your account.</p>
  </div>

  <!-- STATE: ACTIVE DASHBOARD -->
  <div id="stateActive" class="hidden flex-col space-y-6 w-full">

    <div class="border-b border-slate-200 pb-7">
      <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-700">// Quick Claim Pipeline</span>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Lead workspace</h1>
      <p class="mt-2 max-w-2xl text-sm text-slate-500">The first contractor to claim a lead gains exclusive access. Others will see it as taken.</p>
    </div>

    <div id="overviewStatsGrid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">Available now</p>
        <p id="overviewAvailable" class="mt-3 text-3xl font-bold tabular-nums text-slate-950">-</p>
        <p class="mt-1 text-xs text-slate-500">Matched to your territory</p>
      </div>
      <div class="rounded-2xl border border-indigo-200 bg-gradient-to-br from-white to-indigo-50/70 p-5 shadow-sm">
        <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-indigo-700">Permit leads</p>
        <p id="overviewPermitLeads" class="mt-3 text-3xl font-bold tabular-nums text-slate-950">-</p>
        <p class="mt-1 text-xs text-slate-500">From public permit filings</p>
      </div>
      <div class="rounded-2xl border border-blue-200 bg-gradient-to-br from-white to-blue-50/70 p-5 shadow-sm">
        <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-blue-700">Truck partners</p>
        <p id="overviewTruckPartners" class="mt-3 text-3xl font-bold tabular-nums text-slate-950">-</p>
        <p class="mt-1 text-xs text-slate-500">Available in your territory</p>
      </div>
      <div class="rounded-2xl border border-green-200 bg-gradient-to-br from-white to-green-50/70 p-5 shadow-sm">
        <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-green-700">Claimed</p>
        <p id="overviewClaimed" class="mt-3 text-3xl font-bold tabular-nums text-slate-950">-</p>
        <p class="mt-1 text-xs text-slate-500">Total secured opportunities</p>
      </div>
      <div id="overviewCreditsCard" class="hidden rounded-2xl border border-emerald-200 bg-gradient-to-br from-white to-emerald-50/70 p-5 shadow-sm">
        <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-emerald-700">Credit balance</p>
        <p id="overviewCredits" class="mt-3 text-3xl font-bold tabular-nums text-slate-950">$-</p>
        <button id="overviewCreditsLink" class="mt-1 text-xs font-bold text-emerald-700 hover:text-emerald-800">Manage on Profile →</button>
      </div>
    </div>

    <section id="panelAvailable">
      <div id="availableLeadsContainer" class="space-y-4"></div>
      <div id="noAvailableLeads" class="hidden p-8 border border-slate-200 border-dashed rounded-2xl text-center">
        <p class="text-slate-400 text-sm">No requests in your territory at the moment.</p>
      </div>

      <div id="permitLeadsPreviewSection" class="hidden mt-8 overflow-hidden rounded-2xl border border-indigo-200 bg-gradient-to-br from-indigo-50/60 via-white to-white shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-indigo-100 bg-white/60 px-5 py-4 sm:px-6">
          <div>
            <span class="text-[9px] font-mono font-bold uppercase tracking-[0.2em] text-indigo-700">// Public permit filings</span>
            <h2 class="mt-1 text-base font-bold text-slate-950">Permit-driven projects</h2>
          </div>
          <button id="permitPreviewViewAll" type="button" class="shrink-0 text-[11px] font-bold uppercase tracking-wider text-indigo-700 hover:text-indigo-900">View all permit leads →</button>
        </div>
        <div id="permitLeadsPreviewContainer" class="space-y-3 p-5 sm:p-6"></div>
      </div>
    </section>

    <section id="panelClaimed" class="hidden">
      <div id="claimedLeadsContainer" class="space-y-4"></div>
      <p id="noClaimedLeads" class="hidden text-slate-400 text-xs italic p-8 text-center border border-slate-200 border-dashed rounded-2xl">You haven't claimed any leads yet.</p>
    </section>

    <section id="panelTrucks" class="hidden">
      <div class="mb-5">
        <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-blue-700">// Heavy job support</span>
        <h2 class="mt-2 text-xl font-bold text-slate-950">Available truck partners</h2>
        <p class="mt-1 text-sm text-slate-500">Approved equipment owners serving your territory. Contact them when a claimed job needs heavy equipment.</p>
      </div>
      <div id="recommendedTrucksContainer" class="grid gap-4 lg:grid-cols-2"></div>
      <div id="noRecommendedTrucks" class="hidden p-8 border border-slate-200 border-dashed rounded-2xl text-center text-sm text-slate-400">No approved truck partners are currently available in your territory.</div>
    </section>

    <section id="panelPermits" class="hidden">
      <div class="mb-5">
        <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-indigo-700">// Public permit filings</span>
        <h2 class="mt-2 text-xl font-bold text-slate-950">Permit leads</h2>
        <p class="mt-1 text-sm text-slate-500">Scraped from public permit records. Unlock any lead's owner contact for a small credit — unlocking is per-account, so more than one contractor may unlock the same lead.</p>
      </div>
      <div id="permitsDisabledNotice" class="hidden p-8 border border-slate-200 border-dashed rounded-2xl text-center">
        <p class="text-slate-400 text-sm">Permit lead unlocking isn't enabled yet.</p>
      </div>
      <div id="permitLeadsContainer" class="space-y-4"></div>
      <div id="noPermitLeads" class="hidden p-8 border border-slate-200 border-dashed rounded-2xl text-center">
        <p class="text-slate-400 text-sm">No qualified permit leads right now.</p>
      </div>
    </section>

    <section id="panelProfile" class="hidden">
      <!-- Profile sekcija sa main karticama i sidebar informacijama -->
      <div class="grid lg:grid-cols-4 gap-6 lg:gap-8 items-start">

        <!-- MAIN KARTE (LEVO) -->
        <div class="lg:col-span-2 space-y-5">
          <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-soft">
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-green-500 via-emerald-500 to-green-500"></div>
            <div class="p-6 sm:p-8 space-y-5">
              <div class="pb-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-700">// Account Settings</span>
                <h2 class="mt-1 text-xl font-bold text-slate-900">Company Profile</h2>
                <p class="mt-1 text-xs text-slate-500">Keep this up to date — it's what determines which leads reach you.</p>
              </div>
              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Company Name</label>
                <input id="profileCompany" type="text" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white transition-all"/>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Contact Name</label>
                  <input id="profileContact" type="text" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white transition-all"/>
                </div>
                <div>
                  <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Phone</label>
                  <input id="profilePhone" type="tel" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white transition-all"/>
                </div>
              </div>
              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Territory</label>
                <select id="profileTerritory" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white transition-all">
                  {territories?.map((t) => <option value={t.name}>{t.name}</option>)}
                </select>
              </div>
              <div class="pt-2 border-t border-slate-100">
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Login Email</label>
                <input id="profileEmail" type="email" disabled class="h-12 w-full rounded-xl border border-slate-200 bg-slate-100 px-4 text-sm text-slate-500 outline-none cursor-not-allowed"/>
                <p class="mt-1.5 text-[10px] text-slate-400">Contact the administrator to change your login email.</p>
              </div>
              <button id="saveProfileBtn" class="h-12 w-full rounded-xl bg-green-500 text-sm font-bold text-white hover:bg-green-600 transition-all active:scale-[0.98] shadow-[0_8px_24px_-6px_rgba(34,197,94,0.4)]">Save Changes</button>
              <p id="profileMsg" class="text-[11px]"></p>
            </div>
          </div>

          <!-- PUBLIC PROFILE CARD -->
          <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-soft">
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-blue-500 via-indigo-400 to-blue-500"></div>
            <div class="p-6 sm:p-8 space-y-5">
              <div class="pb-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-blue-700">// Public Profile</span>
                <h2 class="mt-1 text-xl font-bold text-slate-900">Your Public Page</h2>
                <p class="mt-1 text-xs text-slate-500">Customers searching for tree service in your area can find and review you here. Toggle visibility when ready.</p>
              </div>

              <!-- is_public toggle -->
              <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-4">
                <div>
                  <p class="text-sm font-bold text-slate-900">Profile visibility</p>
                  <p class="text-xs text-slate-500 mt-0.5">Show your profile in the contractor directory</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="profileIsPublic" class="sr-only peer" />
                  <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                </label>
              </div>

              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">About your company</label>
                <textarea id="profileBio" rows={4} maxlength="2000" placeholder="Describe your services, experience, coverage area…" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:bg-white resize-none transition-all"></textarea>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Company website</label>
                  <input id="profileWebsite" type="url" placeholder="https://yourcompany.com" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:bg-white transition-all"/>
                </div>
                <div>
                  <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">License number</label>
                  <input id="profileLicense" type="text" placeholder="FL-XXXX" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:bg-white transition-all"/>
                </div>
              </div>

              <div>
                <label class="mb-3 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Services offered</label>
                <div id="servicesCheckboxes" class="flex flex-wrap gap-2">
                  {["Tree Removal","Tree Trimming","Stump Grinding","Emergency Service","Land Clearing","Debris Removal","Crane Service"].map((s) => (
                    <label class="service-label flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-medium text-slate-700 cursor-pointer hover:border-blue-300 hover:bg-blue-50 transition-colors has-[:checked]:border-blue-400 has-[:checked]:bg-blue-50 has-[:checked]:text-blue-700">
                      <input type="checkbox" class="service-checkbox sr-only" value={s} />
                      {s}
                    </label>
                  ))}
                </div>
              </div>

              <div class="flex flex-col sm:flex-row gap-3 pt-2">
                <button id="savePublicProfileBtn" class="h-12 flex-1 rounded-xl bg-blue-600 text-sm font-bold text-white hover:bg-blue-700 transition-all active:scale-[0.98]">Save Public Profile</button>
                <a id="viewPublicProfileLink" href="#" target="_blank" class="hidden h-12 items-center justify-center rounded-xl border border-blue-200 px-6 text-sm font-bold text-blue-700 hover:bg-blue-50 transition-all">View profile →</a>
              </div>
              <p id="publicProfileMsg" class="text-[11px]"></p>
            </div>
          </div>

          <!-- MY REVIEWS CARD -->
          <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-soft">
            <div class="p-6 sm:p-8">
              <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-amber-700">// Customer Feedback</span>
              <h2 class="mt-1 text-xl font-bold text-slate-900">Your Reviews</h2>
              <p class="mt-1 text-xs text-slate-500">Reviews left by customers. Pending reviews are waiting for admin approval.</p>
              <div id="myReviewsList" class="mt-5 space-y-4">
                <p class="text-xs text-slate-400 italic">Loading reviews…</p>
              </div>
            </div>
          </div>
        </div>

        <!-- SIDEBAR INFORMACIJE (desna kolona na velikim ekranima) -->
        <aside class="space-y-4 lg:col-span-2">
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft">
            <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-slate-400">Account Status</p>
            <div class="mt-2 flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
              <span class="text-sm font-bold text-slate-900">Active</span>
            </div>
            <p class="mt-1.5 text-xs text-slate-500 leading-relaxed">Your account is verified and currently receiving leads in your territory.</p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft">
            <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-slate-400 mb-3">Your Activity</p>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs text-slate-600">Available in territory</span>
                <span id="statAvailable" class="text-sm font-mono font-bold text-slate-900">-</span>
              </div>
              <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                <span class="text-xs text-slate-600">Total claimed</span>
                <span id="statClaimed" class="text-sm font-mono font-bold text-slate-900">-</span>
              </div>
            </div>
          </div>

          <!-- CREDITS -->
          <div id="creditsCard" class="hidden rounded-2xl border border-emerald-200 bg-gradient-to-br from-white to-emerald-50/60 p-5 shadow-soft">
            <div class="flex items-center justify-between">
              <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-emerald-700">Credit balance</p>
              <span class="text-[9px] font-bold uppercase tracking-wider text-emerald-600/70">$1 = 1 credit</span>
            </div>
            <p id="profileCreditBalance" class="mt-2 text-3xl font-bold tabular-nums text-slate-950">$-</p>

            <div id="creditPendingNotice" class="hidden mt-4 rounded-xl border border-amber-200 bg-amber-50 p-3">
              <p class="text-[11px] font-bold text-amber-800">Request pending</p>
              <p id="creditPendingText" class="mt-1 text-[11px] text-amber-700 leading-relaxed"></p>
            </div>

            <form id="creditRequestForm" class="mt-4 space-y-2">
              <input id="creditRequestAmount" type="number" min="1" step="1" placeholder="Amount requested ($, optional)" class="h-10 w-full rounded-lg border border-emerald-200 bg-white px-3 text-sm text-slate-900 outline-none focus:border-emerald-500" />
              <input id="creditRequestNote" type="text" placeholder="Note (optional)" class="h-10 w-full rounded-lg border border-emerald-200 bg-white px-3 text-sm text-slate-900 outline-none focus:border-emerald-500" />
              <button id="creditRequestBtn" type="submit" class="h-10 w-full rounded-lg bg-emerald-600 text-xs font-bold uppercase tracking-wider text-white hover:bg-emerald-500 transition-all">Request more credit</button>
            </form>
            <p id="creditRequestMsg" class="mt-2 text-[11px]"></p>

            <div id="paypalComingSoonNote" class="mt-4 border-t border-emerald-100 pt-3">
              <p class="text-[10px] text-emerald-700/70 leading-relaxed">💳 Buying credit online is coming soon — for now, requests are reviewed by the administrator.</p>
            </div>
            <div id="paypalBuySection" class="hidden mt-4 border-t border-emerald-100 pt-4">
              <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.15em] text-emerald-700">Buy credit with PayPal</p>
              <input id="paypalAmount" type="number" min="5" step="1" value="25" placeholder="Amount ($, min $5)" class="mb-3 h-10 w-full rounded-lg border border-emerald-200 bg-white px-3 text-sm text-slate-900 outline-none focus:border-emerald-500" />
              <div id="paypalButtonContainer"></div>
              <p id="paypalPurchaseMsg" class="mt-2 text-[11px]"></p>
            </div>
          </div>

          <div class="rounded-2xl border border-green-200 bg-green-50 p-5">
            <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-green-700 mb-2">💡 Tip</p>
            <p class="text-xs text-green-800 leading-relaxed">Leads are matched automatically by territory — the more accurate this setting, the faster you'll see new requests.</p>
          </div>

          <!-- Public profile toggle (sidebar) -->
          <div id="publicProfileToggleCard" class="hidden rounded-2xl border border-blue-200 bg-gradient-to-br from-white to-blue-50/40 p-5">
            <div class="flex items-center justify-between mb-2">
              <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-blue-700">🌐 Public profile</p>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="sidebarIsPublicToggle" class="sr-only peer" />
                <div class="w-11 h-6 bg-slate-200 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>
            <p id="sidebarPublicStatus" class="text-xs text-slate-500 leading-relaxed">Uključi da se tvoj profil pojavi u direktorijumu.</p>
            <a id="sidebarProfileLink" href="#" target="_blank" class="hidden mt-3 text-[10px] font-bold text-blue-700 hover:text-blue-900">Pogledaj profil →</a>
            <p id="sidebarPublicMsg" class="text-[10px] mt-1"></p>
          </div>
        </aside>

      </div>
    </section>

  </div>

  <!-- TOAST NOTIFIKACIJE -->
  <div id="toast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-[999] px-5 py-3 rounded-xl border text-xs font-bold uppercase tracking-wider shadow-2xl transition-all"></div>
</ContractorLayout>

<script>
  import { supabase } from "../lib/supabase";
  import { initPayPalCreditButton } from "../lib/paypalCreditWidget";

  type AvailableLead = { id: string; county: string; details: string; created_at: string; status: string; contractor_id: string | null };
  type ClaimedLead = { id: string; county: string; phone: string; email: string | null; details: string; claimed_at: string | null; created_at: string };
  type RecommendedTruck = { truck_id: string; company_name: string | null; contact_name: string | null; phone: string | null; email: string | null; equipment_type: string; lift_capacity_tons: number | null; working_height_ft: number | null; access_type: string | null; listing_type: string | null; location: string };
  type RoutedExternalLead = { id: string; source_domain: string | null; full_name: string | null; email: string | null; phone: string | null; message: string | null; created_at: string; claimed_by_id: string | null };
  type PermitLeadRow = { id: string; jurisdiction: string | null; permit_type: string | null; permit_description: string | null; permit_date: string | null; discovered_at: string | null; owner_name?: string | null; owner_phone?: string | null; owner_email?: string | null; address?: string | null };

  let contractorId: string | null = null;
  let pollTimer: ReturnType<typeof setInterval> | null = null;
  let knownAvailableIds = new Set<string>();
  let knownRoutedIds = new Set<string>();
  let lastAvailableCount = 0;
  let permitUnlockCost = 0;
  const unlockedPermitIds = new Set<string>();

  // Menja koji panel je vidljiv. NE dispatch-uje event — samo reaguje na
  // 'layout:tab-change' (koji šalje ContractorLayout na klik, ili mi sami
  // kad treba programski da promenimo tab, npr. iz notifikacije).
  function setActiveTab(tab: 'available' | 'claimed' | 'trucks' | 'permits' | 'profile') {
    const panels: Record<string, HTMLElement> = {
      available: document.getElementById('panelAvailable')!,
      claimed: document.getElementById('panelClaimed')!,
      trucks: document.getElementById('panelTrucks')!,
      permits: document.getElementById('panelPermits')!,
      profile: document.getElementById('panelProfile')!,
    };
    Object.entries(panels).forEach(([key, panel]) => {
      panel.classList.toggle('hidden', key !== tab);
    });
  }

  function goToTab(tab: 'available' | 'claimed' | 'trucks' | 'permits' | 'profile') {
    document.dispatchEvent(new CustomEvent('layout:tab-change', { detail: { tab } }));
  }

  document.addEventListener('layout:tab-change', (e) => {
    const tab = (e as CustomEvent).detail?.tab;
    if (tab) setActiveTab(tab);
  });

  function show(id: string) {
    ['stateLoading', 'stateNoAccess', 'statePending', 'stateActive'].forEach((s) => {
      document.getElementById(s)?.classList.add('hidden');
    });
    const el = document.getElementById(id);
    el?.classList.remove('hidden');
    el?.classList.add('flex');
  }

  function toast(message: string, kind: 'success' | 'error' | 'info' = 'info') {
    const el = document.getElementById('toast');
    if (!el) return;
    const colors = {
      success: 'bg-green-50 border-green-800 text-green-700',
      error: 'bg-red-50 border-red-800 text-red-600',
      info: 'bg-zinc-100/90 border-zinc-300 text-zinc-700',
    };
    el.className = `fixed bottom-6 left-1/2 -translate-x-1/2 w-[90%] md:w-auto text-center z-[999] px-5 py-3 rounded-xl border text-[10px] md:text-xs font-bold uppercase tracking-wider shadow-2xl ${colors[kind]}`;
    el.textContent = message;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 3500);
  }

  async function updateNotificationBell(availableCount: number) {
    const badge = document.getElementById('notificationBadge');
    const content = document.getElementById('notifContent');

    let creditNotices: { id: string; status: string }[] = [];
    if (contractorId) {
      const { data } = await supabase
        .from('credit_requests')
        .select('id, status')
        .eq('account_type', 'contractor')
        .eq('account_id', contractorId)
        .in('status', ['fulfilled', 'dismissed'])
        .eq('seen_by_requester', false);
      creditNotices = data || [];
    }

    const total = availableCount + creditNotices.length;
    if (badge) {
      if (total > 0) {
        badge.textContent = total.toString();
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }
    if (content) {
      const leadHtml = availableCount > 0
        ? `<button id="notifGoToAvailable" class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors">
             <p class="text-xs text-slate-900 font-bold">${availableCount} lead${availableCount === 1 ? '' : 's'} available</p>
             <p class="text-[10px] text-zinc-500 mt-0.5">In your territory, waiting to be claimed.</p>
           </button>`
        : '';
      const creditHtml = creditNotices.map((notice) => `
        <button class="notif-credit-item w-full text-left px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" data-id="${notice.id}">
          <p class="text-xs text-slate-900 font-bold">${notice.status === 'fulfilled' ? '✅ Credit request approved' : 'Credit request declined'}</p>
          <p class="text-[10px] text-zinc-500 mt-0.5">${notice.status === 'fulfilled' ? 'Your balance has been topped up.' : 'Contact the administrator for details.'}</p>
        </button>
      `).join('');
      content.innerHTML = (leadHtml + creditHtml) || `<p class="px-3 py-4 text-[11px] text-zinc-400 text-center">No new leads right now.</p>`;

      document.getElementById('notifGoToAvailable')?.addEventListener('click', () => {
        goToTab('available');
        document.getElementById('notifDropdown')?.classList.add('hidden');
      });
      content.querySelectorAll<HTMLButtonElement>('.notif-credit-item').forEach((btn) => {
        btn.addEventListener('click', async () => {
          document.getElementById('notifDropdown')?.classList.add('hidden');
          goToTab('profile');
          await supabase.from('credit_requests').update({ seen_by_requester: true }).eq('id', btn.dataset.id);
          await refreshCreditBalance();
          await updateNotificationBell(lastAvailableCount);
        });
      });
    }
  }

  function timeAgo(dateInput: string) {
    const diff = Math.floor((Date.now() - new Date(dateInput).getTime()) / 1000);
    if (diff < 60) return 'Just now';
    if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
    if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
    return `${Math.floor(diff / 86400)}d ago`;
  }

  function renderAvailableLead(lead: AvailableLead) {
    const isClaimed = lead.status === 'claimed';
    const wrapper = document.createElement('div');
    wrapper.id = `avail-${lead.id}`;
    wrapper.className = `relative p-4 md:p-6 bg-white border ${isClaimed ? 'border-slate-200 opacity-70' : 'border-slate-200 shadow-sm'} rounded-2xl overflow-hidden group ${!isClaimed ? 'hover:-translate-y-0.5 hover:border-green-300 hover:shadow-md' : ''} transition-all`;
    
    // Prilagođeno za mobilne (flex-col na malim ekranima, flex-row na velikim)
    wrapper.innerHTML = `
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-[9px] font-mono ${isClaimed ? 'text-zinc-500' : 'text-green-700'} uppercase tracking-widest">${lead.county}</span>
            <span class="text-[9px] font-mono text-zinc-400">// ${timeAgo(lead.created_at)}</span>
            ${isClaimed ? '<span class="px-1.5 py-0.5 bg-zinc-100 text-zinc-500 text-[8px] font-bold uppercase rounded border border-zinc-200">Taken</span>' : ''}
          </div>
          <p class="mt-3 text-sm text-slate-700 select-none blur-[6px] ${!isClaimed ? 'group-hover:blur-[5px]' : ''} transition-all max-w-md">
            ${isClaimed ? 'Another contractor has already claimed this project.' : (lead.details || 'Project description available after claiming.')}
          </p>
          <p class="mt-2 flex items-center gap-1.5 text-[10px] font-mono text-slate-500">
            🔒 Contact details locked
          </p>
        </div>
        ${!isClaimed ? `
          <button
            data-lead-id="${lead.id}"
            class="claim-btn w-full md:w-auto shrink-0 px-6 py-3 md:py-4 bg-green-500 text-slate-50 text-[10px] font-bold uppercase tracking-widest rounded-xl hover:bg-green-400 transition-all active:scale-95 whitespace-nowrap"
          >
            Claim Now →
          </button>
        ` : `
          <button disabled class="w-full md:w-auto shrink-0 px-6 py-3 md:py-4 bg-zinc-100 text-zinc-400 border border-zinc-200 text-[10px] font-bold uppercase tracking-widest rounded-xl cursor-not-allowed whitespace-nowrap">
            Claimed
          </button>
        `}
      </div>
    `;

    if (!isClaimed) {
      wrapper.querySelector('.claim-btn')?.addEventListener('click', (e) => claimLead(lead.id, e.currentTarget as HTMLButtonElement));
    }
    return wrapper;
  }

  function renderRoutedExternalLead(lead: RoutedExternalLead) {
    const takenByOther = !!lead.claimed_by_id && lead.claimed_by_id !== contractorId;
    const wrapper = document.createElement('div');
    wrapper.id = `avail-ext-${lead.id}`;
    wrapper.dataset.taken = takenByOther ? '1' : '0';
    wrapper.className = `relative p-4 md:p-6 bg-gradient-to-br from-white to-amber-50/40 border ${takenByOther ? 'border-slate-200 opacity-70' : 'border-amber-300 shadow-sm'} rounded-2xl overflow-hidden transition-all`;
    wrapper.innerHTML = `
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2 py-0.5 rounded-full bg-amber-100 border border-amber-300 text-amber-800 text-[9px] font-bold uppercase tracking-widest">Priority referral — ${lead.source_domain || 'partner'}</span>
            <span class="text-[9px] font-mono text-zinc-400">// ${timeAgo(lead.created_at)}</span>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900">${lead.full_name || 'Unnamed'}</p>
          <p class="mt-1 text-xs text-slate-600">${[lead.email, lead.phone].filter(Boolean).join(' · ') || 'No contact info provided'}</p>
          ${lead.message ? `<p class="mt-2 text-sm text-slate-700 max-w-md">${lead.message}</p>` : ''}
        </div>
        ${!takenByOther ? `
          <button
            data-ext-id="${lead.id}"
            class="accept-ext-btn w-full md:w-auto shrink-0 px-6 py-3 md:py-4 bg-amber-500 text-slate-950 text-[10px] font-bold uppercase tracking-widest rounded-xl hover:bg-amber-400 transition-all active:scale-95 whitespace-nowrap"
          >
            Accept →
          </button>
        ` : `
          <button disabled class="w-full md:w-auto shrink-0 px-6 py-3 md:py-4 bg-zinc-100 text-zinc-400 border border-zinc-200 text-[10px] font-bold uppercase tracking-widest rounded-xl cursor-not-allowed whitespace-nowrap">
            Already accepted
          </button>
        `}
      </div>
    `;
    if (!takenByOther) {
      wrapper.querySelector('.accept-ext-btn')?.addEventListener('click', (e) => acceptRoutedLead(lead.id, e.currentTarget as HTMLButtonElement));
    }
    return wrapper;
  }

  async function acceptRoutedLead(id: string, btn: HTMLButtonElement) {
    btn.disabled = true;
    btn.textContent = 'Accepting...';
    const { error } = await supabase.rpc('accept_external_lead', { p_external_lead_id: id });
    if (error) {
      toast(error.message?.includes('already_accepted') ? 'Too slow — already accepted by another partner.' : 'Could not accept lead.', 'error');
      btn.disabled = false;
      btn.textContent = 'Accept →';
    } else {
      toast('Lead accepted — no credits used.', 'success');
    }
    await loadAvailableLeads();
  }

  function renderClaimedLead(lead: ClaimedLead) {
    const wrapper = document.createElement('div');
    wrapper.className = 'p-4 md:p-6 bg-gradient-to-br from-white to-green-50/50 border border-green-200 rounded-2xl shadow-sm';
