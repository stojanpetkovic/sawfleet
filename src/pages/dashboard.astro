      ? `<p class="mt-3 text-sm text-slate-700">${row.owner_name || 'Unnamed owner'}</p>
         <div class="mt-2 flex flex-wrap gap-3 text-[11px] font-mono">
           ${row.owner_phone ? `<a href="tel:${row.owner_phone}" class="text-slate-600 hover:text-indigo-700 underline decoration-dotted underline-offset-2">${row.owner_phone}</a>` : ''}
           ${row.owner_email ? `<a href="mailto:${row.owner_email}" class="text-slate-600 hover:text-indigo-700 underline decoration-dotted underline-offset-2">${row.owner_email}</a>` : ''}
         </div>
         ${row.address ? `<p class="mt-2 text-xs text-slate-500">${row.address}</p>` : ''}`
