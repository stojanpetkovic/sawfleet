    wrapper.innerHTML = `
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-[9px] font-mono text-indigo-700 uppercase tracking-widest">${row.jurisdiction || 'South Florida'}</span>
            <span class="text-[9px] font-mono text-zinc-400">// ${row.permit_date ? new Date(row.permit_date).toLocaleDateString() : timeAgo(row.discovered_at || '')}</span>
          </div>
          <p class="mt-2 text-sm font-bold text-slate-900">${row.permit_type || 'Tree service permit'}</p>
          ${row.permit_description ? `<p class="mt-1 text-xs text-slate-500 max-w-md">${row.permit_description}</p>` : ''}
