          <button data-permit-id="${row.id}" class="unlock-permit-btn w-full md:w-auto shrink-0 px-6 py-3 md:py-4 bg-indigo-600 text-white text-[10px] font-bold uppercase tracking-widest rounded-xl hover:bg-indigo-700 transition-all active:scale-95 whitespace-nowrap">
