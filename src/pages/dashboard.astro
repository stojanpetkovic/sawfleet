  async function unlockPermitLead(permitLeadId: string, btn: HTMLButtonElement) {
    btn.disabled = true;
    btn.textContent = 'Unlocking...';
    const { error } = await supabase.rpc('unlock_permit_lead', { p_permit_lead_id: permitLeadId });
    if (error) {
      const message = error.message?.includes('insufficient_credits')
        ? 'Not enough credit balance to unlock this lead.'
        : error.message?.includes('feature_disabled')
        ? 'Permit lead unlocking is currently disabled.'
        : 'Could not unlock this lead.';
      toast(message, 'error');
      btn.disabled = false;
      btn.textContent = `Unlock — $${permitUnlockCost} credit`;
      return;
    }
    toast('Lead unlocked.', 'success');
    unlockedPermitIds.add(permitLeadId);
    await Promise.all([refreshCreditBalance(), loadPermitLeadsMarketplace()]);
  }

  async function loadPermitLeadsMarketplace() {
    const { data: settings } = await supabase.rpc('get_permit_lead_unlock_settings');
    const permitSettings = Array.isArray(settings) ? settings[0] : settings;
    const disabledNotice = document.getElementById('permitsDisabledNotice')!;
    const container = document.getElementById('permitLeadsContainer')!;
    const empty = document.getElementById('noPermitLeads')!;
    const previewSection = document.getElementById('permitLeadsPreviewSection')!;
    const previewContainer = document.getElementById('permitLeadsPreviewContainer')!;

    if (!permitSettings?.enabled) {
      disabledNotice.classList.remove('hidden');
      container.innerHTML = '';
      empty.classList.add('hidden');
      previewSection.classList.add('hidden');
      document.getElementById('overviewPermitLeads')!.textContent = '0';
      return;
    }
    disabledNotice.classList.add('hidden');
    permitUnlockCost = Number(permitSettings.cost || 0);

    const [{ data: marketplace }, { data: unlocks }] = await Promise.all([
      supabase.from('permit_leads_marketplace').select('*').order('discovered_at', { ascending: false }),
      supabase.from('permit_lead_unlocks').select('permit_lead_id'),
    ]);

    unlockedPermitIds.clear();
    (unlocks || []).forEach((u: { permit_lead_id: string }) => unlockedPermitIds.add(u.permit_lead_id));

    const rows: PermitLeadRow[] = marketplace || [];
    empty.classList.toggle('hidden', rows.length > 0);
    document.getElementById('overviewPermitLeads')!.textContent = rows.length.toString();
    previewSection.classList.toggle('hidden', rows.length === 0);

    if (rows.length === 0) {
      container.innerHTML = '';
      previewContainer.innerHTML = '';
      return;
    }

    const unlockedIds = rows.filter((r) => unlockedPermitIds.has(r.id)).map((r) => r.id);
    let fullRowsById = new Map<string, PermitLeadRow>();
    if (unlockedIds.length > 0) {
      const { data: fullRows } = await supabase.from('permit_leads').select('*').in('id', unlockedIds);
      (fullRows || []).forEach((r: PermitLeadRow) => fullRowsById.set(r.id, r));
    }

    container.innerHTML = '';
    previewContainer.innerHTML = '';
    rows.forEach((row, index) => {
      const unlocked = unlockedPermitIds.has(row.id);
      const fullRow = unlocked ? (fullRowsById.get(row.id) || row) : row;
      container.appendChild(renderPermitLeadCard(fullRow, unlocked));
      if (index < 3) previewContainer.appendChild(renderPermitLeadCard(fullRow, unlocked, 'permit-preview-'));
    });
  }

  async function claimLead(leadId: string, btn: HTMLButtonElement) {
    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'CLAIMING...';

    const { data: success, error } = await supabase.rpc('claim_lead', { p_lead_id: leadId });

    if (error?.message?.includes('insufficient_credits')) {
      toast('Not enough credit balance ($) to claim this lead — contact the administrator to top up.', 'error');
      btn.disabled = false;
      btn.textContent = originalText;
    } else if (error || !success) {
      toast('Too slow! Someone else already claimed this lead.', 'error');
      await loadAvailableLeads(); // Osveži da prebaci u status "Claimed"
    } else {
      toast('Lead successfully claimed — contact details unlocked below.', 'success');
      await Promise.all([loadAvailableLeads(), loadClaimedLeads()]); // Briše iz gornje, dodaje u donju
      await refreshCreditBalance();
    }
  }

  async function refreshCreditBalance() {
    const overviewCard = document.getElementById('overviewCreditsCard');
    const overviewLabel = document.getElementById('overviewCredits');
    const profileCard = document.getElementById('creditsCard');
    const profileLabel = document.getElementById('profileCreditBalance');
    if (!contractorId) return;

    const { data: enabled } = await supabase.rpc('is_credit_system_enabled');
    if (!enabled) {
      overviewCard?.classList.add('hidden');
      profileCard?.classList.add('hidden');
      return;
    }

    const { data: c } = await supabase.from('contractors').select('credit_balance').eq('user_id', contractorId).maybeSingle();
    const balanceText = `$${c?.credit_balance ?? 0}`;
    if (overviewLabel) overviewLabel.textContent = balanceText;
    if (profileLabel) profileLabel.textContent = balanceText;
    overviewCard?.classList.remove('hidden');
    profileCard?.classList.remove('hidden');

    await refreshPendingCreditRequest();
  }

  async function refreshPendingCreditRequest() {
    const notice = document.getElementById('creditPendingNotice');
    const noticeText = document.getElementById('creditPendingText');
    const form = document.getElementById('creditRequestForm');
    if (!contractorId || !notice || !noticeText || !form) return;

    const { data: pending } = await supabase
      .from('credit_requests')
      .select('requested_amount, created_at')
      .eq('account_type', 'contractor')
      .eq('account_id', contractorId)
      .eq('status', 'pending')
      .order('created_at', { ascending: false })
      .maybeSingle();

    if (pending) {
      noticeText.textContent = pending.requested_amount
        ? `You requested $${pending.requested_amount} on ${new Date(pending.created_at).toLocaleDateString()} — waiting for admin review.`
        : `Sent on ${new Date(pending.created_at).toLocaleDateString()} — waiting for admin review.`;
      notice.classList.remove('hidden');
      form.classList.add('hidden');
    } else {
      notice.classList.add('hidden');
      form.classList.remove('hidden');
    }
  }

  document.getElementById('overviewCreditsLink')?.addEventListener('click', () => goToTab('profile'));
  document.getElementById('permitPreviewViewAll')?.addEventListener('click', () => goToTab('permits'));

  document.getElementById('creditRequestForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!contractorId) return;
    const btn = document.getElementById('creditRequestBtn') as HTMLButtonElement;
    const msg = document.getElementById('creditRequestMsg')!;
    const amountInput = document.getElementById('creditRequestAmount') as HTMLInputElement;
    const noteInput = document.getElementById('creditRequestNote') as HTMLInputElement;
    const requested_amount = amountInput.value ? Number(amountInput.value) : null;
    const note = noteInput.value.trim() || null;

    btn.disabled = true;
    btn.textContent = 'Sending...';
    try {
      const { data: inserted, error } = await supabase
        .from('credit_requests')
        .insert([{ account_type: 'contractor', account_id: contractorId, requested_amount, note, status: 'pending' }])
        .select('id')
        .single();
      if (error || !inserted) throw error || new Error('insert_failed');

      await fetch('/api/notify-credit-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ requestId: inserted.id }),
      }).catch(() => {});

      msg.textContent = '✅ Request sent — the administrator will review it shortly.';
      msg.className = 'mt-2 text-[11px] text-green-700';
      amountInput.value = '';
      noteInput.value = '';
      await refreshPendingCreditRequest();
    } catch (err) {
      msg.textContent = '❌ Could not send request. Please try again.';
      msg.className = 'mt-2 text-[11px] text-red-600';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Request more credit';
    }
  });

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.href = '/login'; return; }

    const { data: contractor, error } = await supabase.rpc('link_contractor_account');
    if (error || !contractor) { show('stateNoAccess'); return; }

    contractorId = session.user.id;

    const nameLabel = document.getElementById('companyNameLabel');
    if (nameLabel && contractor.company_name) nameLabel.textContent = contractor.company_name;

    if (contractor.status === 'pending') { show('statePending'); return; }
    if (contractor.status !== 'active') { show('statePending'); return; }

    refreshCreditBalance();
    initPayPalCreditButton({
      supabase,
      comingSoonNoteId: 'paypalComingSoonNote',
      buySectionId: 'paypalBuySection',
      amountInputId: 'paypalAmount',
      buttonContainerId: 'paypalButtonContainer',
      msgId: 'paypalPurchaseMsg',
      onSuccess: refreshCreditBalance,
    });

    // Popuni formu za profil
    (document.getElementById('profileCompany') as HTMLInputElement).value = contractor.company_name || '';
    (document.getElementById('profileContact') as HTMLInputElement).value = contractor.contact_name || '';
    (document.getElementById('profilePhone') as HTMLInputElement).value = contractor.phone || '';
    (document.getElementById('profileTerritory') as HTMLSelectElement).value = contractor.territory || '';
    (document.getElementById('profileEmail') as HTMLInputElement).value = contractor.email || '';

    document.getElementById('saveProfileBtn')?.addEventListener('click', async () => {
      const msg = document.getElementById('profileMsg')!;
      const btn = document.getElementById('saveProfileBtn') as HTMLButtonElement;
      btn.disabled = true;
      msg.textContent = 'Saving...';
      msg.className = 'text-[11px] text-slate-600';

      const { error: updateError } = await supabase.from('contractors').update({
        company_name: (document.getElementById('profileCompany') as HTMLInputElement).value,
        contact_name: (document.getElementById('profileContact') as HTMLInputElement).value,
        phone: (document.getElementById('profilePhone') as HTMLInputElement).value,
        territory: (document.getElementById('profileTerritory') as HTMLSelectElement).value,
      }).eq('id', contractor.id);

      if (updateError) {
        msg.textContent = '❌ ' + updateError.message;
        msg.className = 'text-[11px] text-red-600';
      } else {
        msg.textContent = '✅ Profile updated.';
        msg.className = 'text-[11px] text-green-700';
      }
      btn.disabled = false;
    });

    // --- PUBLIC PROFILE ---
    // Dohvati trenutne public profile podatke
    const { data: publicData } = await supabase
      .from('contractors')
      .select('bio, website, license_number, services_offered, is_public, slug')
      .eq('id', contractor.id)
      .maybeSingle();

    if (publicData) {
      (document.getElementById('profileBio') as HTMLTextAreaElement).value = publicData.bio || '';
      (document.getElementById('profileWebsite') as HTMLInputElement).value = publicData.website || '';
      (document.getElementById('profileLicense') as HTMLInputElement).value = publicData.license_number || '';
      (document.getElementById('profileIsPublic') as HTMLInputElement).checked = !!publicData.is_public;

      // Services checkboxes
      const services: string[] = publicData.services_offered || [];
      document.querySelectorAll<HTMLInputElement>('.service-checkbox').forEach((cb) => {
        cb.checked = services.includes(cb.value);
      });

      // View profile link
      if (publicData.slug) {
        const viewLink = document.getElementById('viewPublicProfileLink') as HTMLAnchorElement;
        if (viewLink) {
          viewLink.href = `/contractors/${publicData.slug}`;
          viewLink.classList.remove('hidden');
          viewLink.classList.add('flex');
        }
      }
    }

    document.getElementById('savePublicProfileBtn')?.addEventListener('click', async () => {
      const msg = document.getElementById('publicProfileMsg')!;
      const btn = document.getElementById('savePublicProfileBtn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Saving...';
      msg.textContent = '';

      const services_offered = Array.from(
        document.querySelectorAll<HTMLInputElement>('.service-checkbox:checked')
      ).map((cb) => cb.value);

      try {
        const res = await fetch('/api/update-public-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            bio: (document.getElementById('profileBio') as HTMLTextAreaElement).value,
            website: (document.getElementById('profileWebsite') as HTMLInputElement).value,
            license_number: (document.getElementById('profileLicense') as HTMLInputElement).value,
            services_offered,
            is_public: (document.getElementById('profileIsPublic') as HTMLInputElement).checked,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || 'Update failed');

        msg.textContent = '✅ Public profile saved.';
        msg.className = 'text-[11px] text-green-700';

        // Show / update the view link
        if (data.slug) {
          const viewLink = document.getElementById('viewPublicProfileLink') as HTMLAnchorElement;
          if (viewLink) {
            viewLink.href = `/contractors/${data.slug}`;
            viewLink.classList.remove('hidden');
            viewLink.classList.add('flex');
          }
        }
      } catch (err) {
        msg.textContent = '❌ ' + (err as Error).message;
        msg.className = 'text-[11px] text-red-600';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save Public Profile';
      }
    });

    // --- MY REVIEWS ---
    async function loadMyReviews() {
      const { data: reviews } = await supabase
        .from('contractor_reviews')
        .select('id, rating, body, reviewer_name, status, created_at')
        .eq('contractor_id', contractor.id)
        .order('created_at', { ascending: false })
        .limit(30);

      const container = document.getElementById('myReviewsList')!;
      if (!reviews || reviews.length === 0) {
        container.innerHTML = '<p class="text-xs text-slate-400 italic">No reviews yet. Share your public profile link with customers to collect feedback.</p>';
        return;
      }

      const statusBadge = (s: string) => {
        if (s === 'approved') return '<span class="rounded-full bg-green-50 border border-green-200 text-green-700 text-[9px] font-bold uppercase px-2 py-0.5">Approved</span>';
        if (s === 'rejected') return '<span class="rounded-full bg-red-50 border border-red-200 text-red-700 text-[9px] font-bold uppercase px-2 py-0.5">Rejected</span>';
        return '<span class="rounded-full bg-amber-50 border border-amber-200 text-amber-700 text-[9px] font-bold uppercase px-2 py-0.5">Pending</span>';
      };

      const starsHtml = (r: number) => Array.from({ length: 5 }, (_, i) =>
        `<span class="${i < r ? 'text-amber-400' : 'text-slate-300'}">★</span>`
      ).join('');

      container.innerHTML = reviews.map((r: any) => `
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <div class="flex items-center gap-1 text-base">${starsHtml(r.rating)}</div>
            <div class="flex items-center gap-2">
              ${statusBadge(r.status)}
              <span class="text-[10px] text-slate-400">${new Date(r.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </div>
          </div>
          ${r.reviewer_name ? `<p class="mt-1.5 text-xs font-bold text-slate-700">${r.reviewer_name}</p>` : ''}
          ${r.body ? `<p class="mt-2 text-xs leading-5 text-slate-600">${r.body}</p>` : ''}
        </div>
      `).join('');
    }
    loadMyReviews();

    // --- SIDEBAR PUBLIC TOGGLE ---
    if (publicData) {
      const card = document.getElementById('publicProfileToggleCard')!;
      const toggle = document.getElementById('sidebarIsPublicToggle') as HTMLInputElement;
      const status = document.getElementById('sidebarPublicStatus')!;
      const link = document.getElementById('sidebarProfileLink') as HTMLAnchorElement;
      const msg = document.getElementById('sidebarPublicMsg')!;

      card.classList.remove('hidden');
      toggle.checked = !!publicData.is_public;

      function updateSidebarStatus(isPublic: boolean) {
        status.textContent = isPublic
          ? 'Profil je vidljiv u direktorijumu kontraktora.'
          : 'Profil je skriven. Uključi da bude vidljiv.';
        if (publicData?.slug) {
          link.href = `/contractors/${publicData.slug}`;
          link.classList.toggle('hidden', !isPublic);
        }
      }
      updateSidebarStatus(!!publicData.is_public);

      toggle.addEventListener('change', async () => {
        const isPublic = toggle.checked;
        msg.textContent = 'Saving…';
        const res = await fetch('/api/update-public-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ is_public: isPublic }),
        });
        const data = await res.json();
        if (res.ok) {
          updateSidebarStatus(isPublic);
          // Sync with the main profile toggle too
          const mainToggle = document.getElementById('profileIsPublic') as HTMLInputElement;
          if (mainToggle) mainToggle.checked = isPublic;
          msg.textContent = isPublic ? '✅ Profil je sada javan' : '✅ Profil sakriven';
          msg.className = 'text-[10px] text-green-700';
          if (data.slug) {
            link.href = `/contractors/${data.slug}`;
            const mainLink = document.getElementById('viewPublicProfileLink') as HTMLAnchorElement;
            if (mainLink) { mainLink.href = `/contractors/${data.slug}`; mainLink.classList.remove('hidden'); mainLink.classList.add('flex'); }
          }
        } else {
          toggle.checked = !isPublic;
          msg.textContent = '❌ Greška pri čuvanju';
          msg.className = 'text-[10px] text-red-600';
        }
        setTimeout(() => { msg.textContent = ''; }, 3000);
      });
    }

    show('stateActive');
    goToTab('available');
    await Promise.all([loadAvailableLeads(), loadClaimedLeads(), loadRecommendedTrucks(), loadPermitLeadsMarketplace()]);

    pollTimer = setInterval(loadAvailableLeads, 8000); // Proverava svakih 8 sekundi
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:before-swap', () => {
    if (pollTimer) clearInterval(pollTimer);
  });
</script>
