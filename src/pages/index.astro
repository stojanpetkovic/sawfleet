---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import MobileNav from "../components/layout/MobileNav.astro";
import Footer from "../components/layout/Footer.astro";
import { supabase } from "../lib/supabase";
import { supabaseAdmin } from "../lib/supabaseAdmin";
import { ArrowRight, Calendar, Eye, Mail, MapPin, Phone, ScrollText, Star } from "lucide-astro";

// Poslednja 4 objavljena blog posta za izdvojenu sekciju na dnu strane
const { data: featuredPosts } = await supabase
  .from('blog_posts')
  .select('title, slug, excerpt, cover_image_url, category, published_at')
  .eq('status', 'published')
  .order('published_at', { ascending: false })
  .limit(4);

// Homepage teaser: nekoliko najnovijih kvalifikovanih permit leadova, sa
// punim kontaktom. permit_leads nema javnu RLS politiku, pa SSR upit koristi
// service role da je zaobiđe (isti obrazac kao /permit-leads).
const permitDb = supabaseAdmin ?? supabase;
const [{ data: permitTeasers }, { count: permitTeaserTotal }] = await Promise.all([
  permitDb
    .from('permit_leads')
    .select('id, owner_name, owner_phone, owner_email, address, jurisdiction, permit_type, permit_date')
    .eq('permit_status', 'qualified')
    .is('archived_at', null)
    .order('discovered_at', { ascending: false })
    .limit(9),
  permitDb
    .from('permit_leads')
    .select('id', { count: 'exact', head: true })
    .eq('permit_status', 'qualified')
    .is('archived_at', null),
]);

// Broj različitih jurisdikcija koje trenutno pokrivamo — realan podatak,
// ne izmišljen. Samo jurisdiction kolona, dovoljno jeftino i za par stotina redova.
const { data: jurisdictionRows } = await permitDb
  .from('permit_leads')
  .select('jurisdiction')
  .eq('permit_status', 'qualified')
  .is('archived_at', null)
  .not('jurisdiction', 'is', null);
const jurisdictionCount = new Set((jurisdictionRows || []).map((r: any) => r.jurisdiction)).size;
---

<MainLayout
  title="SF Tree Removal | Permit Leads Portal for Tree Care Businesses"
  description="Browse property owners who recently filed a tree-related permit across South Florida, with contact details included.">

  <Header />

  <main class="bg-slate-950">

    <!-- ============================================== -->
    <!-- HERO -->
    <!-- ============================================== -->
    <section class="relative overflow-hidden border-b border-white/10 bg-slate-950 px-5 pt-28 pb-14 text-white md:px-8 md:pt-36 lg:pb-20">
      <!-- Blueprint grid tekstura — unificiran identitet svih hero sekcija -->
      <div class="pointer-events-none absolute inset-0 opacity-[0.5]" aria-hidden="true" style="background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 34px 34px;"></div>
      <div class="pointer-events-none absolute -right-24 -top-32 h-[28rem] w-[28rem] rounded-full bg-green-500/[0.14] blur-[120px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -left-32 top-1/2 h-80 w-80 rounded-full bg-emerald-500/[0.08] blur-[110px]" aria-hidden="true"></div>

      <!-- Decorativni "ghost" ikonice u pozadini, samo desktop, čisto vizuelno -->
      <ScrollText size={190} strokeWidth={0.8} class="pointer-events-none absolute -right-6 top-16 hidden -rotate-12 text-white/[0.05] lg:block" aria-hidden="true" />
      <MapPin size={130} strokeWidth={0.8} class="pointer-events-none absolute right-72 -top-6 hidden rotate-6 text-white/[0.05] lg:block" aria-hidden="true" />

      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-green-400"></span>
          </span>
          <span class="text-[10px] font-mono font-bold uppercase tracking-[0.22em] text-green-400">Live feed · public permit records</span>
        </div>
        <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl">Potential <span class="bg-gradient-to-r from-green-400 via-emerald-300 to-green-400 bg-clip-text text-transparent">Permit Leads</span></h1>
        <p class="mt-5 max-w-2xl text-sm leading-7 text-slate-400 md:text-base">Property owners who recently filed a tree-related permit application with their local jurisdiction across South Florida — public government records, compiled here with the contact details included in the filing.</p>

        <!-- Trust row: dekorativno, bez konkretnih brojeva -->
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 backdrop-blur">
            <Eye size={14} class="text-green-300" strokeWidth={1.8} />
            <span class="text-[11px] font-bold text-slate-300">Visited daily by tree care businesses</span>
          </div>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 backdrop-blur">
            <div class="flex gap-0.5 text-amber-400">
              {Array.from({ length: 5 }).map(() => <Star size={12} fill="currentColor" strokeWidth={0} />)}
            </div>
            <span class="text-[11px] font-bold text-slate-300">Trusted public-records source</span>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center divide-x divide-white/10 rounded-2xl border border-white/10 bg-white/[0.03] px-6 py-4 font-mono backdrop-blur">
          <div class="pr-6"><strong class="block text-2xl font-bold text-white">{(permitTeaserTotal ?? 0).toLocaleString()}</strong><span class="mt-1 block text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">qualified_leads</span></div>
          <div class="pl-6"><strong class="block text-2xl font-bold text-white">{jurisdictionCount.toLocaleString()}</strong><span class="mt-1 block text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">jurisdictions</span></div>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- PERMIT LEADS GRID — data-feed / permit-ticket aesthetic -->
    <!-- ============================================== -->
    <section class="bg-slate-950 px-4 py-14 text-white sm:px-8 lg:py-16">
      <div class="mx-auto max-w-[1200px]">

        <!-- Ticket grid -->
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {(permitTeasers || []).length === 0 && (
            <div class="col-span-full rounded-2xl border border-dashed border-white/15 bg-white/[0.02] p-10 text-center text-sm text-slate-500">No qualified permit leads right now — check back soon.</div>
          )}
          {(permitTeasers || []).map((lead: any) => (
            <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] backdrop-blur transition-all hover:-translate-y-1 hover:border-green-400/40 hover:bg-white/[0.06]">

              <!-- Record header -->
              <div class="flex items-center justify-between gap-2 px-5 pt-4">
                <span class="inline-flex items-center gap-1.5 text-[9px] font-mono font-bold uppercase tracking-[0.16em] text-slate-500"><ScrollText size={12} /> Record</span>
                <span class="font-mono text-[10px] font-bold tracking-wider text-slate-500">#{String(lead.id).replace(/-/g, "").slice(0, 8).toUpperCase()}</span>
              </div>

              <!-- Permit info -->
              <div class="px-5 pb-5 pt-3">
                <span class="inline-flex items-center rounded-md border border-green-400/25 bg-green-400/10 px-2 py-1 text-[9px] font-bold uppercase tracking-wider text-green-300">{lead.permit_type || "Permit"}</span>
                <h3 class="mt-3 text-base font-bold leading-snug text-white">{lead.address || "Address not listed"}</h3>
                <div class="mt-2 flex flex-wrap items-center gap-3 text-[11px] text-slate-500">
                  {lead.jurisdiction && <span class="inline-flex items-center gap-1 font-mono"><MapPin size={11} /> {lead.jurisdiction}</span>}
                  {lead.permit_date && <span class="inline-flex items-center gap-1 font-mono"><Calendar size={11} /> {new Date(lead.permit_date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>}
                </div>
              </div>

              <!-- Perforation -->
              <div class="relative" aria-hidden="true">
                <div class="border-t border-dashed border-white/15"></div>
                <span class="absolute -left-2.5 top-1/2 h-5 w-5 -translate-y-1/2 rounded-full bg-slate-950"></span>
                <span class="absolute -right-2.5 top-1/2 h-5 w-5 -translate-y-1/2 rounded-full bg-slate-950"></span>
              </div>

              <!-- Owner contact -->
              <div class="flex flex-1 flex-col gap-2.5 px-5 py-5">
                <span class="text-[9px] font-mono font-bold uppercase tracking-[0.16em] text-slate-500">Filed by</span>
                <p class="text-sm font-bold text-white">{lead.owner_name || "Name not listed"}</p>
                <div class="mt-1 flex flex-col gap-2">
                  {lead.owner_phone && <a href={`tel:${lead.owner_phone}`} class="inline-flex items-center gap-2 font-mono text-xs font-bold text-green-400 hover:text-green-300"><Phone size={13} /> {lead.owner_phone}</a>}
                  {lead.owner_email && <a href={`mailto:${lead.owner_email}`} class="inline-flex items-center gap-2 break-all font-mono text-xs font-bold text-green-400 hover:text-green-300"><Mail size={13} /> {lead.owner_email}</a>}
                </div>
              </div>
            </article>
          ))}
        </div>

        <a href="/permit-leads" class="mt-9 inline-flex h-12 items-center justify-center gap-2 rounded-xl bg-green-500 px-6 text-xs font-bold uppercase tracking-[0.14em] text-slate-950 shadow-[0_12px_30px_-14px_rgba(74,222,128,0.6)] transition hover:bg-green-400">See all permit leads <ArrowRight size={15} /></a>
      </div>
    </section>

    {featuredPosts && featuredPosts.length > 0 && (
      <section class="border-t border-slate-200 bg-white px-4 py-14 font-sans sm:px-8 sm:py-20 lg:py-24">
        <div class="mx-auto max-w-[1200px]">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-700">// From the blog</span>
              <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">Tips, guides, and stories</h2>
            </div>
            <a href="/blog" class="inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 text-[10px] font-bold uppercase tracking-[0.15em] text-slate-700 transition hover:border-green-300 hover:text-green-800">View all posts <ArrowRight size={14} /></a>
          </div>

          <div class="mt-9 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
            {featuredPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-soft transition-all hover:-translate-y-0.5 hover:border-green-200 hover:shadow-soft-lg"
              >
                <div class="relative aspect-[16/10] w-full overflow-hidden bg-slate-100">
                  {post.cover_image_url ? (
                    <img src={post.cover_image_url} alt={post.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                  ) : (
                    <div class="h-full w-full bg-gradient-to-br from-green-50 to-slate-100"></div>
                  )}
                  {post.category && <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wider text-green-700">{post.category}</span>}
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <span class="text-[10px] font-mono text-slate-400">{post.published_at ? new Date(post.published_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : ""}</span>
                  <h3 class="mt-2 text-sm font-bold text-slate-950 leading-snug">{post.title}</h3>
                  {post.excerpt && <p class="mt-2 text-xs leading-5 text-slate-500 line-clamp-3">{post.excerpt}</p>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

  </main>

  <Footer />
  <MobileNav />

</MainLayout>
