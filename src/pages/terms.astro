---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileNav from "../components/layout/MobileNav.astro";
const sections = [
  ["Platform role", "SF Tree Removal provides a dispatch and marketplace platform connecting property owners with independent contractors and fleet operators. SF Tree Removal is not a contractor, tree service provider, employer of service providers, or insurer. Unless expressly stated, service providers are independent businesses, not agents or representatives of SF Tree Removal."],
  ["Requests and estimates", "Submitting a service request does not create a contract, guarantee service availability, response time, pricing or project acceptance. The contractor you select is solely responsible for providing an estimate, quote and service. All terms, pricing, permits, scheduling, payment arrangements and service conditions are negotiated directly between you and the service provider."],
  ["Independent providers", "Contractors and fleet operators are independent businesses. Each is solely responsible for their personnel, equipment, business licenses, insurance coverage, work quality, safety practices, compliance with federal/state/local laws, and proper handling of waste and debris. SF Tree Removal makes no warranties regarding the work quality, timeliness or conduct of any provider."],
  ["Account responsibilities", "You agree to provide accurate, current information; maintain confidentiality of your login credentials; promptly update account information; and comply with all applicable laws. You may not impersonate others, misuse contact information, bypass security measures, submit fraudulent requests, or interfere with platform operation."],
  ["Acceptable use", "You will not submit fraudulent requests, scrape or download platform data, attempt to gain unauthorized access, distribute malware, engage in harassment, post illegal content, or use the platform for any unlawful purpose. Violations may result in account termination without refund."],
  ["Form submissions and agreement", "By submitting any form on this platform—including service requests, property details, contractor applications, registration forms, contact inquiries, or support tickets—you acknowledge and agree that: (1) All information provided is accurate, truthful and complete to the best of your knowledge; (2) You have read and agree to be bound by these Terms of Service and our Privacy Policy; (3) You consent to our collection and processing of the information as described in our Privacy Policy; (4) You authorize SF Tree Removal to share your information with relevant service providers to fulfill your request; (5) You accept full responsibility for any consequences arising from the information you provide; and (6) Submission constitutes your legal acceptance of these Terms and all conditions herein."],
  ["Content and listings", "You retain ownership of information and media you submit. By uploading content, you grant SF Tree Removal a worldwide, non-exclusive license to host, display, process and distribute that content as necessary to provide the platform service. You represent that you have the right to provide all submitted content and that it does not violate intellectual property rights or laws."],
  ["Emergency disclaimer", "Tree work can involve serious risk to people, property and utilities. DO NOT USE THIS PLATFORM FOR LIFE-SAFETY EMERGENCIES. If there is immediate danger, call 911 or local emergency services. If a tree has fallen on a power line, contact your electric utility immediately."],
  ["Disclaimers and limitations", "The platform is provided on an 'as-is' and 'as-available' basis. To the maximum extent permitted by Florida law, SF Tree Removal disclaims all warranties, express or implied, including merchantability and fitness for a particular purpose. We do not warrant that the platform will be uninterrupted or error-free, or that service providers will respond, accept requests, or perform satisfactory work."],
  ["Limitation of liability", "To the maximum extent permitted by Florida law, SF Tree Removal shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from platform use, service request submissions, or work performed by independent providers, even if advised of the possibility of such damages. Our total liability shall not exceed the fees you paid in the past 12 months."],
  ["Contractor qualifications and licensing", "Contractors and fleet operators are solely responsible for maintaining all required state and local licenses, permits, certifications and insurance. Customers should verify contractor credentials independently. Florida law requires tree service companies to be properly licensed and insured. SF Tree Removal does not verify or guarantee the validity of licenses or insurance."],
  ["Assumption of risk", "You acknowledge that tree service work involves inherent risks including property damage, personal injury and death. You assume all risk associated with hiring independent contractors through this platform. You should verify contractor insurance before work begins."],
  ["Payment and refunds", "Payments are processed by third-party payment providers and are subject to their terms. SF Tree Removal is not responsible for payment disputes, failed transactions or fraudulent charges. Service refunds are governed by your agreement with the contractor, not by SF Tree Removal."],
  ["Dispute resolution", "For disputes arising from platform use, you agree to attempt resolution through our Support process first. If unresolved, disputes shall be governed by Florida law and venue shall be in the county where SF Tree Removal is located. You waive jury trial rights to the extent permitted by law."],
  ["Changes and termination", "We may modify, suspend or discontinue platform features at any time. We may terminate or restrict accounts that violate these terms, engage in fraudulent activity, or pose a risk to the platform. Continued use after updates constitutes acceptance of revised terms. Sections regarding disclaimers, limitation of liability, and dispute resolution survive termination."],
  ["Entire agreement", "These terms, combined with our Privacy Policy, constitute the entire agreement between you and SF Tree Removal regarding platform use and supersede all prior agreements or understandings."],
];
---
<MainLayout title="Terms of Service | SF Tree Removal" description="Terms governing use of the SF Tree Removal dispatch platform."><Header /><main class="bg-white pt-28 lg:pt-32"><section class="px-4 py-16 sm:px-8 lg:py-20"><div class="mx-auto max-w-3xl"><span class="text-[10px] font-mono font-bold uppercase tracking-[0.22em] text-green-700">// Legal</span><h1 class="mt-4 text-4xl font-bold tracking-tighter text-slate-950 sm:text-5xl">Terms of Service</h1><p class="mt-4 text-sm text-slate-500">Effective July 21, 2026</p><p class="mt-8 text-base leading-relaxed text-slate-600">These terms govern access to the SF Tree Removal website, dispatch workflows, portals and related services.</p><div class="mt-12 space-y-10">{sections.map(([title, text]) => <section><h2 class="text-lg font-bold text-slate-950">{title}</h2><p class="mt-3 text-sm leading-7 text-slate-600">{text}</p></section>)}</div><div class="mt-12 rounded-2xl border border-amber-200 bg-amber-50 p-6 text-xs leading-relaxed text-amber-900">Tree work can involve serious risk. Do not use the website for an immediate life-safety emergency. Contact local emergency services when people, utilities or public access are in immediate danger.</div></div></section></main><Footer /><MobileNav /></MainLayout>
