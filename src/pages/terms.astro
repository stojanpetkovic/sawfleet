---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileNav from "../components/layout/MobileNav.astro";
const sections = [
  ["Who we are and what this website does", "SF Tree Removal operates a public information portal for the tree care industry in South Florida. It publishes leads compiled from public tree-related permit records, a directory of tree-service and equipment operators, and a blog. We are not a tree service provider, do not perform tree work, do not sell marketing, advertising or website services through this site, and are not a party to any job, sale or agreement between you and anyone you contact through information found here."],
  ["Free access, no accounts", "The public parts of this website are free to browse and do not require an account. Areas marked for administrators are restricted to authorized users. By using the website you agree to these Terms and to our Privacy Policy."],
  ["Permit lead data", "Permit leads are compiled from public government permit records and may include property addresses, permit details and, where present in the filing, an owner's or applicant's name, phone number and email address. The data is provided for informational purposes only, as-is, and may be incomplete, out of date or wrong. We do not guarantee that a listed person needs, wants or will respond to any service, that a permit is still active, or that a lead is exclusive to you. Permit data belongs to the public record and is not owned by us."],
  ["Contractor directory", "Directory listings are compiled from publicly available business information. They are unclaimed and unverified: we have not checked licenses, insurance, equipment specifications, availability or reputation, and a listing is not an endorsement or recommendation. You are solely responsible for verifying any business before relying on or hiring it."],
  ["Blog and general information", "Blog posts and other content are general information, not professional, legal, safety, engineering or arboricultural advice. Tree work is dangerous; always use qualified, licensed and insured professionals and follow local permit rules."],
  ["Your responsibilities when contacting people", "If you contact anyone identified through this website, you are solely responsible for doing so lawfully and respectfully, including compliance with telemarketing, do-not-call, text-messaging and email laws (such as the TCPA, the Florida Telephone Solicitation Act and CAN-SPAM) and local solicitation rules, and for honoring any request not to be contacted. Do not misrepresent who you are or use the data to harass, defraud or pressure anyone."],
  ["Acceptable use", "You will not scrape or bulk-download website data beyond normal browsing, resell or republish the data as your own database, attempt to gain unauthorized access, interfere with the website, distribute malware, or use the website for any unlawful purpose. We may restrict access for anyone who does."],
  ["Emails we send about permits", "We may email addresses that appear in public permit filings, subject to our Privacy Policy. Recipients can stop further emails using the \"Do not contact me again\" link in each message."],
  ["Third-party websites", "The website may link to other websites, including directory listings' own sites. We do not control or endorse them, are not responsible for their content, products or services, and any dealings with them are between you and them."],
  ["Removal and correction requests", "If you are named in a listing and want it corrected or removed from this website, you may ask us and we will review the request in good faith. Removal here does not affect the original government record."],
  ["Intellectual property", "The design, text, logos and code of this website belong to SF Tree Removal or its licensors. Third-party names and logos belong to their owners and are shown for identification only. You may view and share pages for personal or internal business use."],
  ["Disclaimers", "The website is provided \"as is\" and \"as available.\" To the maximum extent permitted by Florida law, SF Tree Removal disclaims all warranties, express or implied, including merchantability, fitness for a particular purpose, accuracy and non-infringement. We do not warrant that the website will be uninterrupted or error-free or that any lead, listing or content is current, accurate or complete."],
  ["Limitation of liability", "To the maximum extent permitted by Florida law, SF Tree Removal and its owners are not liable for any indirect, incidental, special, consequential or punitive damages, or for lost profits, leads, jobs or business, arising from your use of the website or reliance on its content or data, even if advised of the possibility of such damages."],
  ["Governing law and disputes", "These Terms are governed by Florida law. Please try to resolve any dispute with us informally first. If that fails, disputes will be brought in the state or federal courts located in Florida, and you waive any right to a jury trial to the extent permitted by law."],
  ["Changes and termination", "We may change, suspend or discontinue any part of the website at any time and may update these Terms by posting a new version with a new effective date. Continued use after an update means you accept it."],
  ["Entire agreement", "These Terms and our Privacy Policy are the entire agreement between you and SF Tree Removal about your use of this website. If a provision is found unenforceable, the rest remains in effect."],
];

---
<MainLayout title="Terms of Service | SF Tree Removal" description="Terms governing use of the SF Tree Removal permit leads portal."><Header /><main class="bg-white pt-28 lg:pt-32"><section class="px-4 py-16 sm:px-8 lg:py-20"><div class="mx-auto max-w-3xl"><span class="text-[10px] font-mono font-bold uppercase tracking-[0.22em] text-green-700">// Legal</span><h1 class="mt-4 text-4xl font-bold tracking-tighter text-slate-950 sm:text-5xl">Terms of Service</h1><p class="mt-4 text-sm text-slate-500">Effective September 20, 2026</p><p class="mt-8 text-base leading-relaxed text-slate-600">These terms govern access to the SF Tree Removal website, a public portal publishing tree-related permit leads and a contractor directory for South Florida.</p><div class="mt-12 space-y-10">{sections.map(([title, text]) => <section><h2 class="text-lg font-bold text-slate-950">{title}</h2><p class="mt-3 text-sm leading-7 text-slate-600">{text}</p></section>)}</div></div></section></main><Footer /><MobileNav /></MainLayout>
