---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileNav from "../components/layout/MobileNav.astro";
import { supabase } from "../lib/supabase";
import {
  ArrowRight,
  Camera,
  CheckCircle2,
  CircleDotDashed,
  CloudLightning,
  FileText,
  Info,
  LandPlot,
  MapPin,
  MessageSquareText,
  Ruler,
  Scissors,
  ShieldCheck,
  Trees,
  UserRoundCheck,
} from "lucide-astro";

const { count: territoryCount } = await supabase
  .from("service_territories")
  .select("id", { count: "exact", head: true });

const services = [
  { icon: Trees, number: "01", title: "Tree Removal", text: "Removal requests for dead, damaged, hazardous or unwanted trees, including trees near structures, fences and constrained access.", details: ["Tree condition", "Nearby structures", "Access width"] },
  { icon: Scissors, number: "02", title: "Trimming & Pruning", text: "Canopy maintenance, clearance trimming and selective pruning for property access, visible hazards and storm preparation.", details: ["Clearance needed", "Tree count", "Desired timing"] },
  { icon: CircleDotDashed, number: "03", title: "Stump Grinding", text: "Below-grade stump grinding requests to recover usable space and prepare an area for landscaping or construction.", details: ["Stump diameter", "Quantity", "Gate access"] },
  { icon: LandPlot, number: "04", title: "Lot & Land Clearing", text: "Tree and vegetation clearing for residential improvements, site access, cleanup and property preparation.", details: ["Lot size", "Material density", "Haul-away needs"] },
  { icon: CloudLightning, number: "05", title: "Storm-Damage Response", text: "Requests involving fallen trees, blocked access and damaged limbs after severe weather, subject to contractor availability.", details: ["Immediate hazard", "Access blocked", "Utility involvement"] },
  { icon: ShieldCheck, number: "06", title: "Hazard Assessment", text: "Connection with a local professional who can inspect visible concerns and discuss appropriate next steps for the property.", details: ["Visible damage", "Recent changes", "Area at risk"] },
];

const requestDetails = [
  { icon: MapPin, title: "Exact location", text: "Choose the active territory and include enough address context to understand travel and access." },
  { icon: Camera, title: "Visible condition", text: "Describe damage, lean, decay, fallen material or anything close to a building, road or utility." },
  { icon: Ruler, title: "Scale and access", text: "Estimate tree or stump size, quantity, gate width, slope and equipment access where possible." },
  { icon: FileText, title: "Timing and expectations", text: "Note urgency, preferred timing, cleanup needs and whether permits or approvals are already known." },
];
---

<MainLayout title="Tree Services & Request Routing | SF Tree Removal" description="Submit tree removal, trimming, stump grinding, lot clearing, hazard assessment and storm-damage requests across active South Florida service areas.">
  <Header />
  <main class="bg-white pt-16 lg:pt-20">
    <section class="relative isolate overflow-hidden bg-slate-950 px-4 py-16 text-white sm:px-8 sm:py-20 lg:py-24">
      <img src="/videos/hero-tree-service-poster.webp" alt="" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-35" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950 via-slate-950/95 to-slate-950/55"></div>
      <div class="mx-auto grid max-w-[1200px] gap-10 lg:grid-cols-[minmax(0,1fr)_390px] lg:items-end">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-green-400/20 bg-green-400/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-green-300"><Trees size={14} /> Tree-service requests</div>
          <h1 class="mt-6 text-4xl font-bold leading-[1.04] tracking-tighter sm:text-5xl lg:text-6xl">Describe the work once. Start the right local conversation.</h1>
          <p class="mt-6 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg">SF Tree Removal organizes your project details and routes the opportunity by service area. An independent contractor can then discuss assessment, scope, timing and pricing directly with you.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/#quote" class="inline-flex h-12 items-center justify-center gap-2 rounded-xl bg-green-600 px-6 text-xs font-bold uppercase tracking-[0.15em] text-white transition hover:bg-green-500">Request free estimate <ArrowRight size={15} /></a>
            <a href="/service-areas" class="inline-flex h-12 items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/[0.06] px-6 text-xs font-bold uppercase tracking-[0.15em] text-white transition hover:bg-white/10">Check service areas</a>
          </div>
        </div>
        <aside class="grid grid-cols-2 gap-3 rounded-2xl border border-white/10 bg-white/[0.06] p-5 backdrop-blur sm:p-6 lg:grid-cols-1">
          <div class="border-b border-white/10 pb-4"><span class="text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">Active coverage</span><strong class="mt-1 block text-2xl font-bold text-white">{territoryCount || 0} territories</strong></div>
          <div class="border-b border-white/10 pb-4"><span class="text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">Request cost</span><strong class="mt-1 block text-2xl font-bold text-white">Free</strong></div>
          <div class="col-span-2 lg:col-span-1"><span class="text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">Service model</span><strong class="mt-1 block text-sm font-bold text-white">Independent local providers</strong></div>
        </aside>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-8 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1200px]">
        <div class="grid gap-6 lg:grid-cols-[0.9fr_0.7fr] lg:items-end">
          <div><span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-700">// Services we route</span><h2 class="mt-3 text-3xl font-bold tracking-tighter text-slate-950 sm:text-4xl">A clear starting point for common tree-work needs.</h2></div>
          <p class="max-w-xl text-sm leading-7 text-slate-600">Choose the closest category, then use the project description to explain the actual condition. The responding provider determines the final service scope after reviewing the job.</p>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {services.map(({ icon: Icon, number, title, text, details }) => (
            <article class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-soft transition hover:-translate-y-0.5 hover:border-green-200 hover:shadow-soft-lg sm:p-6">
              <div class="flex items-start justify-between"><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-green-50 text-green-700"><Icon size={21} strokeWidth={1.7} /></span><span class="font-mono text-[10px] font-bold text-slate-400">// {number}</span></div>
              <h3 class="mt-6 text-lg font-bold text-slate-950">{title}</h3>
              <p class="mt-3 flex-1 text-sm leading-6 text-slate-600">{text}</p>
              <div class="mt-5 flex flex-wrap gap-1.5 border-t border-slate-100 pt-4">
                {details.map((detail) => <span class="rounded-full bg-slate-50 px-2.5 py-1 text-[9px] font-medium text-slate-500">{detail}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-slate-200 bg-slate-50 px-4 py-16 sm:px-8 sm:py-20 lg:py-24">
      <div class="mx-auto grid max-w-[1200px] gap-10 lg:grid-cols-[0.72fr_1fr] lg:items-start">
        <div>
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-950 text-green-300"><MessageSquareText size={22} /></span>
          <span class="mt-6 block text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-700">// Build a useful request</span>
          <h2 class="mt-3 text-3xl font-bold tracking-tighter text-slate-950 sm:text-4xl">Details that help the first conversation.</h2>
          <p class="mt-4 text-sm leading-7 text-slate-600">You do not need a technical diagnosis. A practical description of what you see, where it is and what access looks like is more useful.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {requestDetails.map(({ icon: Icon, title, text }, index) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-5">
              <div class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-green-50 text-green-700"><Icon size={18} /></span><span class="font-mono text-[9px] font-bold text-slate-400">0{index + 1}</span></div>
              <h3 class="mt-4 text-sm font-bold text-slate-950">{title}</h3>
              <p class="mt-2 text-xs leading-5 text-slate-600">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-950 px-4 py-16 text-white sm:px-8 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1200px]">
        <div class="max-w-2xl"><span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-400">// From request to conversation</span><h2 class="mt-3 text-3xl font-bold tracking-tighter sm:text-4xl">A simple, visible next step.</h2><p class="mt-4 text-sm leading-7 text-slate-400">Submitting a request does not authorize work or accept a quote. It provides enough information to begin the matching process.</p></div>
        <div class="mt-10 grid gap-4 lg:grid-cols-3">
          {[
            { icon: MessageSquareText, n: "01", title: "Submit the essentials", text: "Select the territory and provide your contact information and project description." },
            { icon: MapPin, n: "02", title: "Location-based routing", text: "The opportunity is organized for approved contractors configured to serve that territory." },
            { icon: UserRoundCheck, n: "03", title: "Direct follow-up", text: "A contractor may claim the lead and contact you to discuss inspection, scope, timing and price." },
          ].map(({ icon: Icon, n, title, text }) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.04] p-6"><div class="flex items-center justify-between"><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-green-400/10 text-green-300"><Icon size={21} /></span><span class="font-mono text-[10px] text-slate-500">{n}</span></div><h3 class="mt-6 text-lg font-bold">{title}</h3><p class="mt-3 text-sm leading-6 text-slate-400">{text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-8 sm:py-20">
      <div class="mx-auto grid max-w-[1200px] overflow-hidden rounded-3xl border border-green-200 bg-green-50 shadow-soft-lg lg:grid-cols-[1fr_0.85fr]">
        <div class="p-6 sm:p-9 lg:p-10">
          <div class="flex items-center gap-3"><CheckCircle2 size={18} class="text-green-700" /><span class="text-[10px] font-bold uppercase tracking-[0.18em] text-green-800">What the platform provides</span></div>
          <ul class="mt-6 space-y-4 text-sm leading-6 text-slate-700">
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-green-600"></span>One intake flow for location, contact details and project scope.</li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-green-600"></span>Routing based on active service territories and provider account settings.</li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-green-600"></span>A structured path to direct provider follow-up.</li>
          </ul>
        </div>
        <div class="border-t border-green-200 bg-white/70 p-6 sm:p-9 lg:border-l lg:border-t-0 lg:p-10">
          <div class="flex items-center gap-3"><Info size={18} class="text-slate-500" /><span class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-600">Confirm directly</span></div>
          <p class="mt-5 text-sm leading-7 text-slate-600">The independent provider handles assessment, quote and work. Confirm current credentials, insurance, crew protections, permits, written scope and payment terms for your property.</p>
          <a href="/compliance" class="mt-6 inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.15em] text-green-700 hover:text-green-900">Review responsibilities <ArrowRight size={14} /></a>
        </div>
      </div>
      <div class="mx-auto mt-6 flex max-w-[1200px] flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-soft sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="text-lg font-bold text-slate-950">Ready to describe your project?</h2><p class="mt-1 text-sm text-slate-600">The request is free and does not obligate you to hire a provider.</p></div>
        <a href="/#quote" class="inline-flex h-12 w-full shrink-0 items-center justify-center gap-2 rounded-xl bg-green-700 px-6 text-xs font-bold uppercase tracking-[0.15em] text-white hover:bg-green-800 sm:w-auto">Start your request <ArrowRight size={15} /></a>
      </div>
    </section>
  </main>
  <Footer />
  <MobileNav />
</MainLayout>
