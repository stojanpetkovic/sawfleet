---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { supabase } from "../lib/supabase";

// 1. Učitavamo dinamičke podatke iz baze
const { data: territories } = await supabase
  .from('service_territories')
  .select('*')
  .order('name', { ascending: true });

// Helper mapa za koordinate - sve 15 teritorija
const coordsMap: Record<string, [number, number]> = {
  "Broward County": [26.1224, -80.1373],
  "City of Boca Raton": [26.3583, -80.0833],
  "City of Coral Gables": [25.7459, -80.2732],
  "City of Doral": [25.8158, -80.3437],
  "City of Fort Lauderdale": [26.1223, -80.1434],
  "City of Hallandale Beach": [26.0176, -80.1456],
  "City of Miami": [25.7617, -80.1918],
  "City of Miami Gardens": [25.9500, -80.2000],
  "City of Naples": [26.1406, -81.7934],
  "City of Oakland Park": [26.1667, -80.1167],
  "Collier County": [26.2000, -81.5000],
  "Miami-Dade County": [25.7617, -80.1918],
  "Palm Beach County": [26.7153, -80.0534],
  "Town of Jupiter": [26.9483, -80.0534],
  "Village of Wellington": [26.6228, -80.2347]
};
---

<MainLayout title="South Florida Service Areas | SF Tree Removal" description={`View ${territories?.length || 0} active tree-service territories currently available through SF Tree Removal.`}>
  <Header />

  <!-- Učitavanje Leaflet CSS-a -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <main class="relative pt-32 pb-16 bg-white min-h-screen overflow-hidden">
    
    <!-- Glow u pozadini (Gornji deo) -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-[400px] bg-green-500/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="relative z-10 mx-auto max-w-[1320px] px-4 sm:px-8">
      
      <!-- Header sekcija -->
      <div class="mb-12 max-w-2xl font-sans">
        
        <!-- Premium Minimal Badge -->
        <div class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-slate-200 px-3 py-1.5 shadow-sm mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-700">
          Live coverage data
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[4rem] font-bold text-slate-900 tracking-tighter leading-[1.05]">
          Active service areas across South Florida.
        </h1>
        <p class="mt-6 text-sm sm:text-base leading-relaxed text-slate-600">
          The {territories?.length || 0} locations below come directly from the platform's active territory settings. Submit a request to confirm routing for your property and project type.
        </p>
      </div>

      <div class="font-sans">
        <!-- Mapa je glavni element strane -->
        <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-2 shadow-soft-lg sm:rounded-3xl sm:p-3">
          <div id="map" class="h-[430px] w-full overflow-hidden rounded-xl bg-slate-100 sm:h-[520px] lg:h-[610px]"></div>
          <div class="pointer-events-none absolute bottom-5 left-5 z-[500] hidden items-center gap-3 rounded-full border border-slate-200 bg-white/95 px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-600 shadow-soft backdrop-blur sm:flex">
            <span class="relative flex h-5 w-5 items-center justify-center rounded-full border border-green-500/40 bg-green-500/15">
              <span class="h-2.5 w-2.5 rounded-full border-2 border-white bg-green-600 shadow-[0_0_0_1px_rgba(22,163,74,0.25)]"></span>
            </span>
            Active coverage area
          </div>
        </div>

        <!-- Kompaktna lista ne utiče na visinu mape -->
        <div class="mt-8">
          <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
            <div>
              <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-700">// Territory directory</span>
              <h2 class="mt-2 text-xl font-bold tracking-tight text-slate-950">All active locations</h2>
            </div>
            <p class="text-xs text-slate-500">{territories?.length || 0} territories currently configured</p>
          </div>
          <div class="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {territories?.map((t, index) => (
              <div class="group flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 transition hover:border-green-200 hover:bg-green-50">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-white font-mono text-[9px] font-bold text-slate-400 shadow-sm group-hover:text-green-700">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="min-w-0 text-xs font-bold leading-5 text-slate-800">{t.name}</h3>
              </div>
            ))}
          </div>
          {(!territories || territories.length === 0) && (
            <div class="mt-5 rounded-2xl border border-dashed border-slate-300 p-8 text-center">
              <p class="text-xs font-bold uppercase tracking-widest text-slate-500">No territories defined</p>
            </div>
          )}
        </div>
      </div>
    </div>
    <div class="relative z-10 mx-auto mt-12 max-w-[1320px] px-4 sm:px-8">
      <div class="grid gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-6 md:grid-cols-[1fr_auto] md:items-center md:p-8">
        <div><h2 class="text-xl font-bold text-slate-950">Have a project in one of these areas?</h2><p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Send the property location and scope once. The request will enter the dispatch workflow for contractors configured to serve that territory.</p></div>
        <a href="/#quote" class="inline-flex h-12 items-center justify-center rounded-xl bg-green-700 px-6 text-xs font-bold uppercase tracking-[0.15em] text-white hover:bg-green-800">Request an estimate →</a>
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>

<!-- Leaflet JS -->
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script is:inline define:vars={{ territories, coordsMap }}>
  window.addEventListener('load', () => {
    if (typeof L !== 'undefined') {
      const map = L.map('map', { zoomControl: false, scrollWheelZoom: false }).setView([26.3, -80.4], 8);
      L.control.zoom({ position: 'topright' }).addTo(map);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO',
        maxZoom: 19
      }).addTo(map);

      const points = [];
      (territories || []).forEach(t => {
        const pos = coordsMap[t.name] || [26.3, -80.4];
        points.push(pos);
        const isCounty = t.name.includes('County');
        const isTownOrVillage = t.name.startsWith('Town of') || t.name.startsWith('Village of');
        const coverageRadius = isCounty ? 28000 : isTownOrVillage ? 15000 : 12000;

        L.circle(pos, {
          radius: coverageRadius,
          color: '#16a34a',
          fillColor: '#22c55e',
          fillOpacity: 0.09,
          opacity: 0.38,
          weight: 1
        }).addTo(map);

        const popup = document.createElement('div');
        popup.className = 'service-area-popup';
        const label = document.createElement('strong');
        label.textContent = t.name;
        popup.appendChild(label);

        L.circleMarker(pos, {
          radius: 7,
          color: '#ffffff',
          fillColor: '#16a34a',
          fillOpacity: 1,
          weight: 3
        }).addTo(map).bindPopup(popup);
      });

      if (points.length > 1) {
        map.fitBounds(points, { padding: [48, 48], maxZoom: 9 });
      } else if (points.length === 1) {
        map.setView(points[0], 10);
      }
    }
  });
</script>

<style>
  #map { 
    filter: saturate(0.85) contrast(1.02);
  }
  :global(.leaflet-popup-content-wrapper) {
    background-color: #fff !important;
    color: #0f172a !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 10px !important;
    box-shadow: 0 12px 32px -12px rgba(15, 23, 42, .28) !important;
  }
  :global(.leaflet-popup-tip) {
    background-color: #fff !important;
  }
  :global(.service-area-popup) {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    padding: 2px 1px;
  }
  :global(.leaflet-control-zoom a) {
    color: #334155 !important;
    border-color: #e2e8f0 !important;
  }
</style>
