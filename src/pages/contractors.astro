---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
import Footer from "../components/layout/Footer.astro";
import MobileNav from "../components/layout/MobileNav.astro";
import Header from "../components/layout/Header.astro";
import { supabase } from "../lib/supabase";
import { directoryLocationUrl, directoryProfileUrl } from "../lib/directory";
import { ArrowLeft, ArrowRight, Database, Eye, MapPin, Ruler, Search, Star, Truck } from "lucide-astro";

const { data: profiles } = await supabase
  .from("unclaimed_truck_directory")
  .select("slug,company_name,contact_name,equipment_name,manufacturer,model,lift_capacity_tons,working_height_ft,location_city,location_state,service_radius_miles,storm_radius_miles,access_notes,availability_notes,rate_notes,insurance_claim,operator_experience,description,listing_type,profile_status,verification_status,source_payload")
  .eq("is_published", true)
  .neq("profile_status", "hidden")
  .order("location_state")
  .order("company_name");

const profileCount = profiles?.length || 0;
const stateCount = new Set((profiles || []).map((profile: any) => profile.location_state).filter(Boolean)).size;
const states = [...new Set((profiles || []).map((profile: any) => profile.location_state).filter(Boolean))].sort();
---

<MainLayout title="Tree Service Contractor Directory | SF Tree Removal" description="A public directory of tree-service and equipment operators, compiled from publicly available business information.">
  <Header />
  <main class="min-h-screen bg-slate-950 pb-24">

    <!-- ============================================== -->
    <!-- HERO -->
    <!-- ============================================== -->
    <section class="relative overflow-hidden border-b border-white/10 px-5 pt-28 pb-14 text-white md:px-8 md:pt-36 lg:pb-20">
      <!-- Blueprint grid tekstura — drugačija od dot-grid (index) i hatch (permit-leads) -->
      <div class="pointer-events-none absolute inset-0 opacity-[0.5]" aria-hidden="true" style="background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 34px 34px;"></div>
      <div class="pointer-events-none absolute left-1/2 -top-40 h-[28rem] w-[28rem] -translate-x-1/2 rounded-full bg-green-500/[0.12] blur-[120px]" aria-hidden="true"></div>

      <!-- Decorativni "ghost" ikonice u pozadini -->
      <Truck size={190} strokeWidth={0.8} class="pointer-events-none absolute -right-6 top-10 hidden -rotate-12 text-white/[0.05] lg:block" aria-hidden="true" />
      <Ruler size={120} strokeWidth={0.8} class="pointer-events-none absolute right-72 top-0 hidden rotate-6 text-white/[0.05] lg:block" aria-hidden="true" />

      <div class="relative z-10 mx-auto w-full max-w-7xl">
        <span class="text-[10px] font-mono font-bold uppercase tracking-[0.22em] text-green-400">// Public contractor directory</span>
        <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl">Tree service & equipment operators.</h1>
        <p class="mt-5 max-w-2xl text-sm leading-7 text-slate-400 md:text-base">
          A directory of tree-service contractors and equipment operators, compiled from publicly available business information. Listings are not verified and have not been claimed by the businesses shown — confirm specifications, availability and credentials directly before relying on them.
        </p>

        <!-- Trust row: dekorativno, bez konkretnih brojeva -->
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 backdrop-blur">
            <Eye size={14} class="text-green-300" strokeWidth={1.8} />
            <span class="text-[11px] font-bold text-slate-300">Visited daily by tree care businesses</span>
          </div>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 backdrop-blur">
            <div class="flex gap-0.5 text-amber-400">
              {Array.from({ length: 5 }).map(() => <Star size={12} fill="currentColor" strokeWidth={0} />)}
            </div>
            <span class="text-[11px] font-bold text-slate-300">Trusted public-records source</span>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-2 font-mono text-[11px] text-slate-400">
          <span class="rounded-full border border-white/10 bg-white/[0.04] px-4 py-2">{profileCount} <span class="text-slate-500">equipment_profiles</span></span>
          <span class="rounded-full border border-white/10 bg-white/[0.04] px-4 py-2">{stateCount} <span class="text-slate-500">states_covered</span></span>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- BROWSE DIRECTORY -->
    <!-- ============================================== -->
    <section class="relative px-5 py-10 md:px-8">
      <div class="relative z-10 mx-auto w-full max-w-7xl">

        <div class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <Database size={16} class="mt-0.5 shrink-0 text-slate-500" />
          <p class="text-xs leading-5 text-slate-400">Every profile here is <strong class="text-slate-200">unclaimed and unverified</strong> — sourced from public business listings, not submitted by the operator. Treat specs, availability and insurance claims as a starting point, not a guarantee.</p>
        </div>

        <div class="mt-6 flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-3 sm:flex-row">
          <label class="relative flex-1"><span class="sr-only">Search directory</span><Search size={16} class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-500" /><input id="directorySearch" type="search" placeholder="Search company, equipment or city…" class="h-12 w-full rounded-xl border border-white/10 bg-white/[0.04] pl-11 pr-4 text-sm text-white outline-none transition placeholder:text-slate-500 focus:border-green-400/40 focus:ring-4 focus:ring-green-400/10" /></label>
          <select id="stateFilter" aria-label="Filter by state" class="h-12 w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 text-xs font-bold uppercase tracking-wider text-slate-300 outline-none focus:border-green-400/40 sm:w-48">
            <option value="" class="bg-slate-900">All states</option>
            {states.map((state) => <option value={state} class="bg-slate-900">{state}</option>)}
          </select>
        </div>

        <div id="directoryGrid" class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
          {(profiles || []).map((profile: any) => (
            <article class="directory-card group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] p-5 backdrop-blur transition-all hover:-translate-y-0.5 hover:border-green-400/40 hover:bg-white/[0.06]" data-search={`${profile.company_name} ${profile.equipment_name} ${profile.location_city} ${profile.location_state}`.toLowerCase()} data-state={profile.location_state || ""}>
              <div class="flex flex-col items-start justify-between gap-3 min-[420px]:flex-row">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/[0.06] text-white"><Truck size={20} /></span>
                <span class="rounded-full border border-amber-400/25 bg-amber-400/10 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wider text-amber-300">Unclaimed · Unverified</span>
              </div>
              <h3 class="mt-5 text-lg font-bold text-white"><a href={directoryProfileUrl(profile)} class="transition group-hover:text-green-300">{profile.company_name}</a></h3>
              <p class="mt-1 text-sm font-medium text-green-400"><a href={directoryProfileUrl(profile)}>{profile.equipment_name}</a></p>
              <div class="mt-4 flex flex-wrap gap-2 text-[10px] text-slate-400">
                {(profile.location_city || profile.location_state) && <a href={directoryLocationUrl(profile)} class="inline-flex items-center gap-1.5 rounded-full bg-white/[0.06] px-2.5 py-1.5 hover:bg-green-400/10 hover:text-green-300"><MapPin size={12} /> {[profile.location_city, profile.location_state].filter(Boolean).join(", ")}</a>}
                {profile.lift_capacity_tons && <span class="rounded-full bg-white/[0.06] px-2.5 py-1.5">{profile.lift_capacity_tons} ton</span>}
                {profile.working_height_ft && <span class="inline-flex items-center gap-1.5 rounded-full bg-white/[0.06] px-2.5 py-1.5"><Ruler size={12} /> {profile.working_height_ft} ft</span>}
              </div>
              <dl class="mt-5 space-y-2 border-t border-white/10 pt-4 font-mono text-xs">
                {profile.service_radius_miles && <div class="flex justify-between gap-4"><dt class="text-slate-500">service_radius</dt><dd class="font-medium text-slate-300">{profile.service_radius_miles} mi</dd></div>}
                {profile.storm_radius_miles && <div class="flex justify-between gap-4"><dt class="text-slate-500">storm_radius</dt><dd class="font-medium text-slate-300">{profile.storm_radius_miles} mi</dd></div>}
                {profile.insurance_claim && <div class="flex justify-between gap-4"><dt class="text-slate-500">insurance</dt><dd class="font-medium text-slate-300">{profile.insurance_claim} (unverified)</dd></div>}
              </dl>
              {(profile.description || profile.availability_notes || profile.access_notes) && <p class="mt-4 line-clamp-3 text-xs leading-5 text-slate-500">{profile.description || profile.availability_notes || profile.access_notes}</p>}
              <div class="mt-auto pt-5">
                <a href={directoryProfileUrl(profile)} class="flex h-11 items-center justify-center rounded-xl border border-white/10 px-3 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-300 hover:border-green-400/40 hover:text-green-300">View details</a>
              </div>
            </article>
          ))}
        </div>
        <div id="emptyDirectory" class="hidden mt-6 rounded-2xl border border-dashed border-white/15 bg-white/[0.02] p-10 text-center text-sm text-slate-500">No matching equipment profiles.</div>
        <nav id="directoryPagination" class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row" aria-label="Contractor directory pagination">
          <p id="directoryResults" class="font-mono text-xs text-slate-500" aria-live="polite"></p>
          <div class="no-scrollbar flex w-full items-center gap-2 overflow-x-auto pb-1 sm:w-auto">
            <button id="previousPage" type="button" class="inline-flex h-10 items-center justify-center gap-1.5 rounded-xl border border-white/10 bg-white/[0.03] px-3 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400 transition hover:border-green-400/30 hover:text-green-300 disabled:cursor-not-allowed disabled:opacity-40"><ArrowLeft size={14} /> Previous</button>
            <div id="pageNumbers" class="flex items-center gap-1"></div>
            <button id="nextPage" type="button" class="inline-flex h-10 items-center justify-center gap-1.5 rounded-xl border border-white/10 bg-white/[0.03] px-3 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400 transition hover:border-green-400/30 hover:text-green-300 disabled:cursor-not-allowed disabled:opacity-40">Next <ArrowRight size={14} /></button>
          </div>
        </nav>
      </div>
    </section>

  </main>
  <Footer />
  <MobileNav />
</MainLayout>

<script>
  const search = document.getElementById("directorySearch") as HTMLInputElement;
  const state = document.getElementById("stateFilter") as HTMLSelectElement;
  const cards = Array.from(document.querySelectorAll(".directory-card")) as HTMLElement[];
  const previous = document.getElementById("previousPage") as HTMLButtonElement;
  const next = document.getElementById("nextPage") as HTMLButtonElement;
  const pageNumbers = document.getElementById("pageNumbers") as HTMLElement;
  const results = document.getElementById("directoryResults") as HTMLElement;
  const pagination = document.getElementById("directoryPagination") as HTMLElement;
  const pageSize = 18;
  let currentPage = 1;

  const visiblePageNumbers = (page: number, total: number) => {
    if (total <= 5) return Array.from({ length: total }, (_, index) => index + 1);
    const values = new Set([1, total, page - 1, page, page + 1]);
    return [...values].filter((value) => value > 0 && value <= total).sort((a, b) => a - b);
  };

  const render = (resetPage = false) => {
    if (resetPage) currentPage = 1;
    const query = search.value.trim().toLowerCase();
    const matchingCards = cards.filter((card) =>
      (!query || (card.dataset.search || "").includes(query)) &&
      (!state.value || card.dataset.state === state.value)
    );
    const pageCount = Math.max(1, Math.ceil(matchingCards.length / pageSize));
    currentPage = Math.min(currentPage, pageCount);
    const firstIndex = (currentPage - 1) * pageSize;
    const pageCards = new Set(matchingCards.slice(firstIndex, firstIndex + pageSize));

    cards.forEach((card) => {
      card.classList.toggle("hidden", !pageCards.has(card));
    });

    const hasResults = matchingCards.length > 0;
    document.getElementById("emptyDirectory")?.classList.toggle("hidden", hasResults);
    pagination.classList.toggle("hidden", !hasResults);
    previous.disabled = currentPage === 1;
    next.disabled = currentPage === pageCount;
    const firstResult = hasResults ? firstIndex + 1 : 0;
    const lastResult = Math.min(firstIndex + pageSize, matchingCards.length);
    results.textContent = `Showing ${firstResult}–${lastResult} of ${matchingCards.length} profiles`;

    const pageValues = visiblePageNumbers(currentPage, pageCount);
    pageNumbers.innerHTML = "";
    pageValues.forEach((page, index) => {
      if (index > 0 && page - pageValues[index - 1] > 1) {
        const ellipsis = document.createElement("span");
        ellipsis.className = "px-1 text-xs text-slate-500";
        ellipsis.textContent = "…";
        pageNumbers.appendChild(ellipsis);
      }
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = String(page);
      button.setAttribute("aria-label", `Go to page ${page}`);
      if (page === currentPage) button.setAttribute("aria-current", "page");
      button.className = page === currentPage
        ? "h-10 min-w-10 rounded-xl bg-green-500 px-3 text-xs font-bold text-slate-950"
        : "h-10 min-w-10 rounded-xl border border-white/10 bg-white/[0.03] px-3 text-xs font-bold text-slate-400 hover:border-green-400/30 hover:text-green-300";
      button.addEventListener("click", () => {
        currentPage = page;
        render();
        document.getElementById("directoryGrid")?.scrollIntoView({ behavior: "smooth" });
      });
      pageNumbers.appendChild(button);
    });
  };

  search?.addEventListener("input", () => render(true));
  state?.addEventListener("change", () => render(true));
  previous?.addEventListener("click", () => {
    if (currentPage > 1) {
      currentPage--;
      render();
      document.getElementById("directoryGrid")?.scrollIntoView({ behavior: "smooth" });
    }
  });
  next?.addEventListener("click", () => {
    currentPage++;
    render();
    document.getElementById("directoryGrid")?.scrollIntoView({ behavior: "smooth" });
  });
  render();
</script>
