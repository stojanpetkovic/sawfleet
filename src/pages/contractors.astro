---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import MobileNav from "../components/layout/MobileNav.astro";
import Footer from "../components/layout/Footer.astro";
import { supabase } from "../lib/supabase";
import { supabaseAdmin } from "../lib/supabaseAdmin";
import { BadgeCheck, MapPin, ChevronRight, Users } from "lucide-astro";

// Koristimo supabaseAdmin da zaobiđemo RLS (javna stranica, čita samo is_public=true)
const db = supabaseAdmin ?? supabase;

// Dohvati sve aktivne kontraktore (filtriramo is_public u JS zbog backward compat)
const { data: contractors } = await db
  .from("contractors")
  .select("id, company_name, territory, bio, services_offered, slug, is_public")
  .eq("status", "active")
  .order("company_name", { ascending: true });

// Prikaži samo one koji imaju slug i nije eksplicitno is_public = false
const list = (contractors || []).filter(
  (c: any) => c.slug && c.is_public !== false
);

// Dohvati agregatne ocene — view možda još ne postoji pre migracije
type StatRow = { contractor_id: string; avg_rating: number; review_count: number };
const statsMap = new Map<string, StatRow>();
try {
  const { data: statsRaw } = await db
    .from("contractor_review_stats")
    .select("contractor_id, review_count, avg_rating");
  for (const s of statsRaw || []) {
    statsMap.set((s as any).contractor_id, s as StatRow);
  }
} catch { /* view ne postoji još */ }

const title = "Find a Tree Service Contractor | SF Tree Removal";
const description = `Browse ${list.length} verified tree service contractors in South Florida. Compare ratings, read customer reviews, and request a free quote.`;
---

<MainLayout title={title} description={description}>
  <Header />
  <MobileNav />

  <main class="min-h-screen bg-slate-50 pb-24 pt-28 md:pt-36">
    <div class="mx-auto w-full max-w-6xl px-5 md:px-8">

      <!-- Header -->
      <div class="mb-10">
        <div class="flex items-center gap-2 mb-3">
          <Users size={15} class="text-green-700" />
          <span class="text-[10px] font-mono font-bold uppercase tracking-[0.22em] text-green-700">Verified network</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-950">
          Tree Service Contractors<br class="hidden sm:block" /> in South Florida
        </h1>
        <p class="mt-3 max-w-xl text-sm text-slate-500 leading-relaxed">
          All contractors are verified and active in our dispatch network. Request a free quote and we'll connect you with the right team.
        </p>
      </div>

      <!-- Grid -->
      {list.length === 0 ? (
        <div class="rounded-3xl border border-dashed border-slate-200 p-16 text-center text-slate-400">
          No public contractor profiles yet.
        </div>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {list.map((c: any) => {
            const stats = statsMap.get(c.id) as { avg_rating: number; review_count: number } | undefined;
            const avgRating = stats ? Number(stats.avg_rating) : 0;
            const reviewCount = stats ? Number(stats.review_count) : 0;
            const services: string[] = c.services_offered || [];

            return (
              <a
                href={`/contractors/${c.slug}`}
                class="group flex flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm hover:border-green-300 hover:shadow-md hover:-translate-y-0.5 transition-all"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="flex-1 min-w-0">
                    <p class="text-[9px] font-bold uppercase tracking-[0.2em] text-green-700 flex items-center gap-1">
                      <BadgeCheck size={11} /> Verified
                    </p>
                    <h2 class="mt-1 text-base font-bold text-slate-950 truncate group-hover:text-green-700 transition-colors">
                      {c.company_name}
                    </h2>
                  </div>
                </div>

                {c.territory && (
                  <p class="mt-2 flex items-center gap-1.5 text-xs text-slate-400">
                    <MapPin size={12} />
                    {c.territory}
                  </p>
                )}

                {reviewCount > 0 && (
                  <div class="mt-3 flex items-center gap-1.5">
                    <div class="flex items-center gap-0.5 text-sm">
                      {Array.from({ length: 5 }, (_, i) => (
                        <span class={i < Math.round(avgRating) ? "text-amber-400" : "text-slate-200"}>★</span>
                      ))}
                    </div>
                    <span class="text-xs font-bold text-slate-700">{avgRating.toFixed(1)}</span>
                    <span class="text-xs text-slate-400">({reviewCount})</span>
                  </div>
                )}

                {c.bio && (
                  <p class="mt-3 text-xs leading-5 text-slate-500 line-clamp-2">{c.bio}</p>
                )}

                {services.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {services.slice(0, 3).map((s: string) => (
                      <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide text-slate-500">{s}</span>
                    ))}
                    {services.length > 3 && (
                      <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide text-slate-400">+{services.length - 3}</span>
                    )}
                  </div>
                )}

                <div class="mt-auto pt-4 flex items-center justify-between border-t border-slate-100 text-[10px] font-bold uppercase tracking-wider text-green-700 group-hover:text-green-600">
                  View profile
                  <ChevronRight size={13} />
                </div>
              </a>
            );
          })}
        </div>
      )}

      <!-- CTA -->
      <div class="mt-16 rounded-3xl bg-slate-900 px-8 py-10 text-center">
        <p class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-400">// Get matched instantly</p>
        <h2 class="mt-3 text-2xl font-bold text-white">Not sure who to hire?</h2>
        <p class="mt-2 text-sm text-slate-400 max-w-md mx-auto">Submit a quick request and we'll match you with the right contractor for your location and project type.</p>
        <a href="/#request" class="mt-6 inline-flex h-12 items-center justify-center rounded-xl bg-green-500 px-8 text-sm font-bold text-white hover:bg-green-400 transition-all">
          Get a free quote →
        </a>
      </div>

    </div>
  </main>

  <Footer />
</MainLayout>
