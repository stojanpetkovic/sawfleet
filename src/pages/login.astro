---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Login | SF Tree Removal" noindex>
  <div class="relative min-h-screen flex items-center justify-center bg-white p-4 overflow-hidden">
    <!-- Background gradient -->
    <div class="absolute inset-0 z-0">
      <div class="absolute top-[-20%] left-[-10%] w-[500px] h-[500px] bg-green-500/5 blur-[120px] rounded-full"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[400px] h-[400px] bg-blue-500/5 blur-[100px] rounded-full"></div>
    </div>

    <!-- Login container -->
    <div class="relative z-10 w-full max-w-[400px]">
      <div class="mb-8 text-center">
        <span class="text-[10px] font-mono font-bold uppercase tracking-[0.3em] text-green-700">// System Access</span>
        <h1 class="mt-4 text-3xl font-bold text-slate-900 tracking-tighter">SF Tree Removal Portal</h1>
        <p class="mt-2 text-sm text-zinc-500">One sign-in for contractors and fleet owners.</p>
      </div>

      <div id="verifyBanner" class="hidden mb-4 rounded-2xl border p-4 text-sm"></div>

      <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-soft-lg">
        <form id="loginForm" class="space-y-5">
          <div>
            <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-600">Email Address</label>
            <input type="email" name="email" required placeholder="you@company.com" class="h-12 w-full rounded-xl border border-slate-300 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 transition-all placeholder:text-slate-400"/>
          </div>
          <div>
            <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-600">Password</label>
            <input type="password" name="password" required placeholder="••••••••" class="h-12 w-full rounded-xl border border-slate-300 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 transition-all placeholder:text-slate-400"/>
          </div>
          <button type="submit" id="submitBtn" class="flex h-12 w-full items-center justify-center rounded-xl bg-green-500 text-sm font-bold text-slate-50 transition-all hover:bg-green-400 active:scale-[0.98]">
            Sign In →
          </button>
          <button type="button" id="forgotBtn" class="w-full text-center text-[11px] text-zinc-500 hover:text-zinc-700 transition-colors pt-1">
            Forgot password?
          </button>
        </form>

        <div class="mt-6 pt-6 border-t border-zinc-100">
          <p class="text-center text-[9px] uppercase tracking-widest text-zinc-400 mb-3">Or sign in with</p>
          <button type="button" id="googleLoginBtn" class="flex h-11 w-full items-center justify-center gap-2 rounded-xl border border-zinc-200 bg-white text-sm font-bold text-slate-900 transition-all hover:bg-zinc-50">
            <svg class="w-5 h-5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Google
          </button>
        </div>
      </div>

      <p class="mt-6 text-center text-xs text-zinc-500">
        Don't have an account? <a href="/contractors-registration" class="text-green-700 hover:text-green-700 font-bold">Register as contractor</a> · <a href="/truck-registration" class="text-green-700 hover:text-green-700 font-bold">Register fleet</a>
      </p>

      <div class="mt-4 flex items-center justify-center gap-4 text-[10px] font-mono uppercase tracking-widest text-zinc-400">
        <a href="/my-account" class="hover:text-zinc-700">Customer tracking</a>
        <span>·</span>
        <a href="/admin/login" class="hover:text-zinc-700">Staff login</a>
      </div>

      <p class="mt-8 text-center text-[10px] text-zinc-400 font-mono tracking-widest uppercase">
        &copy; {new Date().getFullYear()} SF Tree Removal
      </p>
    </div>
  </div>
</MainLayout>

<script>
  import { supabase } from "../lib/supabase";
  import { getAuthRedirectUrl } from "../lib/authRedirect";
  import { hasOAuthHash } from "../lib/oauthCallback";

  const form = document.getElementById('loginForm') as HTMLFormElement;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement;

  // -- "check your email" / "you're all set" banner from /api/verify-signup --
  const verifyStatus = new URLSearchParams(window.location.search).get('verify');
  if (verifyStatus) {
    const banner = document.getElementById('verifyBanner')!;
    const copy: Record<string, { text: string; tone: 'success' | 'error' }> = {
      success: { text: '✅ Email confirmed — your application is now waiting on admin review. You can sign in once approved.', tone: 'success' },
      invalid: { text: '⚠️ That confirmation link is invalid. If you already applied, try registering again.', tone: 'error' },
      expired: { text: '⚠️ That confirmation link expired. Please register again to get a new one.', tone: 'error' },
      error: { text: '⚠️ Something went wrong confirming your email. Please contact the administrator.', tone: 'error' },
    };
    const entry = copy[verifyStatus];
    if (entry) {
      banner.textContent = entry.text;
      banner.className = `mb-4 rounded-2xl border p-4 text-sm ${entry.tone === 'success' ? 'border-green-200 bg-green-50 text-green-800' : 'border-amber-200 bg-amber-50 text-amber-800'}`;
    }
  }

  // Tries each known role in turn and redirects to the matching dashboard.
  // Returns false if the signed-in account isn't linked to any role here
  // (e.g. it's a customer or staff account, or not approved yet).
  async function resolveRoleAndRedirect(): Promise<boolean> {
    // link_contractor_account returns a single `contractors` row type, not
    // SETOF — on no match it comes back as a non-null object with every
    // field null (Postgres composite-type semantics), so we must check a
    // real column, not the object itself, or every non-contractor account
    // (e.g. every truck owner) would false-positive here.
    const { data: contractor } = await supabase.rpc('link_contractor_account');
    if (contractor?.id) {
      window.location.assign('/dashboard');
      return true;
    }
    const { data: trucks } = await supabase.rpc('link_truck_owner_account');
    if (trucks && trucks.length > 0) {
      window.location.assign('/truck-dashboard');
      return true;
    }
    return false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    btn.innerText = "Authenticating...";
    btn.disabled = true;
    btn.classList.add('opacity-70');

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      alert("Authentication failed: " + error.message);
      btn.innerText = "Sign In →";
      btn.disabled = false;
      btn.classList.remove('opacity-70');
      return;
    }

    const matched = await resolveRoleAndRedirect();
    if (!matched) {
      alert("This account isn't registered as a contractor or fleet owner. Customers can track requests at /my-account; staff should use /admin/login.");
      await supabase.auth.signOut();
      btn.innerText = "Sign In →";
      btn.disabled = false;
      btn.classList.remove('opacity-70');
    }
  });

  document.getElementById('forgotBtn')?.addEventListener('click', async () => {
    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value;
    if (!email) {
      alert('Enter your email in the field above first, then click again.');
      return;
    }
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: getAuthRedirectUrl('/reset-password'),
    });
    if (error) {
      alert('Error: ' + error.message);
    } else {
      alert('We sent you an email with a password reset link (check your spam folder too).');
    }
  });

  document.getElementById('googleLoginBtn')?.addEventListener('click', async () => {
    const googleBtn = document.getElementById('googleLoginBtn') as HTMLButtonElement;
    googleBtn.disabled = true;
    googleBtn.innerText = 'Signing in...';

    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo: getAuthRedirectUrl('/login?oauth_callback=true'),
      },
    });

    if (error) {
      alert('OAuth error: ' + error.message);
      googleBtn.disabled = false;
      googleBtn.innerText = 'Google';
    }
  });

  // Check if this is an OAuth callback and route to the right dashboard.
  if (new URLSearchParams(window.location.search).has('oauth_callback') || hasOAuthHash(window.location.hash)) {
    (async () => {
      await new Promise(resolve => setTimeout(resolve, 700));
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;
      const cleanUrl = new URL(window.location.href);
      cleanUrl.hash = '';
      window.history.replaceState({}, '', cleanUrl.toString());

      const matched = await resolveRoleAndRedirect();
      if (!matched) {
        await supabase.auth.signOut();
        alert("This account isn't registered as a contractor or fleet owner. Customers can track requests at /my-account; staff should use /admin/login.");
      }
    })();
  }
</script>
