---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const city = "Miami";
const county = "Miami-Dade County";
const state = "FL";
const phone = "+1-888-452-1505";

const title = `Tree Removal Services in ${city}, ${state} | Emergency & Licensed Pros`;
const description =
  `Professional tree removal services in ${city}, ${state}. Emergency tree removal, storm damage cleanup, and certified arborist services serving ${county} and surrounding South Florida areas.`;

const canonical = "https://sftreeremoval.com/areas/miami-tree-removal/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
>

<!-- =========================================================
  LOCAL BUSINESS SCHEMA – MIAMI
========================================================= -->
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${canonical}#localbusiness`,
  "name": `SF Tree Removal – ${city}`,
  "url": canonical,
  "telephone": phone,
  "priceRange": "$$",
  "image": "https://sftreeremoval.com/images/og-default.jpg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city,
    "addressRegion": state,
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": city },
    { "@type": "AdministrativeArea", "name": county }
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
    ],
    "opens": "00:00",
    "closes": "23:59"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Tree Removal Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Tree Removal",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Emergency Tree Removal",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Certified Arborist Services",
          "areaServed": city
        }
      }
    ]
  }
})}
</script>

<!-- =========================================================
  BREADCRUMB SCHEMA
========================================================= -->
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sftreeremoval.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Service Areas",
      "item": "https://sftreeremoval.com/areas/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `${city} Tree Removal`,
      "item": canonical
    }
  ]
})}
</script>

<!-- =========================================================
  FAQ PAGE SCHEMA – MIAMI
========================================================= -->
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How much does tree removal cost in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Tree removal costs in ${city} depend on the tree size, location, condition, and complexity. Emergency situations, proximity to structures, and permit requirements may affect pricing. Free estimates are available.`
      }
    },
    {
      "@type": "Question",
      "name": `Do I need a permit to remove a tree in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Some trees in ${city} require permits for removal, especially protected species or large trees. Our team assists with permit verification and certified arborist reports when required.`
      }
    },
    {
      "@type": "Question",
      "name": `Do you offer emergency tree removal in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. We provide 24/7 emergency tree removal services throughout ${city} and ${county} for storm damage, fallen trees, and hazardous conditions.`
      }
    },
    {
      "@type": "Question",
      "name": `Is your tree removal company licensed and insured?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. Our tree removal company serving ${city} is fully licensed and insured to protect homeowners, businesses, and commercial properties.`
      }
    },
    {
      "@type": "Question",
      "name": `Can you remove trees near homes or power lines?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. We specialize in controlled tree removal near homes, roofs, and power lines using professional equipment such as cranes, lifts, and rigging systems.`
      }
    }
  ]
})}
</script>

