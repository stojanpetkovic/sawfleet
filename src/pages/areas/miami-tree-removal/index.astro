---

<CityPage
  city="Miami"
  county="Miami-Dade County"
  title="Tree Removal in Miami, FL | Free Local Estimates"
  description="Free tree removal estimates in Miami, FL: removal, storm cleanup, trimming and stump grinding from independent local pros in Miami-Dade."
  lead="Get a free tree removal estimate from independent local professionals in Miami and across Miami-Dade County."
  intro={intro}
  conditions={conditions}
  permitId="miami"
  nearby={nearby}
  faqs={faqs}
  image="hero-crane"
