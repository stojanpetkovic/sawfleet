---
import CityPage from "../../../components/CityPage.astro";

const intro = [
  "Miami is full of big, fast-growing trees: mature oaks and mahogany, ficus with aggressive roots, mango and avocado trees, and tall royal and coconut palms. Many of them stand a few feet from a house, pool or power line, so removing them safely takes planning.",
  "Send one request and we will try to match you with an independent tree care professional. We are adding professionals in Miami and cannot promise a response yet, so you can also tell us you want to be notified. SF Tree Removal is an online service; we don't do the work ourselves, so you agree the scope and price directly with the professional you are matched with."
];

const conditions = [
  {
    "name": "Hurricanes and tropical storms",
    "note": "Wind and rain loosen roots and snap limbs. Trees that were fine in May can be a risk by August, so many requests come in just before or after the season."
  },
  {
    "name": "Shallow, saturated soil",
    "note": "Miami-Dade sits on limestone with a high water table, so many trees have shallow roots and uproot easily in heavy rain."
  },
  {
    "name": "Ficus and other invasive roots",
    "note": "Ficus, Australian pine and Brazilian pepper are common in Miami yards. Their roots lift pavers, crack walls and clog pipes."
  },
  {
    "name": "Palms near pools and houses",
    "note": "Tall palms are everywhere. Dead fronds and coconuts fall on roofs, cars and pool decks, and lowering a crown near a pool takes care."
  }
];

const nearby = [
  {
    "name": "Fort Lauderdale",
    "href": "/areas/fort-lauderdale-tree-removal/"
  },
  {
    "name": "Miami-Dade County",
    "href": "/areas/miami-dade-county-tree-removal/"
  },
  {
    "name": "Hollywood",
    "href": "/areas/hollywood-tree-service/"
  }
];

const faqs = [
  {
    "q": "How much does tree removal cost in Miami?",
    "a": "It depends on the size of the tree, how close it is to the house, pool or power lines, and whether a crane is needed. A small tree in an open yard costs far less than a large oak over a roof. You will get a free estimate for your specific tree; see our <a href=\"/tree-care-guides/tree-removal-cost-south-florida/\">cost guide</a>."
  },
  {
    "q": "Do I need a permit to remove a tree in Miami?",
    "a": "Often yes. It depends on the city, the species and size of the tree, and whether it is dangerous. See our <a href=\"/tree-removal-permits/\">permit guide</a>, and confirm with your city."
  },
  {
    "q": "Can I get emergency help in Miami?",
    "a": "Choose Emergency Tree Removal in the <a href=\"/contact-us/\">form</a> and we flag the request as urgent for local professionals. We cannot promise an arrival time. If anyone is in danger, call 911."
  },
  {
    "q": "Who does the work?",
    "a": "An independent tree care professional who works in Miami-Dade. SF Tree Removal is an online service that passes your request on; we do not perform the work. Ask for proof of license and insurance before work starts."
  }
];

const notes = "<p>Miami sits on limestone bedrock with a high water table, so many trees have shallow root systems and uproot in saturated soil during tropical storms. That is why leaning trees and trees with lifted soil at the base deserve attention before the season.</p><p>Older neighborhoods have mature canopy, and newer ones have trees planted close to walls and pool enclosures. Many requests are about palms near pools, ficus roots against walls, and large shade trees over roofs. Prohibited species such as Australian pine and Brazilian pepper are also commonly removed.</p>";

const trees = [
  {
    "name": "Mahogany",
    "note": "Large shade tree with a broad canopy. Branch failure in storms is common, so structure and dead wood matter."
  },
  {
    "name": "Ficus",
    "note": "Fast-growing with aggressive roots that crowd walls, pipes and pools. A frequent reason for removal requests."
  },
  {
    "name": "Royal palm",
    "note": "Tall and straight, often next to pools and houses. Lowering the crown needs care near screens and pavers."
  },
  {
    "name": "Mango",
    "note": "Large fruit tree with heavy limbs that can fail in wind. Often needs thinning and fruit-drop cleanup."
  },
  {
    "name": "Royal poinciana",
    "note": "Spectacular in bloom but with weak, brittle wood that fails in storms."
  },
  {
    "name": "Australian pine",
    "note": "An invasive species that topples easily in storms and is commonly removed rather than kept."
  }
