---
import CityPage from "../../../components/CityPage.astro";

const intro = [
  "Wellington is a village known for its equestrian estates and large lots in western Palm Beach County. Mature mahogany, live oak and palms line properties and bridle paths, and invasive melaleuca grows in wet areas.",
  "Send one request and we will try to match you with an independent tree care professional. We are adding professionals in Wellington and cannot promise a response yet, so you can also tell us you want to be notified. SF Tree Removal is an online service; we don't do the work ourselves, so you agree the scope and price directly with the professional you are matched with."
];

const conditions = [
  {
    "name": "Large lots and estates",
    "note": "Big properties with many large trees need space, equipment and planning."
  },
  {
    "name": "Equestrian areas",
    "note": "Fences, barns and paddocks change how and where trees can fall."
  },
  {
    "name": "Drainage canals",
    "note": "Wet ground and canals mean shallow-rooted trees and limited access."
  },
  {
    "name": "Invasive species",
    "note": "Melaleuca and Australian pine are often removed rather than kept."
  }
];

const notes = "<p>Estate lots mean more room to work but also more trees at a time, long access routes and fences and barns to protect. Describe the property and the number of trees when you request an estimate.</p><p>Wellington is an incorporated village with its own code, and many neighborhoods have associations. Check the village's rules and your association before cutting.</p>";

const trees = [
  {
    "name": "Mahogany",
    "note": "Large shade tree with a broad canopy. Branch failure in storms is common, so structure and dead wood matter."
  },
  {
    "name": "Live oak",
    "note": "Wide, heavy limbs that often grow over roofs and driveways. Removal needs rigging so big pieces are lowered, not dropped."
  },
  {
    "name": "Royal palm",
    "note": "Tall and straight, often next to pools and houses. Lowering the crown needs care near screens and pavers."
  },
  {
    "name": "Melaleuca",
    "note": "An invasive wetland tree, brittle in wind, commonly removed on development sites."
  },
  {
    "name": "Australian pine",
    "note": "An invasive species that topples easily in storms and is commonly removed rather than kept."
  },
  {
    "name": "Black olive",
    "note": "A common street and yard tree whose roots lift sidewalks and whose fruit stains pavers."
  }
];

const nearby = [
  {
    "name": "West Palm Beach",
    "href": "/areas/west-palm-beach-tree-removal/"
  },
  {
    "name": "Boynton Beach",
    "href": "/areas/boynton-beach-tree-removal/"
  },
  {
    "name": "Palm Beach County",
    "href": "/areas/palm-beach-county-tree-removal/"
  }
];

const faqs = [
  {
    "q": "How much does tree removal cost in Wellington?",
    "a": "It depends on the size of the tree, how close it is to the house, pool or power lines, and whether a crane is needed. You will get a free estimate for your specific tree; see our <a href=\"/tree-care-guides/tree-removal-cost-south-florida/\">cost guide</a>."
  },
  {
    "q": "Do I need a permit to remove a tree in Wellington?",
    "a": "Often, but it depends on the tree, the property and the rules where you live. Use the <a href=\"/permit-checker/\">permit checker</a> for what Wellington and its county say, and confirm with the city."
  },
  {
    "q": "Can I get emergency tree help in Wellington?",
    "a": "Choose Emergency Tree Removal in the <a href=\"/contact-us/\">form</a>. The request is flagged as urgent for local professionals; we cannot promise an arrival time. If anyone is in danger, call 911."
  },
  {
    "q": "Who does the work?",
    "a": "An independent tree care professional in Palm Beach County. SF Tree Removal is an online service; we do not perform the work. Ask for proof of license and insurance first."
  }
];
---

<CityPage
  city="Wellington"
  county="Palm Beach County"
  title="Tree Removal in Wellington, FL | Free Estimates"
  description="Free tree removal estimates in Wellington, FL: removal, trimming, stump grinding and storm cleanup from independent local pros."
  lead="Get a free tree removal estimate from independent local professionals in Wellington and western Palm Beach County."
  intro={intro}
  conditions={conditions}
  permitId="other-palm-beach"
  nearby={nearby}
  faqs={faqs}
  image="canopy-climber"
  image2="uprooted-yard"
  image3="aerial-lift"
  notes={notes}
  trees={trees}
/>
