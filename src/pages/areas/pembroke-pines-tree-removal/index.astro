    "href": "/areas/broward-county-tree-removal/"
  }
];

const faqs = [
  {
    "q": "How much does tree removal cost in Pembroke Pines?",
    "a": "It depends on the tree's size, how close it is to the house or enclosure, and access. You will get a free estimate; see our <a href=\"/tree-care-guides/tree-removal-cost-south-florida/\">cost guide</a>."
