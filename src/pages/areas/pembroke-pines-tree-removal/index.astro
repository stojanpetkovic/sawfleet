---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const city = "Pembroke Pines";
const county = "Broward County";
const state = "FL";

const title = `${city} Tree Removal Services | SF Tree Removal`;
const description =
  `Professional tree removal services in ${city}, ${state}. Emergency tree removal, storm damage cleanup, and certified arborist services serving ${county} and surrounding South Florida areas.`;

const canonical = "https://sftreeremoval.com/areas/pembroke-pines-tree-removal/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
>

<!-- =========================================================
  LOCAL BUSINESS SCHEMA – PEMBROKE PINES
========================================================= -->
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${canonical}#localbusiness`,
  "name": `SF Tree Removal – ${city}`,
  "url": canonical,
  "priceRange": "$$",
  "image": "https://sftreeremoval.com/images/og-default.jpg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city,
    "addressRegion": state,
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": city },
    { "@type": "AdministrativeArea", "name": county }
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
    ],
    "opens": "00:00",
    "closes": "23:59"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Tree Removal Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Tree Removal",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Emergency Tree Removal",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Storm Damage Tree Cleanup",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Certified Arborist Services",
          "areaServed": city
        }
      }
    ]
  }
})}
</script>

<!-- =========================================================
  BREADCRUMB SCHEMA
========================================================= -->
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sftreeremoval.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Service Areas",
      "item": "https://sftreeremoval.com/areas/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `${city} Tree Removal`,
      "item": canonical
    }
  ]
})}
</script>

<!-- =========================================================
  FAQ PAGE SCHEMA – PEMBROKE PINES
========================================================= -->
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Do you offer tree removal services in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. We provide professional tree removal services throughout ${city}, including residential and commercial properties across ${county}.`
      }
    },
    {
      "@type": "Question",
      "name": `Is emergency tree removal available in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. Our crews provide 24/7 emergency tree removal in ${city} for fallen trees, storm damage, and hazardous situations.`
      }
    },
    {
      "@type": "Question",
      "name": `Do I need a permit for tree removal in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Some tree removals in ${city} require permits, especially for protected trees. We assist with permit verification and certified arborist reports when needed.`
      }
    },
    {
      "@type": "Question",
      "name": `Are your tree removal services licensed and insured?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. Our tree removal company serving ${city} is fully licensed and insured for your protection and peace of mind.`
      }
    }
  ]
})}
</script>
