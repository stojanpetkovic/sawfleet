const notes = "<p>Pembroke Pines is largely planned residential communities, many with homeowners' associations. Trees were planted close to houses, pools and screen enclosures, and as they mature, roots lift pavers and limbs reach roofs.</p><p>In such communities, an association may need to approve removal or replacement, so check its rules before you schedule work. Storm season brings requests for fallen limbs and uprooted trees in saturated lawns.</p>";

const trees = [
  {
    "name": "Ficus",
    "note": "Fast-growing with aggressive roots that crowd walls, pipes and pools. A frequent reason for removal requests."
  },
  {
    "name": "Black olive",
    "note": "A common street and yard tree whose roots lift sidewalks and whose fruit stains pavers."
