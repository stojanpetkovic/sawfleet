---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Service Areas | Tree Removal Services Across South Florida";
const description =
  "SF Tree Removal proudly serves Miami, Fort Lauderdale, Broward County, and surrounding South Florida communities with professional tree removal, emergency services, and certified arborist solutions.";
const canonical = "https://sftreeremoval.com/areas/";
---

<BaseLayout title={title} description={description} canonical={canonical}>

  <!-- ================= HERO ================= -->
  <section class="bg-teal-900 py-28 text-white">
    <div class="max-w-7xl mx-auto px-6 text-center">

      <span
        class="inline-block mb-6 px-4 py-1 text-xs font-bold tracking-widest
               border border-dashed border-white/60 rounded-full"
      >
        SERVICE AREAS
      </span>

      <h1 class="text-4xl md:text-5xl xl:text-6xl font-extrabold leading-tight">
        Tree Removal Services
        <br class="hidden sm:block" />
        Across South Florida
      </h1>

      <p class="mt-8 max-w-3xl mx-auto text-lg text-white/90">
        We provide professional tree removal, emergency response, and certified
        arborist services across major cities and counties in South Florida.
        Our local crews ensure fast response times and compliance with local
        regulations.
      </p>

    </div>
  </section>

  <!-- ================= INTRO ================= -->
  <section class="bg-white py-32">
    <div class="max-w-4xl mx-auto px-6 text-center">

      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-8">
        Local Tree Removal Experts Near You
      </h2>

      <p class="text-lg text-slate-600 leading-relaxed">
        SF Tree Removal operates throughout South Florida, serving homeowners,
        businesses, and property managers with safe, efficient, and insured tree
        services. From emergency tree removal to long-term arborist care, our
        teams understand local tree species, weather risks, and municipal
        requirements.
      </p>

    </div>
  </section>

  <!-- ================= SERVICE AREAS GRID ================= -->
  <section class="bg-[#f4f8f6] py-32">
    <div class="max-w-7xl mx-auto px-6">

      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-16 text-center">
        Cities & Counties We Serve
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">

        <!-- MIAMI -->
        <a
          href="/areas/miami-tree-removal/"
          class="group bg-white rounded-3xl p-10 transition hover:shadow-lg"
        >
          <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
            Miami
          </h3>
          <p class="text-slate-600 mb-6">
            Emergency tree removal, storm damage cleanup, and full-service tree
            care for residential and commercial properties.
          </p>
          <span class="inline-flex items-center gap-2 font-bold text-teal-700">
            Miami Tree Removal
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
          </span>
        </a>

        <!-- FORT LAUDERDALE -->
        <a
          href="/areas/fort-lauderdale-tree-removal/"
          class="group bg-white rounded-3xl p-10 transition hover:shadow-lg"
        >
          <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
            Fort Lauderdale
          </h3>
          <p class="text-slate-600 mb-6">
            Professional tree removal, permit guidance, and certified arborist
            services throughout Fort Lauderdale.
          </p>
          <span class="inline-flex items-center gap-2 font-bold text-teal-700">
            Fort Lauderdale Tree Removal
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
          </span>
        </a>

        <!-- HOLLYWOOD -->
        <a
          href="/areas/hollywood-tree-service/"
          class="group bg-white rounded-3xl p-10 transition hover:shadow-lg"
        >
          <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
            Hollywood
          </h3>
          <p class="text-slate-600 mb-6">
            Reliable tree service solutions for homes and businesses, including
            emergency response and scheduled maintenance.
          </p>
          <span class="inline-flex items-center gap-2 font-bold text-teal-700">
            Hollywood Tree Service
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
          </span>
        </a>

        <!-- PEMBROKE PINES -->
        <a
          href="/areas/pembroke-pines-tree-removal/"
          class="group bg-white rounded-3xl p-10 transition hover:shadow-lg"
        >
          <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
            Pembroke Pines
          </h3>
          <p class="text-slate-600 mb-6">
            Fast emergency tree removal and long-term tree care programs designed
            for local properties.
          </p>
          <span class="inline-flex items-center gap-2 font-bold text-teal-700">
            Pembroke Pines Tree Removal
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
          </span>
        </a>

        <!-- BOCA RATON -->
        <a
          href="/areas/boca-raton-tree-removal/"
          class="group bg-white rounded-3xl p-10 transition hover:shadow-lg"
        >
          <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
            Boca Raton
          </h3>
          <p class="text-slate-600 mb-6">
            High-end tree removal and certified arborist services for residential
            and commercial properties.
          </p>
          <span class="inline-flex items-center gap-2 font-bold text-teal-700">
            Boca Raton Tree Removal
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
          </span>
        </a>

        <!-- BROWARD COUNTY -->
        <a
          href="/areas/broward-county-tree-removal/"
          class="group bg-white rounded-3xl p-10 transition hover:shadow-lg"
        >
          <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
            Broward County
          </h3>
          <p class="text-slate-600 mb-6">
            County-wide coverage for emergency tree removal, storm response, and
            scheduled tree services.
          </p>
          <span class="inline-flex items-center gap-2 font-bold text-teal-700">
            Broward County Tree Removal
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
          </span>
        </a>

        <!-- PALM BEACH COUNTY -->
        <a
          href="/areas/palm-beach-county-tree-removal/"
          class="group bg-white rounded-3xl p-10 transition hover:shadow-lg"
        >
          <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
            Palm Beach County
          </h3>
          <p class="text-slate-600 mb-6">
            Tree removal, palm work and storm response from Boca Raton to Jupiter.
          </p>
          <span class="inline-flex items-center gap-2 font-semibold text-teal-700">
            Palm Beach County Tree Removal
            <span class="transition group-hover:translate-x-1">↗</span>
          </span>
        </a>

      </div>
    </div>
  </section>

  <!-- ================= FINAL CTA ================= -->
  <section class="bg-teal-800 py-32 text-white">
    <div class="max-w-7xl mx-auto px-6 text-center">

      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight">
        Looking for Tree Removal Near You?
      </h2>

      <p class="mt-8 max-w-3xl mx-auto text-lg text-white/90">
        Contact our local teams today for fast response, professional service,
        and expert tree care anywhere in South Florida.
      </p>

      <div class="mt-12">
        <a
          href="/contact-us/"
          class="inline-flex items-center gap-4 rounded-full
                 bg-white px-12 py-5 text-teal-800 font-extrabold
                 hover:bg-slate-100 transition"
        >
          Request a Free Estimate
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
