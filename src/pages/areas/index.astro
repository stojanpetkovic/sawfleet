---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Disclosure from "../../components/Disclosure.astro";
import CtaBand from "../../components/CtaBand.astro";
import SplitSection from "../../components/SplitSection.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import AreaMap from "../../components/AreaMap.astro";
import { counties, type CountyId } from "../../data/permits";
import { countyPages, placeHref, placesIn, places } from "../../data/places";
import { isActivePlace, coverage } from "../../config/coverage";

const title = "Service Areas | Tree Removal in South Florida";
const description =
  "Free tree removal estimates from independent local pros in Miami, Fort Lauderdale, Hollywood, Pembroke Pines, Boca Raton and across South Florida.";

const countyList = (Object.keys(counties) as CountyId[]).map((id) => ({
  id,
  name: counties[id],
  href: countyPages[id],
  cities: placesIn(id).map((p) => ({ name: p.name, href: placeHref(p) })),
}));
---

<BaseLayout title={title} description={description} pageType="CollectionPage">
  <PageHero
    badge="SERVICE AREAS"
    title="Tree Removal Across South Florida"
    lead="We connect property owners in Miami-Dade, Broward and Palm Beach County with independent local tree care professionals."
    image="beach-palms"
  />

  <section id="coverage" class="scroll-mt-28 bg-secondary-50 py-section">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <SectionHeading topper="Coverage" title="Where We Are Active" description={`Active now: ${coverage.activeLabel}. Everywhere else we are adding professionals: send a request and we try to match you, with no promise of a response.`} />
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card-static border-primary-300 p-6">
          <p class="mb-3 inline-block rounded-full bg-primary-600 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">Active now</p>
          <ul class="space-y-2">{places.filter((p) => isActivePlace(p.id)).map((p) => <li><a href={placeHref(p)} class="font-semibold text-primary-800 hover:underline">{p.name}</a></li>)}</ul>
          <p class="mt-4 text-sm text-secondary-600">An independent professional contacts you with a free estimate. <a href="/find-a-pro/fort-lauderdale/" class="font-semibold text-primary-700 underline">See who is listed</a>.</p>
        </div>
        <div class="card-static p-6">
          <p class="mb-3 inline-block rounded-full bg-amber-500 px-3 py-1 text-xs font-bold uppercase tracking-wide text-black">Being added</p>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">{places.filter((p) => !isActivePlace(p.id)).map((p) => <li><a href={placeHref(p)} class="text-secondary-700 hover:text-primary-700 hover:underline">{p.name}</a></li>)}</ul>
          <p class="mt-4 text-sm text-secondary-600">Tree company in one of these cities? <a href="/for-pros/" class="font-semibold text-primary-700 underline">Get listed</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <SectionHeading topper="Interactive map" title="Find Your City on the Map" description={`${places.length} cities across three counties. Select a county to focus, then a city for its page.`} />
      <AreaMap />
    </div>
  </section>

  <section class="bg-white py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="prose-sf mx-auto max-w-3xl text-center">
        <p>
          Pick your city for local conditions, permit notes and common questions, or go straight to the
          <a href="/contact-us/">contact form</a>. Not on the list? Ask: the professionals we connect you with work across
          each county.
        </p>
      </div>
      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          countyList.map((c) => (
            <div class="rounded-xl bg-secondary-50 p-8">
              <h2 class="text-xl font-bold text-text">
                {c.href ? <a href={c.href} class="hover:text-primary-900">{c.name}</a> : c.name}
              </h2>
              <ul class="mt-6 space-y-3">
                {
                  c.cities.map((city) => (
                    <li>
                      <a href={city.href} class="block rounded-lg bg-primary-600 px-5 py-3 font-medium text-white shadow-md transition hover:bg-primary-700">
                        {city.name} ↗
                      </a>
                    </li>
                  ))
                }
              </ul>
              {c.href && <a href={c.href} class="mt-6 inline-block font-semibold text-primary hover:underline">County overview ↗</a>}
            </div>
          ))
        }
      </div>
      <div class="mx-auto mt-14 max-w-3xl"><Disclosure variant="card" /></div>
    </div>
  </section>

  <SplitSection
    topper="Three counties"
    title="Miami-Dade, Broward and Palm Beach County"
    image="crane-lift"
    reverse
    tone="tint"
    html={`<p><strong>Miami-Dade</strong> has the largest canopy and the most variety, from live oaks and banyans to palms and mango trees, on limestone with shallow roots. <strong>Broward</strong> is dense suburbs and waterfront, where trees stand close to houses, pools and canals. <strong>Palm Beach County</strong> mixes coastal barrier islands with inland communities and large lots.</p><p>Tree rules, permits and associations differ by city, so each city page notes what to check. If your city is not listed, send a request and tell us where the tree is.</p>`}
  />

  <CtaBand title="Request a Free Estimate in Your City" />
</BaseLayout>
