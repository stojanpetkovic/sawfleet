---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const city = "Hollywood";
const county = "Broward County";
const state = "FL";
const phone = "+1-888-452-1505";

const title = `Tree Service in ${city}, ${state} | Professional & Emergency Tree Care`;
const description =
  `Professional tree service in ${city}, ${state}. Tree removal, emergency tree service, storm damage cleanup, and certified arborist services serving ${county} and surrounding South Florida areas.`;

const canonical = "https://sftreeremoval.com/areas/hollywood-tree-service/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
>

<!-- =========================================================
  LOCAL BUSINESS SCHEMA – HOLLYWOOD
========================================================= -->
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${canonical}#localbusiness`,
  "name": `SF Tree Removal – ${city}`,
  "url": canonical,
  "telephone": phone,
  "priceRange": "$$",
  "image": "https://sftreeremoval.com/images/og-default.jpg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city,
    "addressRegion": state,
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": city },
    { "@type": "AdministrativeArea", "name": county }
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
    ],
    "opens": "00:00",
    "closes": "23:59"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Tree Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Tree Removal",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Emergency Tree Service",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Storm Damage Tree Cleanup",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Certified Arborist Services",
          "areaServed": city
        }
      }
    ]
  }
})}
</script>

<!-- =========================================================
  BREADCRUMB SCHEMA
========================================================= -->
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sftreeremoval.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Service Areas",
      "item": "https://sftreeremoval.com/areas/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `${city} Tree Service`,
      "item": canonical
    }
  ]
})}
</script>

<!-- =========================================================
  FAQ PAGE SCHEMA – HOLLYWOOD
========================================================= -->
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What tree services do you offer in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `We provide full tree service in ${city}, including tree removal, emergency tree service, storm damage cleanup, and certified arborist services for residential and commercial properties.`
      }
    },
    {
      "@type": "Question",
      "name": `Do you offer emergency tree service in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. We provide 24/7 emergency tree service throughout ${city} and ${county} for fallen trees, storm damage, and hazardous situations.`
      }
    },
    {
      "@type": "Question",
      "name": `Do I need a permit for tree removal in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Some tree removals in ${city} require permits, especially for protected species or large trees. Our team assists with permit verification and certified arborist reports when required.`
      }
    },
    {
      "@type": "Question",
      "name": `Is your tree service company licensed and insured?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. Our tree service company serving ${city} is fully licensed and insured to protect homeowners, businesses, and commercial properties.`
      }
    },
    {
      "@type": "Question",
      "name": `Can you handle trees near homes or power lines?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. We specialize in controlled tree service and removal near homes, roofs, and power lines using professional equipment such as cranes, lifts, and rigging systems.`
      }
    }
  ]
})}
</script>

