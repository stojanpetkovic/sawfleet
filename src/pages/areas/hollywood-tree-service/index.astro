---
import CityPage from "../../../components/CityPage.astro";

const intro = [
  "Hollywood's older neighborhoods have tall, mature trees: oaks, mahogany, ficus and palms that have grown for decades next to houses, fences and power lines. Over time, some become a risk.",
  "Send one request and an independent tree care professional in the Fort Lauderdale area will contact you with a free estimate. SF Tree Removal is an online service that connects you with them; we don't do the work ourselves, so you agree the scope and price directly."
];

const conditions = [
  {
    "name": "Mature trees in established neighborhoods",
    "note": "Decades of growth put big canopies and roots close to roofs, walls and pipes."
  },
  {
    "name": "Coastal wind and salt",
    "note": "Exposure to storms and salt air stresses trees and can weaken branches."
  },
  {
    "name": "Palms and ficus",
    "note": "Palms drop fronds and coconuts, and ficus roots crack walls and lift pavement."
  },
  {
    "name": "Storm season",
    "note": "Saturated soil and strong wind make leaning and damaged trees urgent. Trim and assess before the season where you can."
  }
];

const nearby = [
  {
    "name": "Fort Lauderdale",
    "href": "/areas/fort-lauderdale-tree-removal/"
  },
  {
    "name": "Pembroke Pines",
    "href": "/areas/pembroke-pines-tree-removal/"
  },
  {
    "name": "Broward County",
    "href": "/areas/broward-county-tree-removal/"
  }
];

const faqs = [
  {
    "q": "How much does tree service cost in Hollywood?",
    "a": "It depends on the job: trimming, removal, stump grinding, tree size and access. You will get a free estimate; see our <a href=\"/tree-care-guides/tree-removal-cost-south-florida/\">cost guide</a>."
  },
  {
    "q": "Do I need a permit in Hollywood?",
    "a": "Often yes, unless a certified arborist documents that the tree is dangerous. See our <a href=\"/tree-removal-permits/\">permit guide</a> and confirm with the city."
  },
  {
    "q": "Can I request emergency help?",
    "a": "Choose Emergency Tree Removal in the <a href=\"/contact-us/\">form</a>. The request is flagged as urgent; we cannot promise an arrival time. If anyone is in danger, call 911."
  },
  {
    "q": "Who does the work?",
    "a": "An independent tree care professional in Broward County. SF Tree Removal is an online service; we do not perform the work. Ask for proof of license and insurance first."
  }
];

const notes = "<p>Hollywood has older neighborhoods with tall, mature trees and a long coastline along the Atlantic and the Intracoastal. Decades of growth put large trees close to houses, fences and overhead lines, and some of them have outgrown their space.</p><p>Wind and salt exposure near the coast, and heavy rain in summer, are the main stressors. Typical requests are for removing dead or leaning trees, trimming palms and clearing limbs from roofs.</p>";

const trees = [
  {
    "name": "Live oak",
    "note": "Wide, heavy limbs that often grow over roofs and driveways. Removal needs rigging so big pieces are lowered, not dropped."
  },
  {
    "name": "Ficus",
    "note": "Fast-growing with aggressive roots that crowd walls, pipes and pools. A frequent reason for removal requests."
  },
  {
    "name": "Royal palm",
    "note": "Tall and straight, often next to pools and houses. Lowering the crown needs care near screens and pavers."
  },
  {
    "name": "Sea grape",
    "note": "Salt-tolerant coastal native, often shaped as hedge or tree. Trimming should not strip the plant."
  },
  {
    "name": "Queen palm",
    "note": "Fast growing and short lived; prone to disease and to toppling in saturated soil."
  },
  {
    "name": "Australian pine",
    "note": "An invasive species that topples easily in storms and is commonly removed rather than kept."
  }
];
---

<CityPage
  city="Hollywood"
  county="Broward County"
  title="Tree Service in Hollywood, FL | Free Estimates"
  description="Free tree service estimates in Hollywood, FL: tree removal, trimming, storm cleanup and stump grinding from independent local pros."
  lead="Get a free tree service estimate from independent local professionals in Hollywood and across Broward County."
  intro={intro}
  conditions={conditions}
  permitId="hollywood"
  nearby={nearby}
  faqs={faqs}
  image="climber-rope"
  image2="brick-house-climber"
  image3="storm-uproot"
  notes={notes}
  trees={trees}
/>
