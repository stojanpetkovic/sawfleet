---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const city = "Boca Raton";
const county = "Palm Beach County";
const state = "FL";

const title = `Tree Removal Boca Raton FL | Emergency & Arborist Services`;
const description =
  `Professional tree removal in Boca Raton, FL. Emergency tree removal, storm damage cleanup, and certified arborist services for residential and commercial properties across ${county}.`;

const canonical = "https://sftreeremoval.com/areas/boca-raton-tree-removal/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
>
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${canonical}#localbusiness`,
  "name": `SF Tree Removal – Boca Raton`,
  "url": canonical,
  "priceRange": "$$$",
  "image": "https://sftreeremoval.com/images/og-default.jpg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city,
    "addressRegion": state,
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": city },
    { "@type": "AdministrativeArea", "name": county }
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
    ],
    "opens": "00:00",
    "closes": "23:59"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Tree Removal Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Tree Removal",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Emergency Tree Removal",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Storm Damage Tree Cleanup",
          "areaServed": city
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Certified Arborist Services",
          "areaServed": city
        }
      }
    ]
  }
})}
</script>
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sftreeremoval.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Service Areas",
      "item": "https://sftreeremoval.com/areas/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Boca Raton Tree Removal",
      "item": canonical
    }
  ]
})}
</script>
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you provide tree removal services in Boca Raton, FL?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. SF Tree Removal provides professional tree removal services in Boca Raton for residential, commercial, and HOA-managed properties."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer emergency tree removal in Boca Raton?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We offer 24/7 emergency tree removal in Boca Raton for storm damage, fallen trees, and hazardous situations."
      }
    },
    {
      "@type": "Question",
      "name": "Are permits required for tree removal in Boca Raton?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Some tree removals in Boca Raton require permits, especially for protected species. Our team assists with permit verification and certified arborist reports."
      }
    },
    {
      "@type": "Question",
      "name": "Is your tree removal company licensed and insured?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. SF Tree Removal is fully licensed and insured to perform tree removal safely and professionally in Boca Raton."
      }
    },
    {
      "@type": "Question",
      "name": "Can you remove trees near luxury homes and tight spaces?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We specialize in controlled tree removal near luxury homes, pools, and structures using cranes, lifts, and precision rigging."
      }
    }
  ]
})}
</script>

