---
import CityPage from "../../../components/CityPage.astro";

const intro = [
  "Davie has larger lots than most of Broward, many with mature oaks, mango trees and tall palms. Large trees on big properties, close to houses, fences, horse barns and power lines, need planned removal.",
  "Send one request and an independent tree care professional in the Fort Lauderdale area will contact you with a free estimate. SF Tree Removal is an online service that connects you with them; we don't do the work ourselves, so you agree the scope and price directly."
];

const conditions = [
  {
    "name": "Large lots and big trees",
    "note": "Tall, mature trees on big properties need equipment, space to work and a plan for where each piece lands."
  },
  {
    "name": "Trees near fences and outbuildings",
    "note": "Barns, fences and sheds close to a tree change the method and the price."
  },
  {
    "name": "Power lines",
    "note": "Trees touching power lines are handled by the utility. Do not cut them yourself."
  },
  {
    "name": "Storm damage",
    "note": "Strong wind and saturated soil bring down trees and limbs onto roofs, fences and driveways."
  }
];

const nearby = [
  {
    "name": "Pembroke Pines",
    "href": "/areas/pembroke-pines-tree-removal/"
  },
  {
    "name": "Miramar",
    "href": "/areas/miramar-tree-removal/"
  },
  {
    "name": "Broward County",
    "href": "/areas/broward-county-tree-removal/"
  }
];

const faqs = [
  {
    "q": "How much does tree removal cost in Davie?",
    "a": "It depends on the size of the tree, how close it is to the house, pool or power lines, and whether a crane is needed. You will get a free estimate for your specific tree; see our <a href=\"/tree-care-guides/tree-removal-cost-south-florida/\">cost guide</a>."
  },
  {
    "q": "Do I need a permit to remove a tree in Davie?",
    "a": "Often yes, depending on the tree, the property and the city's rules, unless a certified arborist documents that the tree is dangerous. See our <a href=\"/tree-removal-permits/\">permit guide</a> and confirm with the city."
  },
  {
    "q": "Can I get emergency tree help in Davie?",
    "a": "Choose Emergency Tree Removal in the <a href=\"/contact-us/\">form</a>. The request is flagged as urgent for local professionals; we cannot promise an arrival time. If anyone is in danger, call 911."
  },
  {
    "q": "Who does the work?",
    "a": "An independent tree care professional in Broward County. SF Tree Removal is an online service; we do not perform the work. Ask for proof of license and insurance first."
  }
];

const notes = "<p>Davie has larger lots than most of Broward, with a rural and equestrian character in the western part of town. Mature oaks, mango trees and tall palms on big properties are common, and removal can mean working around fences, barns and outbuildings.</p><p>Larger trees need space and equipment, so describe access and what stands near the tree when you send the request. Trees near power lines are handled by the utility.</p>";

const trees = [
  {
    "name": "Live oak",
    "note": "Wide, heavy limbs that often grow over roofs and driveways. Removal needs rigging so big pieces are lowered, not dropped."
  },
  {
    "name": "Mango",
    "note": "Large fruit tree with heavy limbs that can fail in wind. Often needs thinning and fruit-drop cleanup."
  },
  {
    "name": "Royal palm",
    "note": "Tall and straight, often next to pools and houses. Lowering the crown needs care near screens and pavers."
  },
  {
    "name": "Avocado",
    "note": "Brittle wood that breaks in storms; frequent thinning keeps it safer."
  },
  {
    "name": "Australian pine",
    "note": "An invasive species that topples easily in storms and is commonly removed rather than kept."
  },
  {
    "name": "Mahogany",
    "note": "Large shade tree with a broad canopy. Branch failure in storms is common, so structure and dead wood matter."
  }
];
---

<CityPage
  city="Davie"
  county="Broward County"
  title="Tree Removal in Davie, FL | Free Local Estimates"
  description="Free tree removal estimates in Davie, FL: removal, trimming, stump grinding and storm cleanup from independent local pros."
  lead="Get a free tree removal estimate from independent local professionals in Davie and central Broward County."
  intro={intro}
  conditions={conditions}
  permitId="davie"
  nearby={nearby}
  faqs={faqs}
  image="arborist-inspect"
  image2="trunk-bucket"
  image3="uprooted-yard"
  notes={notes}
  trees={trees}
/>
