---

<CountyPage
  county="Palm Beach County"
  title="Tree Removal in Palm Beach County, FL | SF Tree Removal"
  description="Free tree removal estimates from independent local pros across Palm Beach County, from Boca Raton to West Palm Beach."
  lead="Get a free tree removal estimate from independent local professionals across Palm Beach County."
  intro={[
    "Palm Beach County mixes coastal properties full of palms with inland neighborhoods shaded by large oaks and ficus. Close to the ocean, storms and salt air take a toll on trees, and a weakened tree near a house is a risk nobody wants to leave until the next hurricane.",
    "SF Tree Removal is an online service that connects property owners with independent tree care professionals. We are adding professionals in Palm Beach County; send a request and we will try to match you, but we cannot promise a response yet. We do not perform the work ourselves; the professional you choose agrees the scope, price and schedule with you.",
  ]}
  cities={cities}
  trees={trees}
  permits={permits}
  image="canopy-climber"
  image2="aerial-lift"
  image3="trunk-cutting"
  notes={notes}
  faqs={faqs}
  permitGuide="/tree-care-guides/palm-beach-county-tree-removal-permit/"
/>
