  { name: "West Palm Beach", href: "/areas/west-palm-beach-tree-removal/" },
  { name: "Wellington", href: "/areas/wellington-tree-removal/" },
  { name: "Palm Beach Gardens", href: "/areas/palm-beach-gardens-tree-removal/" },
  { name: "Jupiter", href: "/areas/jupiter-tree-removal/" },
  { name: "Royal Palm Beach" },
];

const trees = [
  { name: "Royal, coconut and other palms", note: "Tall palms around pools, entries and HOA common areas, where fronds and coconuts fall over walkways." },
  { name: "Live oaks and laurel oaks", note: "Mature oaks with heavy limbs over roofs, which need controlled removal or crown reduction." },
  { name: "Ficus and banyan", note: "Trees with aggressive roots that damage foundations, walls, pools and driveways." },
  { name: "Mahogany and gumbo limbo", note: "Popular shade trees in older neighborhoods, often trimmed or removed after storm damage." },
  { name: "Australian pine", note: "An invasive tree common along the coast that fails easily in high winds." },
  { name: "Storm-damaged trees", note: "Leaning trees, split trunks and hanging limbs after tropical storms and hurricanes." },
];

const permits = [
  "In Palm Beach County, tree rules are set by the city the property is in, such as Boca Raton, Delray Beach or West Palm Beach, or by the county for unincorporated areas. Many communities also have HOA rules on top of that.",
  "Under Florida Statute 163.045, a homeowner may remove a tree on residential property without a local permit when a certified arborist or licensed landscape architect documents that the tree poses an unacceptable risk to people or property. Keep that documentation; the city can ask for it later.",
  "Because the rules differ from city to city and change over time, check with your city or HOA before work starts. Ask the professional what is usually needed for your address.",
];

const notes = "<p>Palm Beach County stretches from the coastal barrier islands and the Intracoastal in the east to the agricultural lands near Lake Okeechobee in the west. On the coast, wind and salt air stress trees; inland, large lots and planned communities have mature oaks, mango trees and tall palms.</p><p>The county has dozens of municipalities, each with its own tree rules, and many communities are governed by associations that must approve removal or replacement. In unincorporated areas the county's land development code applies.</p><p>Common requests include palm trimming, removing storm-damaged or dead trees and large trees over roofs. Describe the surroundings so the professional can plan the right equipment.</p>";

const faqs = [
  {
    "q": "How much does tree removal cost in Palm Beach County?",
    "a": "It depends on the size of the tree, how close it is to the house, pool or power lines, and whether a crane is needed. You will get a free estimate for your specific tree; see our <a href=\"/tree-care-guides/tree-removal-cost-south-florida/\">cost guide</a>."
  },
  {
    "q": "Do I need a permit to remove a tree in Palm Beach County?",
    "a": "Often yes, depending on the tree, the property and the city or county rules, unless a certified arborist documents that the tree is dangerous. See our <a href=\"/tree-removal-permits/\">permit guide</a> and confirm with your city."
  },
  {
    "q": "Can I get emergency tree help in Palm Beach County?",
    "a": "Choose Emergency Tree Removal in the <a href=\"/contact-us/\">form</a>. The request is flagged as urgent for local professionals; we cannot promise an arrival time. If anyone is in danger, call 911."
  },
  {
    "q": "Who does the work?",
    "a": "An independent tree care professional who works in Palm Beach County. SF Tree Removal is an online service; we do not perform the work. Ask for proof of license and insurance first."
  }
