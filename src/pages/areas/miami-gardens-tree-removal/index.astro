---
import CityPage from "../../../components/CityPage.astro";

const intro = [
  "Miami Gardens is a large suburban city in northern Miami-Dade, with neighborhoods of single-family homes where mango, ficus, oak and palm trees have grown for decades close to roofs, fences and overhead lines.",
  "Send one request and we will try to match you with an independent tree care professional. We are adding professionals in Miami Gardens and cannot promise a response yet, so you can also tell us you want to be notified. SF Tree Removal is an online service; we don't do the work ourselves, so you agree the scope and price directly with the professional you are matched with."
];

const conditions = [
  {
    "name": "Mature trees near houses",
    "note": "Decades of growth put canopy and roots close to roofs, walls and pipes."
  },
  {
    "name": "Overhead lines",
    "note": "Trees near power lines are handled by the utility. Do not cut anything touching a line."
  },
  {
    "name": "Hurricane exposure",
    "note": "Saturated soil and strong wind bring down weak or shallow-rooted trees."
  },
  {
    "name": "Fruit trees",
    "note": "Mango and avocado have heavy, brittle limbs that need regular thinning."
  }
];

const notes = "<p>Northern Miami-Dade is mostly suburban single-family housing, so tree work usually happens on lots with a house, a fence and a neighbor close by. That makes access and the fall zone the first things a professional checks.</p><p>Miami-Dade's county code exempts many yard trees at an existing single-family home, but not specimen trees or trees in natural forest communities, and cities with their own rules decide for themselves. Check which applies to your address before you cut.</p>";

const trees = [
  {
    "name": "Mango",
    "note": "Large fruit tree with heavy limbs that can fail in wind. Often needs thinning and fruit-drop cleanup."
  },
  {
    "name": "Ficus",
    "note": "Fast-growing with aggressive roots that crowd walls, pipes and pools. A frequent reason for removal requests."
  },
  {
    "name": "Royal palm",
    "note": "Tall and straight, often next to pools and houses. Lowering the crown needs care near screens and pavers."
  },
  {
    "name": "Mahogany",
    "note": "Large shade tree with a broad canopy. Branch failure in storms is common, so structure and dead wood matter."
  },
  {
    "name": "Avocado",
    "note": "Brittle wood that breaks in storms; frequent thinning keeps it safer."
  },
  {
    "name": "Australian pine",
    "note": "An invasive species that topples easily in storms and is commonly removed rather than kept."
  }
];

const nearby = [
  {
    "name": "Miami",
    "href": "/areas/miami-tree-removal/"
  },
  {
    "name": "North Miami Beach",
    "href": "/areas/north-miami-beach-tree-removal/"
  },
  {
    "name": "Miami-Dade County",
    "href": "/areas/miami-dade-county-tree-removal/"
  }
];

const faqs = [
  {
    "q": "How much does tree removal cost in Miami Gardens?",
    "a": "It depends on the size of the tree, how close it is to the house, pool or power lines, and whether a crane is needed. You will get a free estimate for your specific tree; see our <a href=\"/tree-care-guides/tree-removal-cost-south-florida/\">cost guide</a>."
  },
  {
    "q": "Do I need a permit to remove a tree in Miami Gardens?",
    "a": "Often, but it depends on the tree, the property and the rules where you live. Use the <a href=\"/permit-checker/\">permit checker</a> for what Miami Gardens and its county say, and confirm with the city."
  },
  {
    "q": "Can I get emergency tree help in Miami Gardens?",
    "a": "Choose Emergency Tree Removal in the <a href=\"/contact-us/\">form</a>. The request is flagged as urgent for local professionals; we cannot promise an arrival time. If anyone is in danger, call 911."
  },
  {
    "q": "Who does the work?",
    "a": "An independent tree care professional in Miami-Dade County. SF Tree Removal is an online service; we do not perform the work. Ask for proof of license and insurance first."
  }
];
---

<CityPage
  city="Miami Gardens"
  county="Miami-Dade County"
  title="Tree Removal in Miami Gardens, FL | Free Estimates"
  description="Free tree removal estimates in Miami Gardens, FL: removal, trimming, stump grinding and storm cleanup from independent local pros."
  lead="Get a free tree removal estimate from independent local professionals in Miami Gardens and northern Miami-Dade."
  intro={intro}
  conditions={conditions}
  permitId="other-miami-dade"
  nearby={nearby}
  faqs={faqs}
  image="canopy-climber"
  image2="crane-lift"
  image3="storm-uproot"
  notes={notes}
  trees={trees}
/>
