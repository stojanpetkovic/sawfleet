---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SplitSection from "../../components/SplitSection.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import CtaBand from "../../components/CtaBand.astro";
import { business } from "../../config/business";
import Disclosure from "../../components/Disclosure.astro";
import { places } from "../../data/places";
import { isActivePlace } from "../../config/coverage";

const services = [
  "Tree Removal",
  "Emergency Tree Removal",
  "Tree Trimming / Pruning",
  "Stump Grinding",
  "Arborist Assessment",
  "Not sure yet",
];

const cityOptions = [
  ...places.map((p) => ({ name: p.name, active: isActivePlace(p.id) })),
  { name: "Other Broward County", active: false },
  { name: "Other Miami-Dade County", active: false },
  { name: "Other Palm Beach County", active: false },
];

const inputClass =
  "w-full rounded-md border border-border bg-background px-4 py-3 text-text outline-hidden transition focus:border-primary focus:ring-2 focus:ring-primary/20";
---

<BaseLayout
  title="Free Tree Removal Estimate | Contact SF Tree Removal"
  pageType="ContactPage"
  description="Request a free estimate for tree removal, trimming or emergency service in South Florida. Active in the Fort Lauderdale area."
>
  <PageHero
    badge="FREE ESTIMATES"
    title="Contact SF Tree Removal"
    lead="Tell us about the tree and the property. We pass your request to an independent tree care professional for a free estimate. We are active in the Fort Lauderdale area and adding more areas."
    actions={false}
  />

  <!-- ================= FORM + INFO ================= -->
  <section class="bg-secondary-50 py-section">
    <div class="mx-auto grid max-w-site gap-10 px-4 sm:px-6 lg:grid-cols-3">
      <!-- FORM -->
      <div class="form-card lg:col-span-2">
        <h2 class="font-heading text-h3 font-bold">Request a Free Estimate</h2>
        <p class="mt-2 text-text-muted">Fields marked * are required.</p>

        <form data-lead-form="contact" data-lead-ignore class="mt-8 space-y-5">
          <div class="grid gap-5 md:grid-cols-2">
            <label class="block">
              <span class="field-label">Full name *</span>
              <input name="name" required autocomplete="name" class="field-input" />
            </label>
            <label class="block">
              <span class="field-label">Phone *</span>
              <input name="phone" type="tel" required autocomplete="tel" class="field-input" />
            </label>
          </div>

          <label class="block">
            <span class="field-label">Email</span>
            <input name="email" type="email" autocomplete="email" class="field-input" />
          </label>

          <div class="grid gap-5 md:grid-cols-2">
            <label class="block">
              <span class="field-label">Service needed</span>
              <select name="service" class="field-input">
                {services.map((s) => <option value={s}>{s}</option>)}
              </select>
            </label>
            <label class="block">
              <span class="field-label">City</span>
              <select name="city" id="contact-city" class="field-input">
                <option value="" data-active="">Choose your city…</option>
                {cityOptions.map((c) => <option value={c.name} data-active={c.active ? "yes" : "no"}>{c.name}{c.active ? "" : " (coming soon)"}</option>)}
              </select>
              <input type="hidden" name="coverage_status" id="coverage-status" value="" />
              <p id="coverage-note" hidden class="mt-2 rounded-xl bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-900"></p>
            </label>
          </div>

          <label class="block">
            <span class="field-label">Tell us about the job *</span>
            <textarea
              name="message"
              required
              rows="5"
              placeholder="Type of tree, approximate size, how close it is to the house or power lines, any damage…"
              class="field-input"></textarea>
          </label>

          <!-- Left empty by people; bots fill it in. -->
          <input name="website_hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <p data-lead-error hidden class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></p>

          <button
            type="submit"
            class="btn btn-accent w-full !px-8 !py-4 !text-base md:w-auto"
          >
            Send Request
          </button>
          <p class="text-xs text-text-muted">
            By sending this form you agree to our <a href="/privacy-policy/" class="underline">Privacy Policy</a>.
            We share your details only with the professional who answers your request.
          </p>
        </form>
      </div>

      <!-- INFO -->
      <aside class="space-y-6">
        <div class="rounded-xl bg-gradient-to-br from-primary-700 to-primary-900 p-8 text-white shadow-xl">
          <h2 class="text-lg font-bold">Need help right now?</h2>
          <p class="mt-2 text-sm text-white/85">
            For fallen trees, storm damage or a tree on a house or power line, choose Emergency Tree Removal in the form
            and we flag your request as urgent. If anyone is in danger, call 911.
          </p>
          <p class="mt-4 text-xs text-white/75">We cannot promise an arrival time; speed depends on local availability.</p>
        </div>

        <div class="rounded-xl bg-white p-8 shadow-md">
          <h2 class="text-lg font-bold text-text">About this service</h2>
          <Disclosure class="mt-4 text-text-muted" />
        </div>

        <div class="rounded-xl bg-white p-8 shadow-md">
          <h2 class="text-lg font-bold text-text">Areas we serve</h2>
          <ul class="mt-4 space-y-2 text-sm">
            <li><a href="/areas/miami-tree-removal/" class="text-primary hover:underline">Miami</a></li>
            <li><a href="/areas/fort-lauderdale-tree-removal/" class="text-primary hover:underline">Fort Lauderdale</a></li>
            <li><a href="/areas/hollywood-tree-service/" class="text-primary hover:underline">Hollywood</a></li>
            <li><a href="/areas/pembroke-pines-tree-removal/" class="text-primary hover:underline">Pembroke Pines</a></li>
            <li><a href="/areas/boca-raton-tree-removal/" class="text-primary hover:underline">Boca Raton</a></li>
            <li><a href="/areas/" class="font-semibold text-text hover:underline">All service areas →</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <SplitSection
    topper="Get a better estimate"
    title="What to Include in Your Request"
    image="arborist-inspect"
    html={`<ul><li><strong>The tree:</strong> type (if you know it), approximate height and trunk width.</li><li><strong>Where it is:</strong> your city, and how close it is to the house, pool, fence and power lines.</li><li><strong>What is wrong:</strong> dead, leaning, cracked, storm-damaged, or just in the way.</li><li><strong>What you want:</strong> removal, trimming, stump grinding or an assessment, and whether you want the wood hauled away.</li><li><strong>Access:</strong> gates, side yards and anything that would limit equipment.</li><li><strong>Urgency:</strong> if the tree is on a structure, choose Emergency Tree Removal.</li></ul><p>Photos help, and you can send them to the professional when they contact you.</p>`}
  />

  <HowItWorks title="What Happens After You Send It" />

  <CtaBand title="Not Sure Yet?" text="Read our guides on cost, permits and warning signs first. Then come back and send your request when you are ready." />

  <script>
    const sel = document.getElementById("contact-city") as HTMLSelectElement | null;
    const status = document.getElementById("coverage-status") as HTMLInputElement | null;
    const note = document.getElementById("coverage-note");
    function sync() {
      if (!sel || !status || !note) return;
      const opt = sel.selectedOptions[0];
      const active = opt?.dataset.active;
      status.value = active === "yes" ? "active" : active === "no" ? "not-yet-active" : "";
      if (active === "no") {
        note.hidden = false;
        note.textContent = `We do not have a professional in ${sel.value} yet. We will try to match your request, but we cannot promise a response. Your request also helps us see where to add professionals.`;
      } else note.hidden = true;
    }
    const q = new URLSearchParams(location.search).get("city");
    if (sel && q) { const o = [...sel.options].find((x) => x.value === q); if (o) sel.value = q; }
    sel?.addEventListener("change", sync);
    sync();
  </script>
</BaseLayout>
