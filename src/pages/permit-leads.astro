---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileNav from "../components/layout/MobileNav.astro";
import { supabase } from "../lib/supabase";
import { supabaseAdmin } from "../lib/supabaseAdmin";
import { ArrowLeft, ArrowRight, ArrowUpDown, Calendar, Eye, Gauge, Mail, MapPin, Phone, ScrollText, Star } from "lucide-astro";

const PAGE_SIZE = 30;
const SORT_COLUMNS: Record<string, string> = {
  discovered: "discovered_at",
  permit_date: "permit_date",
  score: "lead_score",
  jurisdiction: "jurisdiction",
};
const SORT_LABELS: Record<string, string> = {
  discovered: "Date found",
  permit_date: "Permit date",
  score: "Lead score",
  jurisdiction: "Jurisdiction",
};

const reqUrl = Astro.url;
const sortKeyParam = reqUrl.searchParams.get("sort") || "";
const sortKey = SORT_COLUMNS[sortKeyParam] ? sortKeyParam : "discovered";
const sortColumn = SORT_COLUMNS[sortKey];
const dir: "asc" | "desc" = reqUrl.searchParams.get("dir") === "asc" ? "asc" : "desc";
const page = Math.max(1, parseInt(reqUrl.searchParams.get("page") || "1", 10) || 1);
const offset = (page - 1) * PAGE_SIZE;

// Ova strana treba da radi za anonimnog posetioca bez ikakve prijave, a
// permit_leads nema javnu RLS politiku (samo admin + "contractor unlocked").
// Isti obrazac kao ranije contractors-registration.astro: SSR sa service
// role-om zaobilazi RLS, bez ikakve izmene baze.
const db = supabaseAdmin ?? supabase;

const [{ data: leads, count }, { count: totalCount }] = await Promise.all([
  db
    .from("permit_leads")
    .select("id, owner_name, owner_phone, owner_email, address, jurisdiction, permit_type, permit_description, permit_date, discovered_at, lead_score", { count: "exact" })
    .eq("permit_status", "qualified")
    .is("archived_at", null)
    .order(sortColumn, { ascending: dir === "asc", nullsFirst: false })
    .range(offset, offset + PAGE_SIZE - 1),
  db
    .from("permit_leads")
    .select("id", { count: "exact", head: true })
    .eq("permit_status", "qualified")
    .is("archived_at", null),
]);

const total = totalCount ?? count ?? 0;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

function sortUrl(key: string) {
  const params = new URLSearchParams(reqUrl.search);
  const nextDir = sortKey === key && dir === "desc" ? "asc" : "desc";
  params.set("sort", key);
  params.set("dir", nextDir);
  params.set("page", "1");
  return `/permit-leads?${params.toString()}`;
}

function pageUrl(targetPage: number) {
  const params = new URLSearchParams(reqUrl.search);
  params.set("page", String(targetPage));
  return `/permit-leads?${params.toString()}`;
}

function formatDate(value: string | null) {
  if (!value) return "—";
  return new Date(value).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}

function recordId(id: string) {
  return String(id).replace(/-/g, "").slice(0, 8).toUpperCase();
}

const title = "Potential Permit Leads | SF Tree Removal";
const description = `Browse ${total.toLocaleString()} property owners who recently filed a public tree-related permit across South Florida, with contact details.`;
---

<MainLayout title={title} description={description}>
  <Header />
  <main class="min-h-screen bg-slate-950 pb-24">

    <!-- ============================================== -->
    <!-- HERO -->
    <!-- ============================================== -->
    <section class="relative overflow-hidden border-b border-white/10 px-5 pt-28 pb-14 text-white md:px-8 md:pt-36 lg:pb-20">
      <!-- Blueprint grid tekstura — unificiran identitet svih hero sekcija -->
      <div class="pointer-events-none absolute inset-0 opacity-[0.5]" aria-hidden="true" style="background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 34px 34px;"></div>
      <div class="pointer-events-none absolute -left-24 -top-32 h-[28rem] w-[28rem] rounded-full bg-green-500/[0.12] blur-[120px]" aria-hidden="true"></div>

      <!-- Decorativni "ghost" ikonice u pozadini -->
      <ScrollText size={190} strokeWidth={0.8} class="pointer-events-none absolute -right-6 top-10 hidden -rotate-12 text-white/[0.05] lg:block" aria-hidden="true" />
      <Calendar size={120} strokeWidth={0.8} class="pointer-events-none absolute right-72 top-0 hidden rotate-6 text-white/[0.05] lg:block" aria-hidden="true" />

      <div class="relative z-10 mx-auto w-full max-w-7xl">
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-green-400"></span>
          </span>
          <span class="text-[10px] font-mono font-bold uppercase tracking-[0.22em] text-green-400">Live feed · public permit records</span>
        </div>
        <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl">Potential Permit Leads</h1>
        <p class="mt-5 max-w-2xl text-sm leading-7 text-slate-400 md:text-base">
          These are property owners who recently filed a tree-related permit application with their local jurisdiction — Broward, Palm Beach, Miami-Dade and surrounding South Florida counties. Permit filings are public government records; we compile and publish them here, with the contact details included in the filing, so you can reach out directly about the work.
        </p>

        <!-- Trust row: dekorativno, bez konkretnih brojeva -->
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 backdrop-blur">
            <Eye size={14} class="text-green-300" strokeWidth={1.8} />
            <span class="text-[11px] font-bold text-slate-300">Visited daily by tree care businesses</span>
          </div>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 backdrop-blur">
            <div class="flex gap-0.5 text-amber-400">
              {Array.from({ length: 5 }).map(() => <Star size={12} fill="currentColor" strokeWidth={0} />)}
            </div>
            <span class="text-[11px] font-bold text-slate-300">Trusted public-records source</span>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center divide-x divide-white/10 rounded-2xl border border-white/10 bg-white/[0.03] px-6 py-4 font-mono backdrop-blur">
          <div class="pr-6"><strong class="block text-2xl font-bold text-white">{total.toLocaleString()}</strong><span class="mt-1 block text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">qualified_leads</span></div>
          <div class="pl-6"><strong class="block text-2xl font-bold text-white">{totalPages.toLocaleString()}</strong><span class="mt-1 block text-[9px] font-bold uppercase tracking-[0.16em] text-slate-500">pages_of_{PAGE_SIZE}</span></div>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- SORT + LIST -->
    <!-- ============================================== -->
    <section class="relative px-5 py-10 md:px-8">
      <div class="relative z-10 mx-auto w-full max-w-7xl">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[9px] font-mono font-bold uppercase tracking-[0.18em] text-slate-500">Sort by</span>
          {Object.keys(SORT_LABELS).map((key) => (
            <a
              href={sortUrl(key)}
              class={`inline-flex h-9 items-center gap-1.5 rounded-full border px-3 text-[10px] font-bold uppercase tracking-wider transition ${sortKey === key ? "border-green-400/40 bg-green-400/10 text-green-300" : "border-white/10 bg-white/[0.03] text-slate-400 hover:border-green-400/30 hover:text-green-300"}`}
            >
              {SORT_LABELS[key]}
              {sortKey === key ? (dir === "desc" ? " ↓" : " ↑") : <ArrowUpDown size={11} />}
            </a>
          ))}
        </div>

        <div class="mt-6 space-y-4">
          {(leads || []).length === 0 && (
            <div class="rounded-2xl border border-dashed border-white/15 bg-white/[0.02] p-10 text-center text-sm text-slate-500">No permit leads match this page.</div>
          )}
          {(leads || []).map((lead: any) => (
            <article class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] backdrop-blur transition-all hover:border-green-400/40 hover:bg-white/[0.06]">
              <div class="flex flex-col lg:flex-row">

                <!-- Levo: permit info -->
                <div class="min-w-0 flex-1 p-5 md:p-6">
                  <div class="flex items-center justify-between gap-2">
                    <span class="inline-flex items-center gap-1.5 text-[9px] font-mono font-bold uppercase tracking-[0.16em] text-slate-500"><ScrollText size={12} /> Record #{recordId(lead.id)}</span>
                  </div>
                  <div class="mt-3 flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center rounded-md border border-green-400/25 bg-green-400/10 px-2 py-1 text-[9px] font-bold uppercase tracking-wider text-green-300">{lead.permit_type || "Permit"}</span>
                    {lead.jurisdiction && <span class="inline-flex items-center gap-1 rounded-md bg-white/[0.06] px-2 py-1 text-[9px] font-bold uppercase tracking-wider text-slate-400"><MapPin size={11} /> {lead.jurisdiction}</span>}
                    {typeof lead.lead_score === "number" && <span class="inline-flex items-center gap-1 rounded-md border border-violet-400/25 bg-violet-400/10 px-2 py-1 text-[9px] font-bold uppercase tracking-wider text-violet-300"><Gauge size={11} /> Score {lead.lead_score}</span>}
                  </div>
                  <h2 class="mt-3 text-base font-bold leading-snug text-white md:text-lg">{lead.address || "Address not listed"}</h2>
                  {lead.permit_description && <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-400">{lead.permit_description}</p>}
                  <div class="mt-3 flex flex-wrap items-center gap-4 font-mono text-[11px] text-slate-500">
                    <span class="inline-flex items-center gap-1.5"><Calendar size={12} /> permit: {formatDate(lead.permit_date)}</span>
                    <span class="inline-flex items-center gap-1.5"><ScrollText size={12} /> found: {formatDate(lead.discovered_at)}</span>
                  </div>
                </div>

                <!-- Perforacija — horizontalna na mobilnom, vertikalna na desktopu -->
                <div class="relative block lg:hidden" aria-hidden="true">
                  <div class="border-t border-dashed border-white/15"></div>
                  <span class="absolute -left-2.5 top-1/2 h-5 w-5 -translate-y-1/2 rounded-full bg-slate-950"></span>
                  <span class="absolute -right-2.5 top-1/2 h-5 w-5 -translate-y-1/2 rounded-full bg-slate-950"></span>
                </div>
                <div class="relative hidden shrink-0 self-stretch lg:block" aria-hidden="true">
                  <div class="absolute inset-y-0 left-1/2 border-l border-dashed border-white/15"></div>
                  <span class="absolute -top-2.5 left-1/2 h-5 w-5 -translate-x-1/2 rounded-full bg-slate-950"></span>
                  <span class="absolute -bottom-2.5 left-1/2 h-5 w-5 -translate-x-1/2 rounded-full bg-slate-950"></span>
                </div>

                <!-- Desno: owner contact -->
                <div class="shrink-0 space-y-2 p-5 md:p-6 lg:w-64">
                  <p class="text-[9px] font-mono font-bold uppercase tracking-[0.16em] text-slate-500">Filed by</p>
                  <p class="text-sm font-bold text-white">{lead.owner_name || "Name not listed"}</p>
                  {lead.owner_phone ? (
                    <a href={`tel:${lead.owner_phone}`} class="flex items-center gap-2 font-mono text-sm font-bold text-green-400 hover:text-green-300"><Phone size={14} /> {lead.owner_phone}</a>
                  ) : (
                    <p class="text-xs text-slate-500">Phone not listed</p>
                  )}
                  {lead.owner_email ? (
                    <a href={`mailto:${lead.owner_email}`} class="flex items-center gap-2 break-all font-mono text-sm font-bold text-green-400 hover:text-green-300"><Mail size={14} /> {lead.owner_email}</a>
                  ) : (
                    <p class="text-xs text-slate-500">Email not listed</p>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>

        {totalPages > 1 && (
          <nav class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row" aria-label="Permit leads pagination">
            <p class="font-mono text-xs text-slate-500">Page {page} of {totalPages} · {total.toLocaleString()} total</p>
            <div class="flex items-center gap-2">
              {page > 1 ? (
                <a href={pageUrl(page - 1)} class="inline-flex h-10 items-center justify-center gap-1.5 rounded-xl border border-white/10 bg-white/[0.03] px-3 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400 hover:border-green-400/30 hover:text-green-300"><ArrowLeft size={14} /> Previous</a>
              ) : (
                <span class="inline-flex h-10 cursor-not-allowed items-center justify-center gap-1.5 rounded-xl border border-white/10 bg-white/[0.02] px-3 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600"><ArrowLeft size={14} /> Previous</span>
              )}
              {page < totalPages ? (
                <a href={pageUrl(page + 1)} class="inline-flex h-10 items-center justify-center gap-1.5 rounded-xl border border-white/10 bg-white/[0.03] px-3 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400 hover:border-green-400/30 hover:text-green-300">Next <ArrowRight size={14} /></a>
              ) : (
                <span class="inline-flex h-10 cursor-not-allowed items-center justify-center gap-1.5 rounded-xl border border-white/10 bg-white/[0.02] px-3 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600">Next <ArrowRight size={14} /></span>
              )}
            </div>
          </nav>
        )}
      </div>
    </section>
  </main>
  <Footer />
  <MobileNav />
</MainLayout>
