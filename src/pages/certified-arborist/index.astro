---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalBusinessSchema from "../../components/LocalBusinessSchema.astro";

const phone = "1-888-452-1505";
---

<BaseLayout
  title="Certified Arborist Services South Florida | Tree Health & Permits"
  description="Certified arborist services in South Florida. Tree health assessments, arborist reports, permit assistance, and expert recommendations for residential and commercial properties."
  canonical="https://sftreeremoval.com/certified-arborist/"
>
  <!-- ================= LOCAL BUSINESS SCHEMA ================= -->
  <LocalBusinessSchema />

<!-- ================= HERO ================= -->
<section class="relative bg-teal-900 py-32 text-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 text-center">

    <!-- BADGE -->
