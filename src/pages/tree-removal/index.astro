---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalBusinessSchema from "../../components/LocalBusinessSchema.astro";

---

<BaseLayout
  title="Tree Removal Service South Florida | SF Tree Removal"
  description="Professional tree removal service in South Florida. Licensed & insured tree removal, emergency response, and safe modern equipment. Free estimates available."
  canonical="https://sftreeremoval.com/tree-removal/"
>
  <!-- ================= LOCAL BUSINESS SCHEMA ================= -->
  <LocalBusinessSchema />

<!-- ================= HERO ================= -->
<section class="bg-teal-800 py-32">
  <div class="max-w-7xl mx-auto px-6 text-center text-white">

    <!-- BADGE -->
    <span
      class="inline-block mb-8 px-4 py-1 text-xs font-bold tracking-widest
             border border-dashed border-white/60 rounded-full"
    >
      TREE REMOVAL SERVICE
    </span>

    <!-- H1 -->
    <h1 class="text-4xl md:text-5xl xl:text-6xl font-extrabold leading-tight">
      Professional Tree Removal Service<br class="hidden sm:block" />
      in South Florida
    </h1>

    <!-- SUBTEXT -->
    <p class="mt-8 max-w-3xl mx-auto text-lg text-white/90">
      Licensed and insured tree removal company providing safe, efficient and
      compliant tree removal for residential and commercial properties across
      South Florida.
    </p>

    <!-- CTA -->
    <div class="mt-14 flex flex-wrap justify-center gap-6">

      <!-- PRIMARY -->

      <!-- SECONDARY -->
      <a
        href="/contact-us/"
        class="inline-flex items-center gap-4 rounded-full
               border border-white/70 px-10 py-4 text-white font-bold
               hover:bg-white/10 transition"
      >
        Request Free Estimate
      </a>

    </div>

  </div>
</section>

<!-- ================= WHAT WE DO ================= -->
<section class="bg-[#f4f8f6] py-32">
  <div class="max-w-7xl mx-auto px-6">

    <!-- TITLE -->
    <div class="max-w-4xl mb-16">
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-6">
        Safe & Professional Tree Removal Services
      </h2>

      <p class="text-slate-600 leading-relaxed text-lg">
        SF Tree Removal provides licensed and insured tree removal services
        designed to protect people, property, and surrounding structures across
        South Florida.
      </p>
    </div>

    <!-- BLOCKS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- BLOCK 1 -->
      <a
        href="/emergency-tree-removal/"
        class="group bg-white rounded-3xl p-8 transition
               hover:shadow-lg"
      >
        <h3 class="text-xl font-extrabold text-slate-900 mb-4">
          Emergency Tree Removal
        </h3>

        <p class="text-slate-600 leading-relaxed mb-6">
          24/7 emergency tree removal service for fallen trees, storm damage,
          and hazardous situations requiring immediate action.
        </p>

        <span class="inline-flex items-center gap-2 text-sm font-bold text-teal-700">
          Emergency Tree Removal
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-white">
            ↗
          </span>
        </span>
      </a>

      <!-- BLOCK 2 -->
      <a
        href="/certified-arborist/"
        class="group bg-white rounded-3xl p-8 transition
               hover:shadow-lg"
      >
        <h3 class="text-xl font-extrabold text-slate-900 mb-4">
          Certified Arborist Support
        </h3>

        <p class="text-slate-600 leading-relaxed mb-6">
          Professional assessments, permit guidance, and expert recommendations
          provided by certified arborists.
        </p>

        <span class="inline-flex items-center gap-2 text-sm font-bold text-teal-700">
          Certified Arborist Services
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-white">
            ↗
          </span>
        </span>
      </a>

      <!-- BLOCK 3 -->
      <a
        href="/tree-services/"
        class="group bg-white rounded-3xl p-8 transition
               hover:shadow-lg"
      >
        <h3 class="text-xl font-extrabold text-slate-900 mb-4">
          Residential & Commercial Tree Removal
        </h3>

        <p class="text-slate-600 leading-relaxed mb-6">
          Complete tree removal solutions for residential homes, commercial
          properties, and construction projects.
        </p>

        <span class="inline-flex items-center gap-2 text-sm font-bold text-teal-700">
          View All Tree Services
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-white">
            ↗
          </span>
        </span>
      </a>

      <!-- BLOCK 4 -->
      <a
        href="/areas/"
        class="group bg-white rounded-3xl p-8 transition
               hover:shadow-lg"
      >
        <h3 class="text-xl font-extrabold text-slate-900 mb-4">
          Tree Removal Across South Florida
        </h3>

        <p class="text-slate-600 leading-relaxed mb-6">
          Local tree removal experts serving Miami, Fort Lauderdale, Broward
          County, and surrounding South Florida communities.
        </p>

        <span class="inline-flex items-center gap-2 text-sm font-bold text-teal-700">
          Service Areas
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-white">
            ↗
          </span>
        </span>
      </a>

    </div>

  </div>
</section>

<!-- ================= WHEN TREE REMOVAL IS NEEDED ================= -->
<section class="bg-white py-32">
  <div class="max-w-7xl mx-auto px-6">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">

      <!-- LEFT: TEXT -->
      <div>

        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-8">
          When Do You Need Tree Removal?
        </h2>

        <p class="text-lg text-slate-600 leading-relaxed mb-10">
          Tree removal becomes necessary when trees pose a safety risk, suffer
          structural damage, or interfere with property use. Professional tree
          removal services help prevent accidents and protect homes, buildings,
          and surrounding areas.
        </p>

        <ul class="space-y-5 text-slate-700 leading-relaxed">

          <li>
            <strong class="text-slate-900">Dead or dying trees</strong> that can
            fall unexpectedly and cause serious damage.
          </li>

          <li>
            <strong class="text-slate-900">Storm-damaged or fallen trees</strong>
            requiring immediate or
            <a
              href="/emergency-tree-removal/"
              class="text-teal-700 font-semibold hover:underline"
            >
              emergency tree removal
            </a>
            services.
          </li>

          <li>
            <strong class="text-slate-900">Trees threatening homes, roofs, or
            power lines</strong> due to excessive growth or instability.
          </li>

          <li>
            <strong class="text-slate-900">Leaning or structurally unstable
            trees</strong> that show signs of root or trunk failure.
          </li>

          <li>
            <strong class="text-slate-900">Property development or land
            clearing</strong> projects requiring safe and controlled tree
            removal.
          </li>

        </ul>

      </div>

      <!-- RIGHT: IMAGE -->
      <div class="relative rounded-3xl overflow-hidden">

        <img
          src="/images/tree-removal/when-tree-removal-needed.jpg"
          alt="Hazardous tree removal near residential property in South Florida"
          class="w-full h-full object-cover"
          width="900"
          height="700"
          loading="lazy"
        />

        <!-- subtle overlay for brand tone -->
        <div class="absolute inset-0 bg-teal-900/10"></div>

      </div>

    </div>

  </div>
</section>

<!-- ================= EMERGENCY TREE REMOVAL ================= -->
<section class="bg-teal-800 py-32 text-white">
  <div class="max-w-7xl mx-auto px-6">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">

      <!-- LEFT: IMAGE -->
      <div class="relative rounded-3xl overflow-hidden">

        <img
          src="/images/tree-removal/emergency-tree-removal.jpg"
          alt="Emergency tree removal after storm damage in South Florida"
          class="w-full h-full object-cover"
          width="900"
          height="700"
          loading="lazy"
        />

        <!-- overlay -->
        <div class="absolute inset-0 bg-teal-900/30"></div>

        <!-- CAPTION -->
        <div
          class="absolute bottom-6 left-6 bg-white/90 text-slate-900
                 rounded-xl px-5 py-3 text-sm font-semibold"
        >
          Rapid storm response · 24/7 availability
        </div>

      </div>

      <!-- RIGHT: CONTENT -->
      <div class="max-w-xl">

        <!-- BADGE -->
        <span
          class="inline-block mb-8 px-4 py-1 text-xs font-bold tracking-widest
                 border border-dashed border-white/60 rounded-full"
        >
          24/7 EMERGENCY RESPONSE
        </span>

        <!-- TITLE -->
        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight mb-8">
          Emergency Tree Removal
          <br class="hidden sm:block" />
          in South Florida
        </h2>

        <!-- TEXT -->
        <p class="text-white/90 text-lg leading-relaxed mb-10">
          Storm damage, fallen trees, and hazardous situations require immediate,
          professional action. Our emergency tree removal teams are available
          24/7 to secure your property and restore safety as quickly as possible.
        </p>

        <!-- CTA -->
        <div class="flex flex-wrap gap-6">
          <a
            href="/contact-us/"
            class="inline-flex items-center gap-4 rounded-full
                   bg-white px-10 py-4 text-teal-900 font-extrabold
                   hover:bg-slate-100 transition"
          >
            Request Emergency Service
          </a>


          <a
            href="/emergency-tree-removal/"
            class="inline-flex items-center gap-4 rounded-full
                   border border-white/70 px-10 py-4 text-white font-bold
                   hover:bg-white/10 transition"
          >
            Emergency Tree Removal
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/15">
              ↗
            </span>
          </a>

        </div>

      </div>

    </div>

  </div>
</section>

<!-- ================= EQUIPMENT & EXPERTISE ================= -->
<section class="bg-white py-32">
  <div class="max-w-7xl mx-auto px-6">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-start">

      <!-- LEFT: CONTENT -->
      <div>

        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-8">
          Modern Equipment & Experienced Tree Removal Experts
        </h2>

        <p class="text-lg text-slate-600 leading-relaxed mb-10">
          Safe tree removal requires more than cutting tools. Our licensed and
          insured tree removal crews combine modern equipment with hands-on
          experience to handle complex removals efficiently and safely across
          South Florida.
        </p>

        <p class="text-slate-600 leading-relaxed mb-10">
          Every tree removal project is planned carefully to protect nearby
          structures, landscaping, and utilities while complying with local
          regulations and industry safety standards.
        </p>

        <!-- KEY POINTS -->
        <ul class="space-y-4 text-slate-700 leading-relaxed">
          <li>
            <strong class="text-slate-900">Cranes and lift equipment</strong>
            for controlled removal of large or hazardous trees.
          </li>
          <li>
            <strong class="text-slate-900">Precision cutting tools</strong>
            designed to minimize risk and property impact.
          </li>
          <li>
            <strong class="text-slate-900">Experienced tree removal crews</strong>
            trained to handle residential and commercial projects.
          </li>
          <li>
            <strong class="text-slate-900">Strict safety protocols</strong>
            following local regulations and best industry practices.
          </li>
        </ul>

      </div>

      <!-- RIGHT: TRUST BLOCK -->
      <div class="bg-[#f4f8f6] rounded-3xl p-10">

        <!-- IMAGE -->
        <div class="mb-8 rounded-2xl overflow-hidden">
          <img
            src="/images/tree-removal/professional-tree-removal-equipment.jpg"
            alt="Professional tree removal equipment including crane and lift in South Florida"
            class="w-full h-56 object-cover"
            width="600"
            height="400"
            loading="lazy"
          />
        </div>

        <!-- TITLE -->
        <h3 class="text-2xl font-extrabold text-slate-900 mb-6">
          Why Professional Equipment Matters
        </h3>

        <!-- TEXT -->
        <p class="text-slate-600 leading-relaxed mb-6">
          Tree removal without proper equipment increases the risk of injury,
          property damage, and costly mistakes. Using professional-grade cranes,
          lifts, and safety systems allows our team to remove trees with precision
          and control.
        </p>

        <p class="text-slate-600 leading-relaxed">
          Combined with experienced operators and proven procedures, our
          equipment enables safe tree removal even in tight spaces, near
          buildings, or around power lines.
        </p>

      </div>

    </div>

  </div>
</section>

<!-- ================= LOCAL SEO ================= -->
<section class="bg-[#f4f8f6] py-32">
  <div class="max-w-7xl mx-auto px-6">

    <!-- HEADER -->
    <div class="max-w-4xl mb-16">
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-6">
        Tree Removal Services Across South Florida
      </h2>

      <p class="text-lg text-slate-600 leading-relaxed">
        SF Tree Removal provides professional tree removal services throughout
        South Florida. Our licensed and insured crews serve major cities and
        counties, delivering safe, compliant solutions for residential and
        commercial properties.
      </p>
    </div>

    <!-- LOCATIONS GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- MIAMI -->
      <a
        href="/areas/miami-tree-removal/"
        class="group bg-white rounded-3xl p-8 transition hover:shadow-lg"
      >
        <h3 class="text-xl font-extrabold text-slate-900 mb-3">
          Miami Tree Removal
        </h3>
        <p class="text-slate-600 mb-6">
          Emergency and scheduled tree removal services for residential and
          commercial properties across Miami.
        </p>
        <span class="inline-flex items-center gap-2 text-sm font-bold text-teal-700">
          Miami Tree Removal Services
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
        </span>
      </a>

      <!-- FORT LAUDERDALE -->
      <a
        href="/areas/fort-lauderdale-tree-removal/"
        class="group bg-white rounded-3xl p-8 transition hover:shadow-lg"
      >
        <h3 class="text-xl font-extrabold text-slate-900 mb-3">
          Fort Lauderdale Tree Removal
        </h3>
        <p class="text-slate-600 mb-6">
          Professional tree removal, storm cleanup, and permit-ready services in
          Fort Lauderdale.
        </p>
        <span class="inline-flex items-center gap-2 text-sm font-bold text-teal-700">
          Fort Lauderdale Tree Removal
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
        </span>
      </a>

      <!-- HOLLYWOOD -->
      <a
        href="/areas/hollywood-tree-service/"
        class="group bg-white rounded-3xl p-8 transition hover:shadow-lg"
      >
        <h3 class="text-xl font-extrabold text-slate-900 mb-3">
          Hollywood Tree Service
        </h3>
        <p class="text-slate-600 mb-6">
          Complete tree service solutions for homeowners and businesses in
          Hollywood, Florida.
        </p>
        <span class="inline-flex items-center gap-2 text-sm font-bold text-teal-700">
          Hollywood Tree Service
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
        </span>
      </a>

      <!-- PEMBROKE PINES -->
      <a
        href="/areas/pembroke-pines-tree-removal/"
        class="group bg-white rounded-3xl p-8 transition hover:shadow-lg"
      >
        <h3 class="text-xl font-extrabold text-slate-900 mb-3">
          Pembroke Pines Tree Removal
        </h3>
        <p class="text-slate-600 mb-6">
          Fast response tree removal services tailored to local residential
          communities.
        </p>
        <span class="inline-flex items-center gap-2 text-sm font-bold text-teal-700">
          Pembroke Pines Tree Removal
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
        </span>
      </a>

      <!-- BOCA RATON -->
      <a
        href="/areas/boca-raton-tree-removal/"
        class="group bg-white rounded-3xl p-8 transition hover:shadow-lg"
      >
        <h3 class="text-xl font-extrabold text-slate-900 mb-3">
          Boca Raton Tree Removal
        </h3>
        <p class="text-slate-600 mb-6">
          High-end tree removal and certified arborist services in Boca Raton.
        </p>
        <span class="inline-flex items-center gap-2 text-sm font-bold text-teal-700">
          Boca Raton Tree Removal
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
        </span>
      </a>

      <!-- BROWARD COUNTY -->
      <a
        href="/areas/broward-county-tree-removal/"
        class="group bg-white rounded-3xl p-8 transition hover:shadow-lg"
      >
        <h3 class="text-xl font-extrabold text-slate-900 mb-3">
          Broward County Tree Removal
        </h3>
        <p class="text-slate-600 mb-6">
          County-wide tree removal coverage including emergency and scheduled
          services.
        </p>
        <span class="inline-flex items-center gap-2 text-sm font-bold text-teal-700">
          Broward County Tree Removal
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-700 text-white">↗</span>
        </span>
      </a>

    </div>

    <!-- BOTTOM CTA -->
    <div class="mt-20 text-center">
      <a
        href="/areas/"
        class="inline-flex items-center gap-4 rounded-full
               bg-teal-700 px-10 py-4 text-white font-bold
               hover:bg-teal-800 transition"
      >
        View All Service Areas
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white/15">
          ↗
        </span>
      </a>
    </div>

  </div>
</section>

<!-- ================= FAQ ================= -->
<section class="bg-white py-28">
  <div class="max-w-7xl mx-auto px-6">

    <!-- HEADER -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">
        Tree Removal FAQs
      </h2>
      <p class="text-lg text-slate-600">
        Answers to common questions about professional tree removal services in
        South Florida.
      </p>
    </div>

    <!-- FAQ LIST -->
    <div class="max-w-3xl mx-auto divide-y divide-slate-200">

      <!-- ITEM -->
      <div class="py-6">
        <h3 class="text-lg font-extrabold text-slate-900 mb-2">
          How much does tree removal cost in South Florida?
        </h3>
        <p class="text-slate-600 leading-relaxed">
          Tree removal pricing depends on tree size, location, accessibility,
          and job complexity. Emergency situations or trees near structures may
          require specialized equipment. Free estimates are available.
        </p>
      </div>

      <!-- ITEM -->
      <div class="py-6">
        <h3 class="text-lg font-extrabold text-slate-900 mb-2">
          Do I need a permit to remove a tree?
        </h3>
        <p class="text-slate-600 leading-relaxed">
          Permit requirements vary by city and county. Our team can help you
          understand local regulations and assist with the permitting process
          when required.
        </p>
      </div>

      <!-- ITEM -->
      <div class="py-6">
        <h3 class="text-lg font-extrabold text-slate-900 mb-2">
          Do you offer emergency tree removal services?
        </h3>
        <p class="text-slate-600 leading-relaxed">
          Yes. We provide 24/7 emergency tree removal services for storm damage,
          fallen trees, and hazardous situations across South Florida.
        </p>
      </div>

      <!-- ITEM -->
      <div class="py-6">
        <h3 class="text-lg font-extrabold text-slate-900 mb-2">
          Is your tree removal service licensed and insured?
        </h3>
        <p class="text-slate-600 leading-relaxed">
          Absolutely. SF Tree Removal is fully licensed and insured, meeting
          professional safety and liability standards for every project.
        </p>
      </div>

      <!-- ITEM -->
      <div class="py-6">
        <h3 class="text-lg font-extrabold text-slate-900 mb-2">
          What happens to the debris after tree removal?
        </h3>
        <p class="text-slate-600 leading-relaxed">
          Our crew completes full cleanup after tree removal, including debris
          hauling. Optional services such as stump grinding are also available.
        </p>
      </div>

    </div>

    <!-- CTA -->
    <div class="mt-14 text-center">
      <a
        href="/contact-us/"
        class="inline-flex items-center gap-3 rounded-full
               bg-teal-700 px-8 py-3 text-white font-bold
               hover:bg-teal-800 transition"
      >
        Request a Free Estimate
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/15">
          ↗
        </span>
      </a>
    </div>

  </div>
</section>

  <!-- ================= FINAL CTA ================= -->
  <section class="bg-teal-800 py-32 text-white">
    <div class="max-w-7xl mx-auto px-6 text-center">

      <h2 class="text-4xl md:text-5xl font-extrabold mb-8">
        Need Professional Tree Removal Service?
      </h2>

      <p class="max-w-3xl mx-auto text-lg text-white/90">
        Contact SF Tree Removal today for safe, professional tree removal across
        South Florida.
      </p>

      <div class="mt-12 flex justify-center gap-6">
        <a
          href="/contact-us/"
          class="inline-flex items-center gap-4 rounded-full
                 bg-white px-10 py-4 text-teal-800 font-extrabold"
        >
          Request a Free Estimate
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
