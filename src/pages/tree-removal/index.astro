---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import { MapPin, ArrowRight } from "lucide-astro";

const cities = [
  { slug: "miami", name: "Miami", county: "Miami-Dade County" },
  { slug: "fort-lauderdale", name: "Fort Lauderdale", county: "Broward County" },
  { slug: "west-palm-beach", name: "West Palm Beach", county: "Palm Beach County" },
  { slug: "coral-springs", name: "Coral Springs", county: "Broward County" },
  { slug: "plantation", name: "Plantation", county: "Broward County" },
  { slug: "pompano-beach", name: "Pompano Beach", county: "Broward County" },
  { slug: "deerfield-beach", name: "Deerfield Beach", county: "Broward County" },
  { slug: "boca-raton", name: "Boca Raton", county: "Palm Beach County" },
  { slug: "hollywood", name: "Hollywood", county: "Broward County" },
  { slug: "delray-beach", name: "Delray Beach", county: "Palm Beach County" },
];
---

<MainLayout
  title="Tree Removal Services by City | SF Tree Removal"
  description="Find professional tree removal services in Miami, Fort Lauderdale, West Palm Beach, and throughout South Florida.">
  <Header />

  <main class="bg-white">
    <!-- ============================================== -->
    <!-- HERO SEKCIJA - PROFESSIONAL HEADER -->
    <!-- ============================================== -->
    <section class="relative isolate overflow-hidden pt-28 pb-20 lg:pt-36 lg:pb-28 px-4 sm:px-8 lg:min-h-[88vh] lg:flex lg:items-center bg-slate-900">
      <!-- Video pozadina -->
      <div class="absolute inset-0 -z-20">
        <video
          autoplay muted loop playsinline preload="metadata"
          poster="/videos/hero-tree-service-poster.webp"
          class="h-full w-full object-cover"
        >
          <source src="/videos/hero-optimized.webm" type="video/webm" media="(min-width: 640px) and (prefers-reduced-motion: no-preference)" />
          <source src="/videos/hero-optimized.mp4" type="video/mp4" media="(min-width: 640px) and (prefers-reduced-motion: no-preference)" />
        </video>
      </div>
      <!-- Tamni sloj radi čitljivosti -->
      <div class="absolute inset-0 -z-10 bg-slate-950/45"></div>

      <div class="mx-auto max-w-[1320px] w-full relative z-10">
        <div class="text-center max-w-3xl mx-auto">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 backdrop-blur-md px-3 py-1.5 shadow-soft mb-8">
            <span class="text-xs font-bold text-green-400">🌳 South Florida Service</span>
          </div>

          <!-- Heading -->
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tighter text-white leading-tight mb-6">
            Professional Tree Removal Across South Florida
          </h1>

          <!-- Subheading -->
          <p class="text-lg lg:text-xl leading-relaxed text-slate-200 mb-10 max-w-2xl mx-auto">
            Licensed, insured contractors serving Miami-Dade, Broward, and Palm Beach counties. Free estimates, emergency response available 24/7.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="#cities" class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-green-500 text-white font-bold text-sm hover:bg-green-600 transition-all shadow-xl hover:shadow-2xl">
              Find Your City <span class="text-lg">→</span>
            </a>
            <a href="/#quote" class="inline-flex items-center gap-2 px-8 py-3 rounded-xl border border-white/30 bg-white/10 backdrop-blur text-white font-bold text-sm hover:bg-white/20 transition-all">
              Get Free Estimate
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- CITIES GRID -->
    <!-- ============================================== -->
    <section class="py-16 lg:py-24 px-4 sm:px-8" id="cities">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-3xl font-bold text-slate-900 mb-12">Select Your City</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {cities.map((city) => (
            <a
              href={`/tree-removal/${city.slug}`}
              class="group relative rounded-2xl border border-slate-200 bg-white p-6 hover:border-green-300 hover:shadow-lg transition-all duration-300"
            >
              <div class="flex items-start justify-between mb-3">
                <div>
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-green-600 transition-colors">
                    {city.name}
                  </h3>
                  <p class="text-xs text-slate-500 mt-1 flex items-center gap-1">
                    <MapPin size={14} />
                    {city.county}
                  </p>
                </div>
                <ArrowRight size={20} class="text-slate-300 group-hover:text-green-600 group-hover:translate-x-1 transition-all" />
              </div>
              <p class="text-sm text-slate-600">
                Tree removal, trimming & stump grinding in {city.name}. Free estimates available.
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- WHY CHOOSE US -->
    <!-- ============================================== -->
    <section class="py-16 lg:py-24 px-4 sm:px-8 bg-slate-50">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-3xl font-bold text-center text-slate-900 mb-12">
          Why SF Tree Removal?
        </h2>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="font-bold text-lg text-slate-900 mb-3">✓ Licensed & Insured</h3>
            <p class="text-slate-600">All contractors are fully licensed, certified, and insured for your protection.</p>
          </div>
          <div>
            <h3 class="font-bold text-lg text-slate-900 mb-3">✓ 24/7 Emergency Service</h3>
            <p class="text-slate-600">Fallen trees? We respond immediately to emergency situations day or night.</p>
          </div>
          <div>
            <h3 class="font-bold text-lg text-slate-900 mb-3">✓ Free Estimates</h3>
            <p class="text-slate-600">No hidden fees. We provide upfront, transparent pricing for all projects.</p>
          </div>
          <div>
            <h3 class="font-bold text-lg text-slate-900 mb-3">✓ Expert Professionals</h3>
            <p class="text-slate-600">Years of experience in residential and commercial tree care.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- SERVICE AREAS MAP TEXT -->
    <!-- ============================================== -->
    <section class="py-16 lg:py-24 px-4 sm:px-8">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-bold text-slate-900 mb-8">Serving All of South Florida</h2>
        
        <div class="space-y-6 text-slate-700 leading-relaxed">
          <p>
            SF Tree Removal is your trusted partner for professional tree services throughout South Florida. We serve Miami-Dade County, Broward County, and Palm Beach County with licensed, insured contractors ready to handle any tree removal, trimming, or stump grinding project.
          </p>
          
          <p>
            Whether you need emergency tree removal, routine maintenance trimming, or complete stump grinding, our experienced team is here to help. We understand the unique challenges of Florida's climate and landscape, and we're equipped to handle everything from small residential projects to large commercial jobs.
          </p>

          <p>
            <strong>Same-day estimates available.</strong> We offer free consultations and transparent pricing with no hidden fees. Our goal is to provide reliable, professional tree services that you can trust.
          </p>

          <div class="mt-8 p-6 rounded-xl bg-green-50 border border-green-200">
            <p class="font-bold text-green-900 mb-2">Ready to get started?</p>
            <p class="text-sm text-green-800">
              Select your city above or <a href="/" class="font-bold hover:underline">submit a request on our main page</a> to schedule your free estimate.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>
