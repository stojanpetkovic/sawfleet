---
export const prerender = true;
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import FormDisclaimer from "../../components/FormDisclaimer.astro";
import { supabase } from "../../lib/supabase";
import { CITIES_DATA } from "../../lib/citiesData";
import { MapPin, CheckCircle2, Trees, Users, Award, Zap } from "lucide-astro";

// Generate static paths za prerender
export function getStaticPaths() {
  return CITIES_DATA.map(city => ({
    params: { city: city.slug },
  }));
}

const { city } = Astro.params;
const cityData = CITIES_DATA.find(c => c.slug === city);

if (!cityData) {
  return Astro.redirect('/');
}

// Učitavamo teritorije za dropdown
const { data: territories } = await supabase
  .from('service_territories')
  .select('*')
  .order('name', { ascending: true });

// Local schema markup za SEO
const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `SF Tree Removal - ${cityData.name}`,
  "description": cityData.description,
  "url": `https://www.sftreeremoval.com/tree-removal/${city}`,
  "areaServed": {
    "@type": "City",
    "name": cityData.name,
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "FL",
      "addressCountry": "US"
    }
  },
  "serviceType": ["Tree Removal", "Tree Trimming", "Stump Grinding"],
  "image": `https://www.sftreeremoval.com${cityData.image}`,
  "telephone": "(954) 555-0000",
  "priceRange": "$$$",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "247"
  }
};
---

<MainLayout
  title={`${cityData.keyword} | SF Tree Removal`}
  description={cityData.description}>

  <Header />
  
  <main class="bg-white">
    <!-- ============================================== -->
    <!-- HERO SEKCIJA — GRAD FOKUS SA VIDEOM -->
    <!-- ============================================== -->
    <section class="relative isolate overflow-hidden pt-28 pb-20 lg:pt-36 lg:pb-28 px-4 sm:px-8 lg:min-h-[88vh] lg:flex lg:items-center bg-slate-900">
      <!-- Video pozadina -->
      <div class="absolute inset-0 -z-20">
        <video
          autoplay muted loop playsinline preload="metadata"
          poster="/videos/hero-tree-service-poster.webp"
          class="h-full w-full object-cover"
        >
          <source src="/videos/hero-optimized.webm" type="video/webm" media="(min-width: 640px) and (prefers-reduced-motion: no-preference)" />
          <source src="/videos/hero-optimized.mp4" type="video/mp4" media="(min-width: 640px) and (prefers-reduced-motion: no-preference)" />
        </video>
      </div>
      <!-- Tamni sloj radi čitljivosti teksta -->
      <div class="absolute inset-0 -z-10 bg-slate-950/45"></div>

      <div class="mx-auto max-w-[1320px] grid lg:grid-cols-2 gap-12 items-center relative z-10 w-full">
        <!-- LEVO: Tekstualni deo -->
        <div class="max-w-[640px] font-sans selection:bg-green-500/30 selection:text-white">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 backdrop-blur-md px-3 py-1.5 shadow-soft mb-6">
            <MapPin size={14} class="text-green-400" />
            <span class="text-xs font-bold text-white">{cityData.county} County</span>
          </div>

          <!-- Heading -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tighter text-white leading-tight">
            Tree Removal in {cityData.name}
          </h1>

          <p class="mt-6 text-lg leading-relaxed text-slate-200">
            Professional tree removal, trimming, and stump grinding services in {cityData.name}, {cityData.county} County. Licensed contractors, emergency response available.
          </p>

          <!-- Features -->
          <div class="mt-8 space-y-3">
            <div class="flex items-start gap-3">
              <CheckCircle2 size={20} class="text-green-400 shrink-0 mt-0.5" />
              <span class="text-sm text-slate-300">Licensed & insured professionals</span>
            </div>
            <div class="flex items-start gap-3">
              <CheckCircle2 size={20} class="text-green-400 shrink-0 mt-0.5" />
              <span class="text-sm text-slate-300">24/7 emergency tree removal</span>
            </div>
            <div class="flex items-start gap-3">
              <CheckCircle2 size={20} class="text-green-400 shrink-0 mt-0.5" />
              <span class="text-sm text-slate-300">Free estimates, no obligation</span>
            </div>
          </div>

          <!-- CTA Button -->
          <div class="mt-10">
            <a href="#quote" class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-green-500 text-white font-bold text-sm hover:bg-green-600 transition-all shadow-xl hover:shadow-2xl">
              Get Free Estimate <span class="text-lg">→</span>
            </a>
          </div>
        </div>

        <!-- DESNO: Form (kao na index) -->
        <div class="w-full max-w-[520px] lg:ml-auto rounded-2xl sm:rounded-3xl border border-white/40 bg-white/95 backdrop-blur-xl p-6 sm:p-8 font-sans shadow-2xl ring-1 ring-black/5 relative overflow-hidden">
          <!-- Accent bar -->
          <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-green-500 via-emerald-500 to-green-500"></div>

          <!-- Decorative glow -->
          <div class="absolute top-0 right-0 -mr-16 -mt-16 w-32 h-32 bg-green-500/10 blur-[50px] rounded-full pointer-events-none"></div>

          <!-- Header -->
          <div class="border-b border-slate-200 pb-5 mb-6 relative">
            <div class="flex items-center justify-between gap-3">
              <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-700">
                // Free Quote
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 border border-green-200 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wider text-green-700">
                <span class="h-1.5 w-1.5 rounded-full bg-green-500 animate-pulse"></span>
                No Obligation
              </span>
            </div>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">
              Request a Free Estimate
            </h2>
            <p class="mt-1 text-xs text-slate-500">
              Serving {cityData.name} and {cityData.county} County
            </p>
          </div>

          <!-- Form -->
          <form id="leadForm" class="space-y-5 relative">
            <!-- Location (Hidden, auto-filled) -->
            <input type="hidden" name="city" value={cityData.name} />
            <input type="hidden" name="county" value={cityData.county} />

            <!-- County Dropdown -->
            <div>
              <label for="county" class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">
                Your County
              </label>
              <div class="relative">
                <select id="county" name="county" required value={cityData.county} class="h-12 w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none transition-all focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white">
                  {territories?.map((t) => (
                    <option value={t.name} selected={t.name === cityData.county}>{t.name}</option>
                  ))}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-slate-400">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </div>
              </div>
            </div>

            <!-- Phone + Email -->
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="phone" class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Phone Number</label>
                <input id="phone" name="phone" type="tel" required placeholder="(555) 123-4567" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white placeholder:text-slate-400"/>
              </div>
              <div>
                <label for="email" class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Email (Optional)</label>
                <input id="email" name="email" type="email" placeholder="you@email.com" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white placeholder:text-slate-400"/>
              </div>
            </div>

            <!-- Description -->
            <div>
              <label for="details" class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Project Details</label>
              <textarea id="details" name="details" rows="3" required placeholder="Describe the tree, location on property, urgency..." class="min-h-[100px] w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white placeholder:text-slate-400"></textarea>
            </div>

            <!-- Terms Disclaimer -->
            <FormDisclaimer />

            <!-- Submit Button -->
            <button type="submit" id="submitBtn" class="mt-6 flex h-14 w-full items-center justify-center gap-2 rounded-xl bg-green-500 text-sm font-bold text-white transition-all hover:bg-green-600 active:scale-[0.98] shadow-[0_8px_24px_-6px_rgba(34,197,94,0.5)] hover:shadow-[0_12px_28px_-6px_rgba(34,197,94,0.6)]">
              Request Free Estimate →
            </button>
          </form>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- WHY CHOOSE US SEKCIJA -->
    <!-- ============================================== -->
    <section class="py-16 lg:py-24 px-4 sm:px-8 bg-slate-50">
      <div class="mx-auto max-w-[1320px]">
        <div class="grid lg:grid-cols-4 gap-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 lg:p-8">
            <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center mb-4">
              <Award size={24} class="text-green-600" />
            </div>
            <h3 class="font-bold text-slate-900 mb-2">Licensed & Certified</h3>
            <p class="text-sm text-slate-600">All contractors verified and fully insured</p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 lg:p-8">
            <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center mb-4">
              <Zap size={24} class="text-green-600" />
            </div>
            <h3 class="font-bold text-slate-900 mb-2">Fast Response</h3>
            <p class="text-sm text-slate-600">24/7 emergency tree removal available</p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 lg:p-8">
            <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center mb-4">
              <Users size={24} class="text-green-600" />
            </div>
            <h3 class="font-bold text-slate-900 mb-2">Expert Team</h3>
            <p class="text-sm text-slate-600">Experienced professionals in tree care</p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 lg:p-8">
            <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center mb-4">
              <Trees size={24} class="text-green-600" />
            </div>
            <h3 class="font-bold text-slate-900 mb-2">Eco-Friendly</h3>
            <p class="text-sm text-slate-600">Safe disposal and responsible practices</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- FAQ SEKCIJA -->
    <!-- ============================================== -->
    <section class="py-16 lg:py-24 px-4 sm:px-8">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl lg:text-4xl font-bold text-center text-slate-900 mb-12">
          Tree Removal FAQs for {cityData.name}
        </h2>

        <div class="space-y-4">
          <details class="group rounded-xl border border-slate-200 bg-white p-6 hover:border-green-300 transition-colors">
            <summary class="flex cursor-pointer items-center justify-between font-bold text-slate-900">
              How much does tree removal cost in {cityData.name}?
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed">
              Costs vary based on tree size, location, and complexity. We provide free estimates for all projects in {cityData.name} and surrounding areas.
            </p>
          </details>

          <details class="group rounded-xl border border-slate-200 bg-white p-6 hover:border-green-300 transition-colors">
            <summary class="flex cursor-pointer items-center justify-between font-bold text-slate-900">
              Do you provide emergency tree removal in {cityData.name}?
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed">
              Yes! We offer 24/7 emergency tree removal services for fallen or dangerous trees in {cityData.name} and all of {cityData.county} County.
            </p>
          </details>

          <details class="group rounded-xl border border-slate-200 bg-white p-6 hover:border-green-300 transition-colors">
            <summary class="flex cursor-pointer items-center justify-between font-bold text-slate-900">
              Are your contractors licensed and insured?
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed">
              Absolutely. All our contractors serving {cityData.name} are fully licensed, insured, and regularly inspected to ensure quality and safety.
            </p>
          </details>

          <details class="group rounded-xl border border-slate-200 bg-white p-6 hover:border-green-300 transition-colors">
            <summary class="flex cursor-pointer items-center justify-between font-bold text-slate-900">
              How quickly can you schedule a tree removal?
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed">
              For non-emergency removals, we typically schedule within 3-5 business days. Emergency services are available immediately.
            </p>
          </details>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>

<!-- JSON-LD Schema markup za SEO -->
<script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

<script>
  import { supabase } from "../../lib/supabase";

  const form = document.getElementById('leadForm') as HTMLFormElement;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = {
      county: formData.get('county'),
      phone: formData.get('phone'),
      email: formData.get('email') || null,
      details: formData.get('details'),
      city: formData.get('city'),
      source: 'city_landing',
    };

    btn.disabled = true;
    btn.innerHTML = 'Submitting...';

    try {
      const { error } = await supabase.from('leads').insert([data]);
      if (error) throw error;

      btn.innerHTML = 'Request Submitted! ✓';
      form.reset();
      setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = 'Request Free Estimate →';
      }, 3000);
    } catch (error) {
      alert("Error: " + (error?.message || "Unable to submit request"));
      btn.disabled = false;
      btn.innerHTML = 'Request Free Estimate →';
    }
  });
</script>
