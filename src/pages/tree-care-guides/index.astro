---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import Photo from "../../components/Photo.astro";
import SplitSection from "../../components/SplitSection.astro";
import { guides } from "../../config/guides";

const fmt = new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeZone: "UTC" });
---

<BaseLayout
  title="Tree Care Guides for South Florida Homeowners"
  pageType="CollectionPage"
  description="Practical guides for South Florida homeowners: tree removal cost, permits, hurricane preparation and when to call an arborist."
>
  <PageHero
    badge="BLOG"
    title="Tree Care Guides for South Florida"
    lead="Plain-language advice on costs, permits, storms and tree health, written for homeowners in Miami-Dade, Broward and Palm Beach County."
    actions={false}
  />

  <section class="bg-secondary-50 py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3" role="list">
        {
          guides.map((g) => (
            <li>
              <a href={`/tree-care-guides/${g.slug}/`} class="card group flex h-full flex-col">
                <div class="aspect-[16/10] overflow-hidden"><Photo name={g.image} class="transition duration-500 group-hover:scale-105" sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw" /></div>
                <div class="flex flex-1 flex-col p-6">
                  <p class="text-sm text-secondary-500">
                    <time datetime={g.published}>{fmt.format(new Date(g.published))}</time> · {g.readMinutes} min read
                  </p>
                  <h2 class="mt-2 font-heading text-xl font-semibold text-secondary-900 group-hover:text-primary-700">{g.title}</h2>
                  <p class="mt-3 flex-1 text-secondary-600">{g.description}</p>
                  <span class="mt-5 inline-flex items-center gap-2 font-semibold text-primary-700">Read guide <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <SplitSection
    topper="How we write them"
    title="Guides You Can Check"
    image="climber-rope"
    html={`<p>Each guide is written for South Florida homeowners, dated, and checked against official sources such as county and city pages, Florida statutes and University of Florida research. Permit rules change, so we link to the source and tell you to confirm with your city before you cut.</p><p>The guides are general information, not legal advice. If you need a tree removed or checked, <a href="/contact-us/">request a free estimate</a>.</p>`}
  />

  <CtaBand />
</BaseLayout>
