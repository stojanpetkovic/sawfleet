---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileNav from "../components/layout/MobileNav.astro";
const sections = [
  ["Information we collect", "We collect contact information (name, email, phone), property location and details, service requests, account information, payment data (processed securely by third parties), equipment details for fleet operators, uploaded photos and documents, communication records, and technical data (IP address, browser type, device information, referring URLs). This information is collected when you visit our website, create an account, submit service requests, or interact with our platform."],
  ["How we use information", "We use your information to operate and improve the dispatch platform, match homeowners with service providers, process service requests, provide customer support, send service-related notifications, prevent fraud and abuse, comply with legal obligations, and generate analytics. We may also contact you about updates to our services. We do not sell personal information to third parties."],
  ["How information is shared", "Service request details (location, property description, contact information) are shared with contractors and fleet operators in your selected service area to fulfill your request. Your listing information (if you are a service provider) may be displayed to homeowners, administrators and support staff. We may share information with third-party service providers who assist with hosting, payment processing, email delivery, analytics, SMS communications and customer support. We comply with all applicable laws when sharing information."],
  ["Permit-based project leads", "Some project leads shown to registered contractors are derived from publicly available government building and tree-removal permit filings, including the property address and, where included in the public filing, the property owner's name, phone number and email address as recorded by the issuing jurisdiction. This information is a matter of public record and is not obtained through hacking, scraping of private accounts, or unauthorized access. Location and permit-type details are shown to the public as a preview; full owner contact details are shown only to registered, approved contractors who choose to access a specific lead. Property owners who wish to have their information removed from these listings may contact us through our Support page."],
  ["Cookies and tracking", "Our website uses cookies and similar tracking technologies to remember preferences, analyze usage patterns, provide personalized experiences and enable core functionality. You can control cookie preferences through your browser settings. Essential cookies cannot be disabled as they are necessary for platform operation. We use Google Analytics to understand how visitors use our site."],
  ["SMS and communications", "When you provide your phone number and consent, we may send you SMS messages regarding your service request status, appointment reminders, account notifications or promotional offers. Message and data rates may apply. Consent is not required to use our service, and you can opt out of promotional messages by replying STOP to any message. Service-related messages may continue even if you opt out of promotional messages."],
  ["Your California privacy rights", "California residents have the right to know what personal information is collected, used, and shared. You can request access to, deletion of, or opt-out of the sale or sharing of your personal information. To submit a request, use our Support page. We will verify your identity and respond within 45 days. California law provides exemptions for certain information, including employee and B2B data."],
  ["Your Florida privacy rights", "Florida residents have rights under Florida's privacy laws regarding personal information we maintain. You can request access to information we hold about you and request correction of inaccurate data. You may opt out of marketing communications. We will not discriminate against you for exercising your privacy rights, though we may offer different pricing or features for data sharing choices."],
  ["Retention and security", "We retain personal information for as long as necessary to provide services, resolve disputes and comply with legal requirements. For Florida and California, we retain information according to applicable law timelines. We use industry-standard security measures including encryption, secure servers and restricted access. However, no online system is completely secure, and we cannot guarantee absolute security of your information."],
  ["Third-party links", "Our website may contain links to third-party websites. We are not responsible for their privacy practices or content. We recommend reviewing their privacy policies before providing your information."],
  ["Children's privacy", "SF Tree Removal services are intended for adults only and are not directed to children under 13. We do not knowingly collect personal information from children under 13. If we become aware of such collection, we will delete it promptly."],
  ["International transfers", "If you access our services from outside the United States, your information may be transferred to and stored in the United States, where data protection laws may differ from your country of residence."],
  ["Changes to this policy", "We may update this privacy policy at any time by posting a revised version with an updated effective date. Your continued use of the platform after changes constitutes acceptance of the revised policy. We encourage you to review this policy periodically."],
  ["Contact us", "Questions about our privacy practices or to submit a data request, please contact us through our Support page or email the address provided there."],
];
---
<MainLayout title="Privacy Policy | SF Tree Removal" description="Privacy practices for the SF Tree Removal dispatch platform."><Header /><main class="bg-white pt-28 lg:pt-32"><section class="px-4 py-16 sm:px-8 lg:py-20"><div class="mx-auto max-w-3xl"><span class="text-[10px] font-mono font-bold uppercase tracking-[0.22em] text-green-700">// Legal</span><h1 class="mt-4 text-4xl font-bold tracking-tighter text-slate-950 sm:text-5xl">Privacy Policy</h1><p class="mt-4 text-sm text-slate-500">Effective July 21, 2026</p><p class="mt-8 text-base leading-relaxed text-slate-600">This policy explains how SF Tree Removal collects, uses and shares information when you use our website, request dispatch assistance or access a platform account.</p><div class="mt-12 space-y-10">{sections.map(([title, text]) => <section><h2 class="text-lg font-bold text-slate-950">{title}</h2><p class="mt-3 text-sm leading-7 text-slate-600">{text}</p></section>)}</div><div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-sm text-slate-600">Questions or privacy requests can be initiated through our <a href="/support" class="font-bold text-green-700">Support page</a>.</div></div></section></main><Footer /><MobileNav /></MainLayout>
