---
export const prerender = false;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import ContractorBottomNav from "../components/layout/ContractorBottomNav.astro";
import Footer from "../components/layout/Footer.astro";
import FormDisclaimer from "../components/FormDisclaimer.astro";
import { supabase } from "../lib/supabase";
import { supabaseAdmin } from "../lib/supabaseAdmin";
import { ArrowRight, BadgeCheck, BriefcaseBusiness, CheckCircle2, ClipboardCheck, Coins, Eye, LayoutDashboard, Lock, MapPinned, PhoneCall, ShieldCheck, UserCheck } from "lucide-astro";

// 1. Učitavamo teritorije iz baze za formu
const { data: territories } = await supabase
  .from('service_territories')
  .select('*')
  .order('name', { ascending: true });

// 2. Teaser sa poslednjih kvalifikovanih permit lidova (bez kontakt podataka —
// koristimo supabaseAdmin da zaobiđemo RLS jer ova strana treba da radi i bez
// prijave, isti obrazac kao contractors/[slug].astro).
const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString();
const { data: permitTeasers } = await (supabaseAdmin ?? supabase)
  .from('permit_leads')
  .select('jurisdiction, permit_type, permit_description, permit_date')
  .eq('permit_status', 'qualified')
  .is('archived_at', null)
  .gte('discovered_at', thirtyDaysAgo)
  .order('discovered_at', { ascending: false })
  .limit(6);

// 3. Live-hero stat + activity ticker: how many real opportunities exist
// right now, and a rotating pool (permit leads + website leads, last 30 days,
// no owner/contact fields) to power the "something's always happening" popup.
const [{ count: newLeadsCount }, { count: qualifiedPermitCount }, { data: recentPermitsForFeed }, { data: recentLeadsForFeed }] = await Promise.all([
  (supabaseAdmin ?? supabase).from('leads').select('*', { count: 'exact', head: true }).eq('status', 'new'),
  (supabaseAdmin ?? supabase).from('permit_leads').select('*', { count: 'exact', head: true }).eq('permit_status', 'qualified').is('archived_at', null).gte('discovered_at', thirtyDaysAgo),
  (supabaseAdmin ?? supabase).from('permit_leads').select('jurisdiction, permit_type, discovered_at').eq('permit_status', 'qualified').is('archived_at', null).gte('discovered_at', thirtyDaysAgo).order('discovered_at', { ascending: false }).limit(20),
  (supabaseAdmin ?? supabase).from('leads').select('county, created_at').gte('created_at', thirtyDaysAgo).order('created_at', { ascending: false }).limit(10),
]);

const liveOpportunityCount = (newLeadsCount || 0) + (qualifiedPermitCount || 0);

const activityFeed = [
  ...(recentPermitsForFeed || []).map((p) => ({
    title: 'New permit filed',
    subtitle: `${p.permit_type || 'Tree service permit'} · ${p.jurisdiction || 'South Florida'}`,
    at: p.discovered_at,
  })),
  ...(recentLeadsForFeed || []).map((l) => ({
    title: 'New service request',
    subtitle: `Tree service inquiry · ${l.county || 'South Florida'}`,
    at: l.created_at,
  })),
].sort((a, b) => new Date(b.at).getTime() - new Date(a.at).getTime());
---

<MainLayout title="Join the Contractor Network | SF Tree Removal" description="Apply for contractor access, configure your South Florida service territory and review homeowner tree-service opportunities from one dashboard.">
  <Header />

  <!-- Live activity toast — cycles through real recent leads/permits so the
       page feels alive. Honest relative timestamps, never claims "just now"
       for old data. -->
  <div id="activityToast" class="pointer-events-none fixed bottom-4 left-4 z-[60] hidden max-w-[min(22rem,calc(100vw-2rem))] sm:bottom-6 sm:left-6" aria-live="polite">
    <a href="#contractorForm" id="activityToastLink" class="pointer-events-auto group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-2xl ring-1 ring-black/5 backdrop-blur-xl transition hover:-translate-y-0.5 hover:border-green-300 hover:shadow-[0_20px_40px_-12px_rgba(34,197,94,0.35)]">
      <span class="relative mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-green-100">
        <span class="relative flex h-2.5 w-2.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-75"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-500"></span>
        </span>
      </span>
      <div class="min-w-0 flex-1">
        <p id="activityToastTitle" class="text-xs font-bold text-slate-900"></p>
        <p id="activityToastSubtitle" class="mt-0.5 truncate text-[11px] text-slate-500"></p>
        <div class="mt-1 flex items-center justify-between gap-2">
          <p id="activityToastTime" class="text-[10px] font-mono uppercase tracking-wider text-slate-400"></p>
          <span class="text-[10px] font-bold uppercase tracking-wider text-green-700 opacity-0 transition group-hover:opacity-100">Apply →</span>
        </div>
      </div>
      <button id="activityToastClose" type="button" aria-label="Dismiss" class="shrink-0 text-slate-300 transition hover:text-slate-500">✕</button>
    </a>
  </div>
  <script type="application/json" id="activityFeedData" set:html={JSON.stringify(activityFeed)} />

  <!-- Svetla pozadina -->
  <main class="bg-white"> 

    <!-- ============================================== -->
    <!-- 1. HERO SEKCIJA — VIDEO POZADINA + FORMA -->
    <!-- ============================================== -->
    <section class="relative isolate overflow-hidden pt-28 pb-20 lg:pt-36 lg:pb-28 px-4 sm:px-8 lg:min-h-[88vh] lg:flex lg:items-center bg-slate-900">

      <!-- Video pozadina -->
      <div class="absolute inset-0 -z-20">
        <video
          autoplay muted loop playsinline preload="metadata"
          poster="/videos/hero-contractors-poster.webp"
          class="h-full w-full object-cover"
        >
          <source src="/videos/hero-optimized.webm" type="video/webm" media="(min-width: 640px) and (prefers-reduced-motion: no-preference)" />
          <source src="/videos/hero-optimized.mp4" type="video/mp4" media="(min-width: 640px) and (prefers-reduced-motion: no-preference)" />
        </video>
      </div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-950/55"></div>

      <div class="mx-auto max-w-[1320px] grid lg:grid-cols-2 gap-12 items-center relative z-10 w-full">
        
        <!-- LEVO: Tekstualni deo -->
        <div class="max-w-[640px] font-sans selection:bg-green-500/30 selection:text-white lg:pt-4">
          
          <!-- Premium Minimal Badge (Glass) -->
          <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 backdrop-blur-md px-3 py-1.5 shadow-soft">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-green-400"></span>
            </span>
            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/90">
              Contractor partner network
            </span>
          </div>

          <!-- Editorial Heading -->
          <h1 class="mt-6 text-[2.75rem] sm:text-[3.5rem] lg:text-[4rem] font-bold leading-[1.05] tracking-tighter text-white">
            Put local tree-service
            <span class="block mt-1 bg-gradient-to-r from-green-400 to-emerald-400 bg-clip-text text-transparent">
              opportunities
            </span>
            in one dashboard.
          </h1>

          <!-- High-Contrast Subtitle -->
          <p class="mt-6 text-base sm:text-lg leading-relaxed text-white/85 font-medium">
            Apply for account review, select your primary service territory and decide which available homeowner requests fit your operation.
          </p>

          <!-- Clean System Description -->
          <p class="mt-6 text-sm leading-relaxed text-white/60 border-l-2 border-white/20 pl-4 py-1">
            Registration is free. Claiming an available lead uses account credits and unlocks the contact information submitted with that request.
          </p>

          <div class="mt-10 grid grid-cols-2 gap-3 border-t border-white/15 pt-7 sm:grid-cols-4">
            <div class="rounded-xl border border-green-400/30 bg-green-400/10 px-4 py-3 backdrop-blur">
              <div class="flex items-center gap-1.5">
                <span class="relative flex h-1.5 w-1.5">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
                  <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-green-400"></span>
                </span>
                <strong class="block text-lg font-bold text-white">{liveOpportunityCount}</strong>
              </div>
              <span class="mt-1 block text-[9px] font-bold uppercase tracking-[0.16em] text-green-300">Live opportunities</span>
            </div>
            {[
              { value: `${territories?.length || 0}`, label: "Active territories" },
              { value: "Free", label: "Application" },
              { value: "You decide", label: "Which leads to claim" },
            ].map(({ value, label }) => (
              <div class="rounded-xl border border-white/10 bg-white/[0.06] px-4 py-3 backdrop-blur">
                <strong class="block text-lg font-bold text-white">{value}</strong>
                <span class="mt-1 block text-[9px] font-bold uppercase tracking-[0.16em] text-white/50">{label}</span>
              </div>
            ))}
          </div>

        </div>

        <!-- DESNO: Forma (Partner Intake) — Bela "glass" kartica -->
        <div class="w-full max-w-[520px] lg:ml-auto">
        <div id="formCard" class="rounded-2xl sm:rounded-3xl border border-white/40 bg-white/95 backdrop-blur-xl p-6 sm:p-8 shadow-2xl ring-1 ring-black/5 relative overflow-hidden">
          
          <!-- Akcentna traka na vrhu forme -->
          <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-green-500 via-emerald-500 to-green-500"></div>

          <!-- Dekorativni sjaj u uglu forme -->
          <div class="absolute top-0 right-0 -mr-16 -mt-16 w-32 h-32 bg-green-500/10 blur-[50px] rounded-full pointer-events-none"></div>

          <div class="border-b border-slate-200 pb-5 relative">
            <div class="flex items-center justify-between gap-3">
              <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-700">// Partner Intake</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 border border-green-200 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wider text-green-700">
                <span class="h-1.5 w-1.5 rounded-full bg-green-500 animate-pulse"></span>
                Application is free
              </span>
            </div>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">Apply for contractor access</h2>
            <p class="mt-1 text-xs leading-5 text-slate-500">Use current business information. An administrator reviews every application.</p>
          </div>

          <form id="contractorForm" class="mt-6 space-y-5 relative">
            <div>
              <label for="company" class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Company Name</label>
              <input id="company" name="company" type="text" required placeholder="e.g. South Florida Tree Care LLC" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white placeholder:text-slate-400"/>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Contact Name</label>
                <input id="name" name="name" type="text" required placeholder="John Doe" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white placeholder:text-slate-400"/>
              </div>
              <div>
                <label for="phone" class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Direct Phone</label>
                <input id="phone" name="phone" type="tel" required placeholder="(555) 000-0000" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white placeholder:text-slate-400"/>
              </div>
            </div>

            <div>
              <label for="county" class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Service Territory</label>
              <div class="relative">
                <select id="county" name="county" required class="h-12 w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white">
                  <option value="" selected disabled class="text-slate-400">Select Main Territory</option>
                  <!-- DINAMIČKI PRIKAZ IZ BAZE -->
                  {territories?.map((t) => (
                    <option value={t.name}>{t.name}</option>
                  ))}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-slate-400">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </div>
              </div>
            </div>

            <div class="pt-2 border-t border-slate-200">
              <label for="email" class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Email <span class="text-slate-400">(used for login)</span></label>
              <input id="email" name="email" type="email" required placeholder="company@example.com" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white placeholder:text-slate-400"/>
            </div>
            <div>
              <label for="password" class="mb-2 block text-[10px] font-bold uppercase tracking-[0.15em] text-slate-500">Password</label>
              <input id="password" name="password" type="password" required minlength="6" placeholder="min. 6 characters" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20 focus:bg-white placeholder:text-slate-400"/>
            </div>

            <FormDisclaimer />

            <button type="submit" id="submitBtn" class="mt-6 flex h-14 w-full items-center justify-center gap-2 rounded-xl bg-green-500 text-sm font-bold text-white transition-all hover:bg-green-600 active:scale-[0.98] shadow-[0_8px_24px_-6px_rgba(34,197,94,0.5)] hover:shadow-[0_12px_28px_-6px_rgba(34,197,94,0.6)]">
              Apply For Network Access →
            </button>
            <p id="errorMsg" class="hidden text-center text-xs text-red-600"></p>
          </form>

          <div class="mt-6 flex items-center justify-center gap-2 border-t border-slate-200 pt-5 text-[9px] font-mono font-bold uppercase tracking-[0.2em] text-slate-400">
            <span>Account review required before activation</span>
          </div>
        </div>

        <!-- STANJE POSLE USPEŠNE PRIJAVE -->
        <div id="successCard" class="hidden rounded-2xl sm:rounded-3xl border border-green-200 bg-green-50 p-8 text-center shadow-soft-lg">
          <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-700">// Application Received</span>
          <h2 class="mt-4 text-xl font-bold text-slate-900">Application submitted!</h2>
          <p class="mt-3 text-sm text-slate-600" id="successDetail">
            An administrator will review your application. Once approved, you'll get an email and can sign in to start claiming leads.
          </p>
          <a href="/login" class="mt-6 inline-flex h-11 px-6 items-center justify-center rounded-xl border border-slate-300 text-sm font-bold text-slate-700 hover:border-slate-500 transition-all">Go to login →</a>
        </div>
        </div>

      </div>
    </section>

    <section id="benefits" class="border-t border-slate-200 bg-white px-4 py-16 sm:px-8 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1200px]">
        <div class="grid gap-6 lg:grid-cols-[0.9fr_0.7fr] lg:items-end">
          <div><span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-700">// Contractor workspace</span><h2 class="mt-3 text-3xl font-bold tracking-tighter text-slate-950 sm:text-4xl">Review the opportunity before spending a credit.</h2></div>
          <p class="max-w-xl text-sm leading-7 text-slate-600">Your territory determines which project summaries appear. You control which opportunities to claim and which to leave for another provider.</p>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {[
            { icon: MapPinned, label: "Territory", title: "Local matching", text: "See available requests associated with the service territory on your approved profile." },
            { icon: Eye, label: "Before claiming", title: "Project preview", text: "Review the location, service category and project description before making a decision." },
            { icon: Coins, label: "Account credits", title: "Controlled access", text: "Claiming uses the configured number of credits. Your balance and ledger remain visible." },
            { icon: PhoneCall, label: "After claiming", title: "Direct follow-up", text: "Unlock the submitted contact details and discuss the project directly with the homeowner." },
          ].map(({ icon: Icon, label, title, text }) => (
            <article class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-soft transition hover:-translate-y-0.5 hover:border-green-200 hover:shadow-soft-lg">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-green-50 text-green-700"><Icon size={21} strokeWidth={1.7} /></span>
              <span class="mt-6 block text-[9px] font-bold uppercase tracking-[0.18em] text-green-700">{label}</span>
              <h3 class="mt-2 text-lg font-bold text-slate-950">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {permitTeasers && permitTeasers.length > 0 && (
      <section id="permit-leads-teaser" class="relative scroll-mt-20 overflow-hidden border-t-4 border-green-500 bg-slate-950 px-4 py-16 sm:px-8 sm:py-20 lg:scroll-mt-24 lg:py-24">
        <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-green-500/10 blur-[110px]" aria-hidden="true"></div>
        <div class="relative z-10 mx-auto max-w-[1200px]">
          <div class="flex flex-col items-start gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full border border-green-400/30 bg-green-400/10 px-3 py-1.5">
                <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-green-400"></span></span>
                <span class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-green-300">Live · updated automatically</span>
              </div>
              <h2 class="mt-4 text-3xl font-bold tracking-tighter text-white sm:text-4xl">{permitTeasers.length} new permit-driven project{permitTeasers.length === 1 ? "" : "s"}, right now.</h2>
              <p class="mt-3 max-w-xl text-sm leading-7 text-slate-400">We scan public permit filings for tree work across South Florida. Register free to unlock full owner contact details on any of these — and every new one that comes in.</p>
              <p class="mt-2 max-w-xl text-[11px] text-slate-500">Sourced from public county &amp; city permit records — public information, not scraped or purchased data.</p>
            </div>
            <a href="#contractorForm" class="inline-flex h-14 w-full shrink-0 items-center justify-center gap-2 rounded-xl bg-green-500 px-8 text-sm font-bold uppercase tracking-wider text-slate-950 shadow-[0_12px_30px_-10px_rgba(34,197,94,0.6)] transition hover:bg-green-400 lg:w-auto">
              Register free — unlock these leads <ArrowRight size={16} />
            </a>
          </div>

          <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {permitTeasers.map((permit) => (
              <a href="#contractorForm" class="group block rounded-2xl border border-white/10 bg-white/[0.04] p-5 backdrop-blur-sm transition hover:border-green-400/40 hover:bg-white/[0.07]">
                <div class="flex items-center gap-2">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10 text-slate-300"><Lock size={16} strokeWidth={1.8} /></span>
                  <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-slate-400">{permit.jurisdiction || "South Florida"}</span>
                </div>
                <p class="mt-4 text-sm font-bold text-white">{permit.permit_type || "Tree service permit"}</p>
                {permit.permit_description && <p class="mt-2 text-xs leading-5 text-slate-400 line-clamp-2">{permit.permit_description}</p>}
                <p class="mt-4 select-none blur-[5px] text-[11px] text-slate-500">Owner name · (555) 000-0000 · owner@email.com</p>
                <p class="mt-3 text-[10px] font-bold uppercase tracking-wider text-green-400 group-hover:text-green-300">Register to unlock →</p>
              </a>
            ))}
          </div>

          <p class="mt-10 text-center text-xs text-slate-500">No account? Takes under a minute — see contact info the moment you're approved.</p>
        </div>
      </section>
    )}

    <!-- ============================================== -->
    <!-- 3. WORKFLOW ARCHITECTURE (HOW IT WORKS) -->
    <!-- ============================================== -->
    <section id="how-it-works" class="relative overflow-hidden bg-slate-50 py-12 sm:py-16 lg:py-20 border-t border-slate-200 font-sans selection:bg-green-500/30 selection:text-slate-900">
      
      <div class="relative z-10 mx-auto max-w-[1200px] px-4 sm:px-8">
        
        <!-- Header -->
        <div class="mb-8 max-w-2xl sm:mb-10">
          <span class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.2em] text-green-700">// Account lifecycle</span>
          <h2 class="mt-3 text-3xl font-bold tracking-tighter text-slate-950 sm:text-4xl">From application to homeowner follow-up.</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">Approval creates access to the contractor workspace. It does not guarantee request volume, territory exclusivity or that every claimed lead becomes booked work.</p>
        </div>

        <!-- Mreža faza (Optimizovana za Pro Slate izgled) -->
        <div class="grid gap-4 lg:grid-cols-3">
          
          <!-- FAZA 1 -->
          <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-soft">
            <div class="flex items-center justify-between border-b border-slate-200 pb-4 mb-6">
              <span class="text-[9px] font-bold tracking-[0.2em] text-slate-500 uppercase">Phase 01</span>
              <span class="text-[9px] font-mono text-green-700">Intake</span>
            </div>
            <div class="space-y-6">
              {[
                { n: "01", t: "Apply", d: "Submit accurate company, contact and territory information." },
                { n: "02", t: "Account Review", d: "An administrator reviews the application before activation." }
              ].map(step => (
                <div>
                  <div class="flex items-baseline gap-3">
                    <span class="font-mono text-[10px] font-bold text-slate-400">{step.n} //</span>
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">{step.t}</h3>
                  </div>
                  <p class="mt-2 text-[11px] leading-relaxed text-slate-600 pl-8">{step.d}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- FAZA 2: Istaknuta -->
          <div class="rounded-2xl border border-green-200 bg-green-50 p-5 sm:p-6 relative overflow-hidden shadow-soft">
            <div class="absolute top-0 right-0 w-40 h-40 bg-green-500/5 blur-[50px] rounded-full"></div>
            <div class="flex items-center justify-between border-b border-green-500/20 pb-4 mb-6 relative">
