<!-- SCRIPT ZA FORMU I ANALITIKU -->
<script>
  import { supabase } from "../lib/supabase";

  // FUNKCIJA ZA HVATANJE IZVORA SAOBRAĆAJA
  function getTrafficSource() {
    const params = new URLSearchParams(window.location.search);
    const utmSource = params.get('utm_source');
    if (utmSource) return utmSource.toLowerCase();

    const referrer = document.referrer.toLowerCase();
    if (referrer.includes('google')) return 'google';
    if (referrer.includes('facebook') || referrer.includes('fb.com') || referrer.includes('instagram')) return 'facebook';
    if (referrer.includes('bing')) return 'bing';

    return 'organic';
  }

  const form = document.getElementById('contractorForm') as HTMLFormElement;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement;
  const errorMsg = document.getElementById('errorMsg')!;
  const formCard = document.getElementById('formCard')!;
  const successCard = document.getElementById('successCard')!;
  const successDetail = document.getElementById('successDetail')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    btn.disabled = true;
    btn.innerText = "Processing...";

    const formData = new FormData(form);
    const trafficSource = getTrafficSource();

    const company_name = formData.get('company') as string;
    const contact_name = formData.get('name') as string;
    const phone = formData.get('phone') as string;
    const territory = formData.get('county') as string;
    const email = (formData.get('email') as string).trim().toLowerCase();
    const password = formData.get('password') as string;

    const res = await fetch('/api/signup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ role: 'contractor', email, password, companyName: company_name, contactName: contact_name, phone, territory, source: trafficSource }),
    });
    const result = await res.json().catch(() => ({}));

    if (!res.ok || !result.ok) {
      errorMsg.textContent = result.error === 'email_already_registered'
        ? 'This email is already registered. Try signing in instead.'
        : 'Error: ' + (result.message || result.error || 'Could not create account.');
      errorMsg.classList.remove('hidden');
      btn.disabled = false;
      btn.innerText = "Apply For Network Access →";
      return;
    }

    if (result.requiresVerification) {
      successDetail.textContent = `We sent a confirmation link to ${email}. Click it to submit your application for review.`;
      formCard.classList.add('hidden');
      successCard.classList.remove('hidden');
      return;
    }

    // Account is confirmed already — sign in so they land in an active
    // session instead of being told to go log in separately.
    await supabase.auth.signInWithPassword({ email, password });

    formCard.classList.add('hidden');
    successCard.classList.remove('hidden');
  });

  // --- LIVE ACTIVITY TOAST ---
  // Cycles through real recent leads/permits (fetched server-side) so the
  // page feels alive without ever fabricating data. Timestamps are honest
  // relative times ("2h ago"), not "just now" for old rows.
  type ActivityItem = { title: string; subtitle: string; at: string };

  function timeAgo(dateInput: string) {
    const diff = Math.floor((Date.now() - new Date(dateInput).getTime()) / 1000);
    if (diff < 60) return 'Just now';
    if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
    if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
    return `${Math.floor(diff / 86400)}d ago`;
  }

  function startActivityTicker() {
    const dataEl = document.getElementById('activityFeedData');
    const toast = document.getElementById('activityToast');
    if (!dataEl || !toast) return;

    let feed: ActivityItem[] = [];
    try {
      feed = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }
    if (feed.length === 0) return;

    const titleEl = document.getElementById('activityToastTitle')!;
    const subtitleEl = document.getElementById('activityToastSubtitle')!;
    const timeEl = document.getElementById('activityToastTime')!;
    const closeBtn = document.getElementById('activityToastClose')!;

    let index = 0;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;

    function showNext() {
      const item = feed[index % feed.length];
      index++;

      titleEl.textContent = item.title;
      subtitleEl.textContent = item.subtitle;
      timeEl.textContent = timeAgo(item.at);

      toast!.classList.remove('hidden');
      toast!.style.opacity = '0';
      toast!.style.transform = 'translateY(12px)';
      toast!.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
      setTimeout(() => {
        toast!.style.opacity = '1';
        toast!.style.transform = 'translateY(0)';
      }, 20);

      if (hideTimer) clearTimeout(hideTimer);
      hideTimer = setTimeout(hideCurrent, 6000);
    }

    function hideCurrent() {
      toast!.style.opacity = '0';
      toast!.style.transform = 'translateY(12px)';
      setTimeout(() => toast!.classList.add('hidden'), 400);
    }

    closeBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (hideTimer) clearTimeout(hideTimer);
      hideCurrent();
    });

    setTimeout(showNext, 3000);
    setInterval(showNext, 10000);
  }

  startActivityTicker();
</script>
