---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { business } from "../../config/business";
---

<BaseLayout
  title="Thank You | SF Tree Removal"
  description="Your request has been sent. SF Tree Removal will get back to you shortly."
  noindex
>
  <section class="bg-secondary-50 py-section">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 text-center">
      <div class="mx-auto grid h-16 w-16 place-items-center rounded-xl bg-primary-600 text-3xl text-white" aria-hidden="true">✓</div>
      <h1 class="mt-8 text-h1 font-bold text-text ">Thank you!</h1>
      <p id="ty-message" class="mt-6 text-lg text-text-muted">
        Your request has been sent. We pass it to an independent tree care professional, who contacts you about the job
        and your free estimate. If a tree is on a structure or near power lines and anyone is in danger, call 911.
      </p>
      <p id="ty-waiting" hidden class="mt-4 rounded-2xl border border-amber-300 bg-amber-50 p-5 text-left text-amber-900">
        <strong>We are not active in your city yet.</strong> We will try to match your request with a professional and will
        contact you if we can, but we cannot promise a response or a time. If the tree is urgent, call a local tree
        service directly, and for danger to life call 911. Your request helps us decide where to add professionals next.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-accent">Back to Home</a>
        <a href="/tree-care-guides/" class="btn btn-outline">
          Read Tree Care Guides
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      try {
        var c = sessionStorage.getItem('sf_lead_coverage');
        sessionStorage.removeItem('sf_lead_coverage');
        if (c === 'not-yet-active') {
          document.getElementById('ty-waiting').hidden = false;
          document.getElementById('ty-message').textContent = 'Thank you. Your request has been received.';
        }
      } catch (e) {}
    })();
  </script>

  <!-- Conversion event for GA4, sent once per submitted form (not on reloads or direct visits). -->
  <script is:inline>
    (function () {
      var form = null;
      try {
        form = sessionStorage.getItem('sf_lead_sent');
        sessionStorage.removeItem('sf_lead_sent');
      } catch (e) {}
      if (form && typeof window.gtag === 'function') {
        window.gtag('event', 'generate_lead', { form_name: form });
      }
    })();
  </script>
</BaseLayout>
