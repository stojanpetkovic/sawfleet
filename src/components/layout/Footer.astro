---
const currentYear = new Date().getFullYear();

const links = {
  product: [
    { title: "Permit Leads", href: "/permit-leads" },
    { title: "Contractor Directory", href: "/contractors" },
    { title: "Blog", href: "/blog" },
  ],
  legal: [
    { title: "Privacy Policy", href: "/privacy" },
    { title: "Terms of Service", href: "/terms" },
  ]
};
---

<footer class="relative overflow-hidden bg-slate-950 font-sans pb-28 lg:pb-10 pt-10 sm:pt-12 selection:bg-green-400 selection:text-slate-950">
  <div class="pointer-events-none absolute inset-0 opacity-[0.25]" aria-hidden="true" style="background-image: radial-gradient(circle, rgba(255,255,255,0.14) 1px, transparent 1px); background-size: 26px 26px;"></div>
  <div class="pointer-events-none absolute -right-32 -top-40 h-96 w-96 rounded-full bg-green-500/[0.08] blur-[110px]"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-24 h-72 w-72 rounded-full bg-emerald-500/[0.06] blur-[100px]"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mb-12 flex flex-col justify-between gap-6 rounded-2xl border border-white/10 bg-white/[0.04] p-5 backdrop-blur sm:flex-row sm:items-center sm:p-7">
      <div>
        <div class="flex items-center gap-2">
          <span class="relative flex h-1.5 w-1.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-green-400"></span>
          </span>
          <span class="text-[9px] font-mono font-bold uppercase tracking-[0.22em] text-green-400">// Public permit records</span>
        </div>
        <h2 class="mt-2 text-xl font-bold tracking-tight text-white sm:text-2xl">Looking for new jobs in your area?</h2>
        <p class="mt-2 max-w-xl text-xs leading-relaxed text-slate-400">Browse property owners who recently filed a tree-related permit application, with contact details included.</p>
      </div>
      <a href="/permit-leads" class="inline-flex h-11 w-full shrink-0 items-center justify-center rounded-xl bg-green-600 px-5 text-[10px] font-bold uppercase tracking-[0.16em] text-white shadow-[0_12px_30px_-14px_rgba(34,197,94,0.8)] transition hover:bg-green-500 sm:w-auto">Browse Permit Leads →</a>
    </div>

    <div class="xl:grid xl:grid-cols-3 xl:gap-12">

      <!-- Leva strana -->
      <div class="space-y-5">
        <a href="/" class="inline-flex items-center shrink-0 rounded-xl bg-white px-4 py-3">
          <img src="/logo/logo.svg" alt="SF Tree Removal" class="h-auto w-full max-w-[165px]" loading="lazy" />
        </a>
        <p class="text-xs text-slate-400 max-w-sm leading-relaxed">
          A public portal tracking tree-related permit filings and tree care contractors across South Florida — free to browse, updated regularly.
        </p>
        <div class="inline-flex items-center gap-2 rounded-full border border-green-400/20 bg-green-400/10 px-3 py-1.5 text-[9px] font-mono font-bold uppercase tracking-[0.14em] text-green-300"><span class="h-1.5 w-1.5 rounded-full bg-green-400"></span> Public data, updated regularly</div>
      </div>

      <!-- Desna strana -->
      <div class="mt-12 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">

        {Object.entries(links).map(([key, category]) => (
          <div>
            <h3 class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-slate-500">
              // {key.charAt(0).toUpperCase() + key.slice(1)}
            </h3>
            <ul class="mt-4 space-y-2">
              {category.map((link) => (
                <li>
                  <a href={link.href} class="text-xs text-slate-400 hover:text-white transition-colors">
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left space-y-1 text-[9px] font-mono uppercase tracking-[0.12em] text-slate-500">
        <p>&copy; {currentYear} SF Tree Removal. All rights reserved.</p>
        <p>
          Website by{" "}
          <a
            href="https://stojanpetkovic.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-slate-300 transition-colors"
          >Stojan Petković</a>
        </p>
      </div>
      <div class="flex items-center gap-4 text-[9px] font-mono uppercase tracking-[0.12em] text-slate-500">
        <a href="/privacy" class="hover:text-slate-300 transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-slate-300 transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
