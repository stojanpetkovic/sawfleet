---
import type { Pro } from "../data/pros";

interface Props {
  pro: Pro;
  /** A larger card used at the top of the directory. */
  featured?: boolean;
}
const { pro, featured = false } = Astro.props;
---

<article class:list={["relative overflow-hidden rounded-2xl border bg-white shadow-lg", pro.sponsored ? "border-accent-500 ring-2 ring-accent/60" : "border-secondary-200"]}>
  {pro.sponsored && (
    <div class="flex items-center justify-between bg-accent px-5 py-2 text-xs font-bold uppercase tracking-wide text-black">
      <span>Sponsored · Featured</span>
      <span class="hidden font-medium normal-case tracking-normal sm:inline">Paid placement, not a recommendation</span>
    </div>
  )}
  <div class:list={["p-6", featured && "sm:p-8"]}>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h3 class="font-heading text-2xl font-extrabold text-secondary-900">{pro.name}</h3>
        <p class="mt-1 text-secondary-600">{pro.tagline}</p>
      </div>
      <p class="rounded-full bg-primary-100 px-3 py-1 text-xs font-semibold text-primary-800">{pro.area}</p>
    </div>

    <p class="mt-4 leading-relaxed text-secondary-700">{pro.description[0]}</p>

    <ul class="mt-5 grid gap-x-6 gap-y-2 text-sm text-secondary-700 sm:grid-cols-2">
      {pro.services.slice(0, 6).map((s) => (
        <li class="flex gap-2"><span class="mt-0.5 text-primary-600" aria-hidden="true">✓</span>{s}</li>
      ))}
    </ul>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a href={`/find-a-pro/${pro.slug}/#request`} class="btn btn-accent" data-track={`${pro.slug}_request_click`}>Request a quote</a>
      <a href={`/find-a-pro/${pro.slug}/`} class="btn btn-outline" data-track={`${pro.slug}_profile_click`}>View profile</a>
      {pro.phone && pro.phoneHref && <a href={pro.phoneHref} class="btn btn-outline" data-track={`${pro.slug}_call_click`}>Call {pro.phone}</a>}
      <a href={pro.website} class="text-sm font-semibold text-primary-700 underline" data-track={`${pro.slug}_website_click`} target="_blank" rel="sponsored nofollow noopener noreferrer">Visit website ↗</a>
    </div>
    <p class="mt-4 text-xs leading-relaxed text-secondary-500">Details supplied by the company, not verified by SF Tree Removal. Ask for proof of license and insurance.</p>
  </div>
</article>
