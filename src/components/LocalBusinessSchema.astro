---
import { business } from "../config/business";

// schema.org has no TreeService type; HomeAndConstructionBusiness is the
// closest real one, and Google ignores types it does not know.
const schema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${business.url}/#localbusiness`,
  name: business.name,
  url: `${business.url}/`,
  image: `${business.url}/images/og-default.jpg`,
  logo: `${business.url}/images/logo.png`,
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    addressLocality: business.city,
    addressRegion: business.region,
    postalCode: business.postalCode,
    addressCountry: business.country,
  },
  areaServed: business.areaServed.map((name) => ({ "@type": "AdministrativeArea", name })),
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "00:00",
    closes: "23:59",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Tree Services",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Tree Removal", url: `${business.url}/tree-removal/` } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Emergency Tree Removal", url: `${business.url}/emergency-tree-removal/` } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Tree Trimming and Stump Grinding", url: `${business.url}/tree-services/` } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Certified Arborist Services", url: `${business.url}/certified-arborist/` } },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
