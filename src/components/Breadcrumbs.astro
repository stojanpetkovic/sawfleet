---
import { breadcrumbsFor } from '../lib/breadcrumbs';

interface Props {
  /** "dark" for use on the navy banner, "light" on a white page. */
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
const trail = breadcrumbsFor(Astro.url.pathname);
const muted = tone === 'dark' ? 'text-white/70 hover:text-white' : 'text-secondary-500 hover:text-primary-700';
const current = tone === 'dark' ? 'text-white' : 'text-secondary-900 font-medium';
---

{
  trail.length > 1 && (
    <nav aria-label="Breadcrumb" class="mb-5">
      <ol class:list={['flex flex-wrap items-center gap-1.5 text-sm', tone === 'dark' ? 'text-white/70' : 'text-secondary-500']}>
        {trail.map((c, i) => (
          <li class="flex items-center gap-1.5">
            {i > 0 && (
              <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            )}
            {i === trail.length - 1 ? (
              <span aria-current="page" class={current}>{c.name}</span>
            ) : (
              <a href={c.href} class:list={['transition-colors', muted]}>{c.name}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
