---
import { photos, type PhotoKey } from "../config/photos";

// A stock photo with responsive WebP and JPEG sources. Pass `eager` only for
// the image at the top of a page.
interface Props {
  name: PhotoKey;
  alt?: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
  /** Overrides the intrinsic ratio, e.g. "4/3". */
  ratio?: string;
}
const { name, alt, sizes = "(min-width: 1024px) 560px, 100vw", class: className = "", eager = false, ratio } = Astro.props;
const p = photos[name];
const srcset = (ext: string) => p.widths.map((w) => `/images/stock/${name}-${w}.${ext} ${w}w`).join(", ");
const fallbackWidth = p.widths.includes(960) ? 960 : p.widths[p.widths.length - 1];
---

<picture>
  <source type="image/webp" srcset={srcset("webp")} sizes={sizes} />
  <img
    src={`/images/stock/${name}-${fallbackWidth}.jpg`}
    srcset={srcset("jpg")}
    sizes={sizes}
    alt={alt ?? p.alt}
    width={p.w}
    height={p.h}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
    class:list={["size-full object-cover", className]}
    style={ratio ? `aspect-ratio:${ratio}` : undefined}
  />
</picture>
