---
// A selectable card for a radio group or a set of checkboxes. The visible card
// follows the real input, so keyboard and screen reader use is unchanged.
interface Props {
  type?: "radio" | "checkbox";
  name: string;
  value: string;
  label: string;
  description?: string;
  /** SVG path data for a 24x24 outline icon. */
  icon?: string;
  checked?: boolean;
  required?: boolean;
}
const { type = "radio", name, value, label, description, icon, checked = false, required = false } = Astro.props;
---

<label class="tile block cursor-pointer">
  <input type={type} name={name} value={value} checked={checked} required={required} class="sr-only" />
  <span class="tile-body">
    {
      icon && (
        <span class="tile-icon" aria-hidden="true">
          <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={icon} /></svg>
        </span>
      )
    }
    <span class="block min-w-0">
      <span class="block font-heading text-[15px] font-semibold leading-snug text-secondary-900">{label}</span>
      {description && <span class="mt-0.5 block text-xs leading-snug text-secondary-500">{description}</span>}
    </span>
    <span class="tile-check" aria-hidden="true">
      <svg class="size-3" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
    </span>
  </span>
</label>
