---
import { business } from '../config/business';

// GA4 for the site owner, plus the lead collector from stojanpetkovic.com,
// which counts visits, form inquiries and calls for the client report.
const gaId = business.gaId;
const leadsKey = business.leadsSiteKey;
---

{
  gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        // gtag must push the arguments object itself; GA4 ignores plain arrays.
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', gaId, { anonymize_ip: true });
      </script>
    </>
  )
}

{leadsKey && <script is:inline src="https://stojanpetkovic.com/leads.js" data-site-key={leadsKey} defer />}
