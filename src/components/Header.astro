---
const phone = "1-888-452-1505";
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex h-20 items-center justify-between">

      <!-- LOGO -->
      <a href="/" class="flex items-center gap-3 font-extrabold text-slate-900">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-teal-700 text-white">
          SF
        </span>
        <span class="text-lg">Tree Removal</span>
      </a>

      <!-- ================= DESKTOP NAV ================= -->
      <nav class="hidden lg:flex items-center gap-10 text-sm font-semibold text-slate-800">

        <a href="/" class="hover:text-teal-700 transition">Home</a>

        <!-- SERVICES -->
        <div class="relative group">
          <a href="/tree-services/" class="flex items-center gap-1 hover:text-teal-700 transition">
            Services
            <svg class="h-4 w-4 mt-[1px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <div
            class="absolute left-0 top-full mt-4 w-64 rounded-xl bg-white shadow-xl ring-1 ring-black/5
                   opacity-0 invisible translate-y-2
                   group-hover:opacity-100 group-hover:visible group-hover:translate-y-0
                   transition-all duration-200"
          >
            <a href="/tree-removal/" class="block px-6 py-3 hover:bg-gray-50">Tree Removal</a>
            <a href="/emergency-tree-removal/" class="block px-6 py-3 hover:bg-gray-50">Emergency Tree Removal</a>
            <a href="/certified-arborist/" class="block px-6 py-3 hover:bg-gray-50">Certified Arborist</a>
          </div>
        </div>

        <!-- SERVICE AREAS -->
        <div class="relative group">
          <a href="/areas/" class="flex items-center gap-1 hover:text-teal-700 transition">
            Service Areas
            <svg class="h-4 w-4 mt-[1px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <div
            class="absolute left-0 top-full mt-4 w-72 rounded-xl bg-white shadow-xl ring-1 ring-black/5
                   opacity-0 invisible translate-y-2
                   group-hover:opacity-100 group-hover:visible group-hover:translate-y-0
                   transition-all duration-200"
          >
            <a href="/areas/miami-tree-removal/" class="block px-6 py-3 hover:bg-gray-50">Miami</a>
            <a href="/areas/fort-lauderdale-tree-removal/" class="block px-6 py-3 hover:bg-gray-50">Fort Lauderdale</a>
            <a href="/areas/hollywood-tree-service/" class="block px-6 py-3 hover:bg-gray-50">Hollywood</a>
            <a href="/areas/pembroke-pines-tree-removal/" class="block px-6 py-3 hover:bg-gray-50">Pembroke Pines</a>
            <a href="/areas/boca-raton-tree-removal/" class="block px-6 py-3 hover:bg-gray-50">Boca Raton</a>

            <div class="border-t my-2"></div>

            <a href="/areas/broward-county-tree-removal/" class="block px-6 py-3 hover:bg-gray-50">
              Broward County
            </a>
            <a href="/areas/" class="block px-6 py-3 font-semibold text-teal-700">
              View All Service Areas →
            </a>
          </div>
        </div>

        <a href="/tree-care-guides/" class="hover:text-teal-700 transition">Blog</a>
        <a href="/contact-us/" class="hover:text-teal-700 transition">Contact</a>
      </nav>

      <!-- ================= RIGHT ACTIONS ================= -->
      <div class="flex items-center gap-5">

        <a href={`tel:${phone}`} class="hidden md:flex items-center gap-2 text-sm font-semibold text-slate-800">
          📞 {phone}
        </a>

        <a
          href="/contact-us/"
          class="inline-flex items-center gap-2 rounded-full bg-teal-700 px-6 py-3 text-sm font-bold text-white
                 hover:bg-teal-800 transition"
        >
          Let’s Talk
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-white/15">↗</span>
        </a>

        <!-- MOBILE BUTTON -->
        <button
          id="openMenu"
          class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-lg border border-gray-300 text-xl"
          aria-label="Open menu"
        >
          ☰
        </button>
      </div>

    </div>
  </div>
</header>

<!-- ================= MOBILE MENU ================= -->
<div id="mobileMenu" class="fixed inset-0 z-50 pointer-events-none">

  <!-- OVERLAY -->
  <div
    id="menuOverlay"
    class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"
  ></div>

  <!-- PANEL -->
  <div
    id="menuPanel"
    class="absolute right-0 top-0 h-full w-80 bg-white shadow-xl
           translate-x-full transition-transform duration-300"
  >
    <div class="p-6 flex items-center justify-between border-b">
      <strong class="text-lg">Menu</strong>
      <button id="closeMenu" class="text-2xl">✕</button>
    </div>

    <nav class="p-6 space-y-6 font-semibold text-slate-800">
      <a href="/" class="block">Home</a>

      <div>
        <span class="block mb-2 text-xs uppercase text-slate-400">Services</span>
        <a href="/tree-removal/" class="block py-1">Tree Removal</a>
        <a href="/emergency-tree-removal/" class="block py-1">Emergency Tree Removal</a>
        <a href="/certified-arborist/" class="block py-1">Certified Arborist</a>
      </div>

      <div>
        <span class="block mb-2 text-xs uppercase text-slate-400">Service Areas</span>
        <a href="/areas/miami-tree-removal/" class="block py-1">Miami</a>
        <a href="/areas/fort-lauderdale-tree-removal/" class="block py-1">Fort Lauderdale</a>
        <a href="/areas/hollywood-tree-service/" class="block py-1">Hollywood</a>
        <a href="/areas/pembroke-pines-tree-removal/" class="block py-1">Pembroke Pines</a>
        <a href="/areas/boca-raton-tree-removal/" class="block py-1">Boca Raton</a>
        <a href="/areas/broward-county-tree-removal/" class="block py-1 font-semibold">
          Broward County
        </a>
        <a href="/areas/" class="block mt-2 text-teal-700 font-semibold">
          View All Service Areas →
        </a>
      </div>

      <a href="/tree-care-guides/" class="block">Blog</a>
      <a href="/contact-us/" class="block">Contact</a>

      <a
        href={`tel:${phone}`}
        class="mt-6 inline-flex w-full justify-center rounded-full bg-teal-700 px-6 py-3 text-white"
      >
        📞 {phone}
      </a>
    </nav>
  </div>
</div>

<script>
  const openBtn = document.getElementById("openMenu");
  const closeBtn = document.getElementById("closeMenu");
  const menu = document.getElementById("mobileMenu");
  const panel = document.getElementById("menuPanel");
  const overlay = document.getElementById("menuOverlay");

  function openMenu() {
    menu.classList.remove("pointer-events-none");
    overlay.classList.add("opacity-100");
    panel.classList.remove("translate-x-full");
  }

  function closeMenu() {
    overlay.classList.remove("opacity-100");
    panel.classList.add("translate-x-full");
    setTimeout(() => menu.classList.add("pointer-events-none"), 300);
  }

  openBtn.addEventListener("click", openMenu);
  closeBtn.addEventListener("click", closeMenu);
  overlay.addEventListener("click", closeMenu);
</script>
