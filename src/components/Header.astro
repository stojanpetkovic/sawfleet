---
import { season } from "../config/season";
const path = Astro.url.pathname;
const is = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

const services = [
  { label: "Tree Removal", href: "/tree-removal/" },
  { label: "Emergency Tree Removal", href: "/emergency-tree-removal/" },
  { label: "Tree Trimming", href: "/tree-trimming/" },
  { label: "Stump Grinding", href: "/stump-grinding/" },
  { label: "Arborist Assessments", href: "/certified-arborist/" },
];
const areaGroups = [
  {
    name: "Miami-Dade",
    href: "/areas/miami-dade-county-tree-removal/",
    cities: [
      { label: "Miami", href: "/areas/miami-tree-removal/" },
      { label: "Miami Beach", href: "/areas/miami-beach-tree-removal/" },
      { label: "Coral Gables", href: "/areas/coral-gables-tree-removal/" },
      { label: "Hialeah", href: "/areas/hialeah-tree-removal/" },
      { label: "Doral", href: "/areas/doral-tree-removal/" },
    ],
  },
  {
    name: "Broward",
    href: "/areas/broward-county-tree-removal/",
    cities: [
      { label: "Fort Lauderdale", href: "/areas/fort-lauderdale-tree-removal/" },
      { label: "Hollywood", href: "/areas/hollywood-tree-service/" },
      { label: "Pembroke Pines", href: "/areas/pembroke-pines-tree-removal/" },
      { label: "Pompano Beach", href: "/areas/pompano-beach-tree-removal/" },
      { label: "Coral Springs", href: "/areas/coral-springs-tree-removal/" },
      { label: "Plantation", href: "/areas/plantation-tree-removal/" },
    ],
  },
  {
    name: "Palm Beach",
    href: "/areas/palm-beach-county-tree-removal/",
    cities: [
      { label: "Boca Raton", href: "/areas/boca-raton-tree-removal/" },
      { label: "Delray Beach", href: "/areas/delray-beach-tree-removal/" },
      { label: "Boynton Beach", href: "/areas/boynton-beach-tree-removal/" },
      { label: "West Palm Beach", href: "/areas/west-palm-beach-tree-removal/" },
      { label: "Jupiter", href: "/areas/jupiter-tree-removal/" },
      { label: "Palm Beach Gardens", href: "/areas/palm-beach-gardens-tree-removal/" },
    ],
  },
];
const mainLinks = [
  { label: "Find a Pro", href: "/find-a-pro/" },
  { label: "Permit Checker", href: "/permit-checker/" },
  { label: "Blog", href: "/tree-care-guides/" },
];
const moreLinks = [
  { label: "How It Works", href: "/how-it-works/" },
  { label: "Hurricane Checklist", href: "/hurricane-checklist/" },
  { label: "FAQ", href: "/faq/" },
  { label: "About", href: "/about-us/" },
  { label: "For Tree Pros", href: "/for-pros/" },
];
const links = [...mainLinks, ...moreLinks];

const linkClass = (active: boolean) =>
  `px-3 py-2 text-[15px] font-medium transition-colors ${active ? "text-primary-700" : "text-secondary-600 hover:text-primary-700"}`;
---

<header class="sticky top-0 z-50 w-full border-b border-secondary-100 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-site items-center justify-between px-4 py-2.5 sm:px-6">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 transition-opacity hover:opacity-85" aria-label="SF Tree Removal, home">
      <img src="/images/logo-mark-96.png" srcset="/images/logo-mark-96.png 1x, /images/logo-mark-192.png 2x" alt="" width="45" height="51" class="h-[52px] w-auto" />
      <span class="font-heading text-[21px] font-extrabold uppercase leading-[1.04] tracking-tight text-secondary-900">
        SF <span class="text-primary-700">Tree</span><br />Removal
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      <div class="group relative">
        <a href="/tree-services/" class:list={[linkClass(services.some((s) => is(s.href)) || is("/tree-services/") || is("/free-tree-removal/")), "inline-flex items-center gap-1"]}>
          Services
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 9l-7 7-7-7" /></svg>
        </a>
        <div class="invisible absolute left-0 top-full w-64 translate-y-1 rounded-xl border border-secondary-100 bg-white p-2 opacity-0 shadow-xl transition-all duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
          {services.map((s) => <a href={s.href} class="block rounded-md px-4 py-2.5 text-sm font-medium text-text-muted hover:bg-primary-50 hover:text-primary-700">{s.label}</a>)}
        </div>
      </div>

      <div class="group relative">
        <a href="/areas/" class:list={[linkClass(is("/areas/")), "inline-flex items-center gap-1"]}>
          Service Areas
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 9l-7 7-7-7" /></svg>
        </a>
        <div class="invisible absolute left-1/2 top-full w-[34rem] -translate-x-1/2 translate-y-1 rounded-2xl border border-secondary-100 bg-white p-5 opacity-0 shadow-2xl transition-all duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
          <div class="grid grid-cols-3 gap-6">
            {areaGroups.map((g) => (
              <div>
                <a href={g.href} class="mb-2 flex items-center gap-1 font-heading text-[13px] font-bold uppercase tracking-wider text-primary-700 hover:text-primary-900">{g.name} <span aria-hidden="true">→</span></a>
                <ul class="border-l-2 border-primary-100">
                  {g.cities.map((c) => <li><a href={c.href} class:list={["-ml-0.5 block border-l-2 py-1.5 pl-3 text-sm font-medium transition", is(c.href) ? "border-primary-600 text-primary-700" : "border-transparent text-secondary-600 hover:border-primary-500 hover:text-primary-700"]}>{c.label}</a></li>)}
                </ul>
              </div>
            ))}
          </div>
          <a href="/areas/" class="mt-4 flex items-center justify-between rounded-xl bg-primary-50 px-4 py-3 text-sm font-semibold text-primary-800 transition hover:bg-primary-100">
            All 28 cities and the map <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      {mainLinks.map((l) => <a href={l.href} aria-current={is(l.href) ? "page" : undefined} class={linkClass(is(l.href))}>{l.label}</a>)}

      <div class="group relative">
        <button type="button" class:list={[linkClass(moreLinks.some((l) => is(l.href))), "inline-flex items-center gap-1"]} aria-haspopup="true">
          More
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div class="invisible absolute right-0 top-full w-60 translate-y-1 rounded-xl border border-secondary-100 bg-white p-2 opacity-0 shadow-xl transition-all duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
          {moreLinks.map((l) => <a href={l.href} class="block rounded-md px-4 py-2.5 text-sm font-medium text-text-muted hover:bg-primary-50 hover:text-primary-700">{l.label}</a>)}
        </div>
      </div>
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      {season.alert ? <a href="/emergency-tree-removal/" class="btn !bg-red-600 !px-5 !py-2.5 !text-sm !text-white hover:!bg-red-700">Emergency Request</a> : <a href="/contact-us/" class="btn btn-accent !px-5 !py-2.5 !text-sm">Free Estimate</a>}
    </div>

    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      class="grid size-11 place-items-center rounded-xl border border-secondary-200 bg-white text-secondary-800 shadow-sm transition active:scale-95 lg:hidden"
    >
      <span class="flex w-5 flex-col gap-[5px]" aria-hidden="true">
        <span class="h-0.5 w-full rounded-full bg-current"></span>
        <span class="h-0.5 w-3/4 rounded-full bg-current"></span>
        <span class="h-0.5 w-full rounded-full bg-current"></span>
      </span>
    </button>
  </div>
</header>

<!-- ================= MOBILE MENU (outside the header: backdrop-filter would trap a fixed child) ================= -->
<div id="mobile-menu" class="fixed inset-0 z-[60] lg:hidden" aria-hidden="true" inert>
  <div id="menu-overlay" class="absolute inset-0 bg-secondary-950/60 opacity-0 backdrop-blur-sm transition-opacity duration-300"></div>

  <div
    id="menu-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Site menu"
    class="absolute right-0 top-0 flex h-dvh w-[88%] max-w-[22rem] translate-x-full flex-col bg-white shadow-2xl transition-transform duration-300 ease-out"
  >
    <div class="flex items-center justify-between border-b border-secondary-100 px-5 py-3">
      <a href="/" class="flex items-center gap-2.5" aria-label="SF Tree Removal, home">
        <img src="/images/logo-mark-96.png" srcset="/images/logo-mark-96.png 1x, /images/logo-mark-192.png 2x" alt="" width="36" height="41" class="h-10 w-auto" />
        <span class="font-heading text-[17px] font-extrabold uppercase leading-[1.05] tracking-tight text-secondary-900">SF <span class="text-primary-700">Tree</span><br />Removal</span>
      </a>
      <button id="menu-close" type="button" class="grid size-11 place-items-center rounded-xl bg-secondary-100 text-secondary-800 transition active:scale-95" aria-label="Close menu">
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <nav class="grow overflow-y-auto overscroll-contain px-3 py-4" aria-label="Mobile navigation">
      <ul class="space-y-1">
        <li>
          <details class="group rounded-xl open:bg-primary-50" open={services.some((x) => is(x.href))}>
            <summary class="flex min-h-[52px] cursor-pointer list-none items-center justify-between rounded-xl px-4 font-heading text-[17px] font-semibold text-secondary-900 [&::-webkit-details-marker]:hidden">
              <span class="flex items-center gap-3"><span class="grid size-9 place-items-center rounded-lg bg-primary-100 text-primary-700"><svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z" /></svg></span>Services</span>
              <svg class="size-5 text-secondary-400 transition group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <ul class="mx-4 mb-4 ml-[2.4rem] space-y-0.5 border-l-2 border-primary-200 pl-3">
              {services.map((x) => <li><a href={x.href} class:list={["flex min-h-[44px] items-center rounded-lg px-3 text-[15px] font-medium", is(x.href) ? "bg-white text-primary-700 shadow-sm" : "text-secondary-700 active:bg-white"]}>{x.label}</a></li>)}
              <li><a href="/tree-services/" class="flex min-h-[44px] items-center rounded-lg px-3 text-[15px] font-semibold text-primary-700">All tree services →</a></li>
            </ul>
          </details>
        </li>
        <li>
          <details class="group rounded-xl open:bg-primary-50" open={path.startsWith("/areas/")}>
            <summary class="flex min-h-[52px] cursor-pointer list-none items-center justify-between rounded-xl px-4 font-heading text-[17px] font-semibold text-secondary-900 [&::-webkit-details-marker]:hidden">
              <span class="flex items-center gap-3"><span class="grid size-9 place-items-center rounded-lg bg-primary-100 text-primary-700"><svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg></span>Service Areas</span>
              <svg class="size-5 text-secondary-400 transition group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="space-y-4 px-4 pb-4 pt-1">
              {areaGroups.map((g) => (
                <div>
                  <a href={g.href} class="mb-2 flex items-center justify-between font-heading text-[12px] font-bold uppercase tracking-wider text-primary-700">
                    {g.name} County <span aria-hidden="true">→</span>
                  </a>
                  <ul class="flex flex-wrap gap-2">
                    {g.cities.map((c) => (
                      <li>
                        <a href={c.href} class:list={["flex min-h-[40px] items-center rounded-full border px-4 text-[14px] font-medium transition active:scale-95", is(c.href) ? "border-primary-600 bg-primary-600 text-white" : "border-primary-200 bg-white text-secondary-800"]}>{c.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <a href="/areas/" class="flex min-h-[44px] items-center justify-center rounded-xl bg-white text-[15px] font-semibold text-primary-700 shadow-sm ring-1 ring-primary-200">All 28 cities and the map →</a>
            </div>
          </details>
        </li>
        {links.map((l) => (
          <li>
            <a href={l.href} class:list={["flex min-h-[52px] items-center justify-between rounded-xl px-4 font-heading text-[17px] font-semibold", is(l.href) ? "bg-primary-50 text-primary-700" : "text-secondary-900 active:bg-secondary-50"]}>
              {l.label}
              <svg class="size-5 text-secondary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="border-t border-secondary-100 bg-secondary-50 px-5 pt-4 pb-[max(1.25rem,env(safe-area-inset-bottom))]">
      <a href="/contact-us/" class="btn btn-accent w-full !min-h-[54px] !text-base">
        Get a Free Estimate
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
      </a>
      <a href="/emergency-tree-removal/" class="btn btn-outline mt-3 w-full !min-h-[50px] !border-secondary-300 !bg-white !text-base">
        <svg class="size-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        Emergency Tree Removal
      </a>
      <p class="mt-3 text-center text-xs text-secondary-500">Free, no obligation. Active in the Fort Lauderdale area.</p>
    </div>
  </div>
</div>

<script>
  const root = document.documentElement;
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const panel = document.getElementById("menu-panel");
  const overlay = document.getElementById("menu-overlay");
  const closeBtn = document.getElementById("menu-close");

  function setOpen(open: boolean) {
    if (!btn || !menu || !panel || !overlay) return;
    btn.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-hidden", String(!open));
    menu.toggleAttribute("inert", !open);
    panel.classList.toggle("translate-x-full", !open);
    overlay.classList.toggle("opacity-0", !open);
    root.classList.toggle("menu-open", open);
    document.body.style.overflow = open ? "hidden" : "";
    if (open) closeBtn?.focus();
    else btn.focus({ preventScroll: true });
  }

  btn?.addEventListener("click", () => setOpen(true));
  closeBtn?.addEventListener("click", () => setOpen(false));
  overlay?.addEventListener("click", () => setOpen(false));
  panel?.addEventListener("click", (e) => {
    if (e.target instanceof Element && e.target.closest("a[href]")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => e.key === "Escape" && btn?.getAttribute("aria-expanded") === "true" && setOpen(false));
  window.addEventListener("resize", () => window.matchMedia("(min-width: 1024px)").matches && setOpen(false));
</script>
