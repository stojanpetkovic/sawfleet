---
import type { Pro } from "../data/pros";

// A request form for a listed pro. It goes to SF Tree Removal's lead inbox,
// clearly marked as coming from this site and meant for the pro, and is passed
// on by hand. The visitor is told so.
interface Props {
  pro: Pro;
  /** Where this form sits, for the lead record. */
  where?: string;
}
const { pro, where = "directory" } = Astro.props;
const services = ["Tree removal", "Emergency tree removal", "Tree trimming or pruning", "Stump grinding", "Arborist assessment", "Not sure yet"];
---

<section id="request" class="scroll-mt-28">
  <div class="form-card">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="font-heading text-2xl font-extrabold text-secondary-900">Request a quote from {pro.name}</h2>
        <p class="mt-1 text-secondary-600">Tell us about the tree. We send your request to {pro.name}, which serves {pro.area.toLowerCase()}.</p>
      </div>
      <span class="rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-wide text-black">Sponsored</span>
    </div>

    <form data-lead-form={`request-${pro.slug}`} data-lead-ignore data-forward-to={pro.name} class="space-y-5" novalidate>
      <input type="hidden" name="requested_pro" value={pro.name} />
      <input type="hidden" name="request_source" value={`sftreeremoval.com directory (${where})`} />
      <input type="hidden" name="listing_type" value={pro.sponsored ? "sponsored" : "standard"} />

      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block"><span class="field-label">Your name *</span><input name="name" required autocomplete="name" class="field-input" /></label>
        <label class="block"><span class="field-label">Phone *</span><input name="phone" type="tel" required autocomplete="tel" placeholder="(954) 555-0100" class="field-input" /></label>
        <label class="block"><span class="field-label">Email</span><input name="email" type="email" autocomplete="email" placeholder="you@email.com" class="field-input" /></label>
        <label class="block"><span class="field-label">City or address of the tree *</span><input name="city" required placeholder="Fort Lauderdale" class="field-input" /></label>
      </div>
      <label class="block">
        <span class="field-label">What do you need?</span>
        <select name="service" class="field-input">{services.map((s) => <option value={s}>{s}</option>)}</select>
      </label>
      <label class="block"><span class="field-label">Tell us about the tree *</span><textarea name="message" rows="4" required class="field-input" placeholder="Type of tree, size, how close to the house or power lines, any damage…"></textarea></label>

      <label class="flex items-start gap-3 rounded-xl bg-secondary-50 p-4 text-sm text-secondary-700">
        <input type="checkbox" name="consent_forward" value="yes" required class="mt-1 size-4 accent-[#0a9a47]" />
        <span>I agree that SF Tree Removal sends my details to {pro.name} so they can contact me about this request. <a href="/privacy-policy/" class="font-semibold text-primary-700 underline">Privacy Policy</a></span>
      </label>

      <input name="website_hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <p data-lead-error hidden class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></p>
      <button type="submit" class="btn btn-accent w-full !py-4 !text-base sm:w-auto">Send my request to {pro.name}</button>
      <p class="text-xs leading-relaxed text-secondary-500">Sponsored listing. {pro.name} is an independent company; SF Tree Removal does not perform the work and has not verified the company's details. Ask for proof of license and insurance.</p>
    </form>
  </div>
</section>
