---
import { business } from "../config/business";
const year = new Date().getFullYear();
---

<footer class="bg-[#dfeceb] text-slate-800">

  <!-- ================= CTA / NEWSLETTER ================= -->
  <div class="max-w-7xl mx-auto px-6 pt-24 pb-20">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- LEFT -->
      <div>
        <h2 class="text-4xl md:text-5xl font-extrabold leading-tight text-slate-900">
          Let’s Build a <br class="hidden sm:block" />
          Safer Property Together
        </h2>

        <p class="mt-6 max-w-xl text-slate-600">
          From emergency tree removal to long-term tree care, SF Tree Removal is
          your trusted local partner across South Florida.
        </p>

        <a
          href="/contact-us/"
          class="mt-8 inline-flex items-center gap-4 rounded-full bg-teal-700 px-6 py-3
                 text-white font-bold hover:bg-teal-800 transition"
        >
          <span class="flex -space-x-2" aria-hidden="true">
            <span class="grid h-8 w-8 place-items-center rounded-full border-2 border-white bg-teal-600 text-sm">📝</span>
            <span class="grid h-8 w-8 place-items-center rounded-full border-2 border-white bg-teal-600 text-sm">🌳</span>
            <span class="grid h-8 w-8 place-items-center rounded-full border-2 border-white bg-teal-600 text-sm">🛡️</span>
          </span>
          Let’s Talk →
        </a>
      </div>

      <!-- RIGHT: quick estimate request -->
      <div class="rounded-2xl bg-teal-700 p-8 text-white">
        <h3 class="text-xl font-bold">Get a Free Estimate</h3>
        <p class="mt-2 text-sm text-white/85">Leave your number and we'll call you back, usually the same day.</p>

        <form data-lead-form="footer-estimate" data-lead-ignore class="mt-6 space-y-3">
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="sr-only">Your name</span>
              <input name="name" required autocomplete="name" placeholder="Your name"
                class="w-full rounded-full bg-white px-5 py-3 text-sm text-slate-800 outline-hidden focus:ring-2 focus:ring-teal-300" />
            </label>
            <label class="block">
              <span class="sr-only">Phone number</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="Phone number"
                class="w-full rounded-full bg-white px-5 py-3 text-sm text-slate-800 outline-hidden focus:ring-2 focus:ring-teal-300" />
            </label>
          </div>
          <label class="block">
            <span class="sr-only">What do you need?</span>
            <input name="message" placeholder="What do you need? (e.g. remove a palm tree)"
              class="w-full rounded-full bg-white px-5 py-3 text-sm text-slate-800 outline-hidden focus:ring-2 focus:ring-teal-300" />
          </label>
          <!-- Left empty by people; bots fill it in. -->
          <input name="website_hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <button type="submit" class="w-full rounded-full bg-teal-900 px-6 py-3 font-bold transition hover:bg-teal-950">
            Request a Call Back ↗
          </button>
          <p data-lead-error hidden class="rounded-lg bg-white/15 px-4 py-2 text-sm" role="alert"></p>
          <p class="text-xs text-white/75">
            By sending this form you agree to our <a href="/privacy-policy/" class="underline">Privacy Policy</a>.
          </p>
        </form>
      </div>

    </div>
  </div>

  <!-- ================= LINKS ================= -->
  <div class="max-w-7xl mx-auto px-6 pb-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-12">

      <!-- COMPANY -->
      <div>
        <h4 class="font-bold mb-4 text-slate-900">Our Company</h4>
        <p class="text-sm text-slate-600 leading-relaxed">
          SF Tree Removal provides professional, licensed and insured tree services
          focused on safety, efficiency and long-term tree health.
        </p>

        <div class="mt-6 flex gap-6 text-sm font-semibold">
          <span>🌿 ISA Certified</span>
          <span>⚡ Emergency 24/7</span>
        </div>
      </div>

      <!-- SERVICES -->
      <div>
        <h4 class="font-bold mb-4 text-slate-900">Services</h4>
        <ul class="space-y-3 text-sm text-slate-700">
          <li><a href="/tree-removal/" class="hover:text-teal-700">Tree Removal</a></li>
          <li><a href="/emergency-tree-removal/" class="hover:text-teal-700">Emergency Tree Removal</a></li>
          <li><a href="/tree-services/" class="hover:text-teal-700">Tree Services</a></li>
          <li><a href="/certified-arborist/" class="hover:text-teal-700">Certified Arborist</a></li>
          <li><a href="/tree-care-guides/" class="hover:text-teal-700">Tree Care Guides</a></li>
        </ul>
      </div>

      <!-- RESOURCES -->
      <div>
        <h4 class="font-bold mb-4 text-slate-900">Resources</h4>
        <ul class="space-y-3 text-sm text-slate-700">
          <li><a href="/contact-us/" class="hover:text-teal-700">Contact Us</a></li>
          <li><a href="/about-us/" class="hover:text-teal-700">About Us</a></li>
          <li><a href="/tree-removal-permits/" class="hover:text-teal-700">Permits & Regulations</a></li>
          <li><a href="/faq/" class="hover:text-teal-700">FAQ</a></li>
        </ul>
      </div>

      <!-- OFFICE -->
      <div>
        <h4 class="font-bold mb-4 text-slate-900">Our Office</h4>
        <ul class="space-y-3 text-sm text-slate-700">
          <li>South Florida, USA</li>
          <li class="flex items-center gap-2">
            ⏱ Mon–Sun 24/7 Emergency
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- ================= BOTTOM BAR ================= -->
  <div class="bg-teal-700">
    <div
      class="max-w-7xl mx-auto px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-6
                 text-sm text-white"
    >
      <div class="text-center md:text-left space-y-1">
        <p>© {year} {business.name}. All rights reserved.</p>
        <p class="text-xs text-white/80">
          Website by{" "}
          <a href="https://stojanpetkovic.com/" target="_blank" rel="noopener noreferrer" class="underline hover:text-white">Stojan Petković</a>
        </p>
      </div>

      <div class="flex items-center gap-6">
        <a href="/privacy-policy/" class="hover:underline">Privacy Policy</a>
        <a href="/terms/" class="hover:underline">Terms & Conditions</a>
      </div>
    </div>
  </div>

</footer>
