---
import SectionHeading from "./SectionHeading.astro";

// The three steps of the service, shown on the home page and the service pages.
interface Props {
  title?: string;
}
const { title = "How It Works" } = Astro.props;

const steps = [
  {
    n: "1",
    title: "Tell us about the tree",
    text: "Send the form with the type of tree, where it is and what is wrong. Photos and details help local pros quote accurately.",
    icon: "M4 6h16M4 12h16M4 18h7",
  },
  {
    n: "2",
    title: "We connect you with a pro",
    text: "In our active area, Fort Lauderdale and the surrounding area, an independent professional contacts you. Elsewhere we are adding professionals: we try to match you, but cannot promise a response. Mark emergencies and we flag them as urgent.",
    icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  },
  {
    n: "3",
    title: "You decide",
    text: "You get a free estimate and agree the work, price and schedule directly with the professional. There is no obligation.",
    icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
  },
];
---

<section class="relative bg-secondary-50 py-section">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading topper="Simple process" title={title} description="Three steps, no obligation, and you stay in control of the decision." />
    <ol class="relative grid gap-8 md:grid-cols-3">
      <div class="pointer-events-none absolute left-[16.6%] right-[16.6%] top-9 hidden h-0.5 bg-gradient-to-r from-primary-200 via-primary-400 to-primary-200 md:block" aria-hidden="true"></div>
      {
        steps.map((s) => (
          <li class="card-static group relative p-7 text-center transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <span class="relative z-10 mx-auto grid size-[4.5rem] place-items-center rounded-full bg-gradient-to-br from-primary-500 to-primary-700 font-heading text-2xl font-extrabold text-white shadow-lg ring-8 ring-white transition group-hover:scale-105" aria-hidden="true">{s.n}</span>
            <h3 class="mt-6 font-heading text-h3 font-semibold text-secondary-900">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-secondary-600">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
