<section class="relative overflow-hidden rounded-2xl bg-slate-950 text-white">
  <!-- BACKGROUND GRADIENT -->
  <div class="absolute inset-0 bg-linear-to-br from-teal-800/40 via-slate-900 to-slate-950"></div>

  <!-- DECORATIVE LINES (LEFT) -->
  <div class="absolute inset-y-0 left-0 w-40 bg-[repeating-linear-gradient(135deg,rgba(255,255,255,0.04)_0,rgba(255,255,255,0.04)_1px,transparent_1px,transparent_8px)]"></div>

  <!-- CONTENT -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 pt-28 pb-20">
    <div class="grid lg:grid-cols-2 gap-20 items-start">

      <!-- LEFT TEXT -->
      <div>
        <span
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1 text-xs font-semibold tracking-wide text-teal-200"
        >
          🌿 PROFESSIONAL TREE SERVICES
        </span>

        <h1 class="mt-6 text-4xl md:text-5xl xl:text-6xl font-extrabold leading-tight">
          Protecting Your Property <br class="hidden sm:block" />
          with Smart Tree Solutions.
        </h1>

        <p class="mt-6 max-w-xl text-slate-300 text-lg">
          From emergency tree removal to expert arborist care, SF Tree Removal
          delivers safe, efficient and professional tree services across
          South Florida.
        </p>

        <!-- CTA -->
        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a
            href="/contact-us/"
            class="inline-flex items-center gap-3 rounded-full bg-teal-700 px-7 py-4
                   font-bold text-white hover:bg-teal-800 transition"
          >
            Get Started
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/15">
              ↗
            </span>
          </a>

          <p class="text-sm text-slate-400 max-w-xs">
            Available 24/7 for emergency tree removal & storm damage response.
          </p>
        </div>
      </div>

<!-- RIGHT IMAGE -->
<div class="relative">
  <div
    class="relative h-[440px] md:h-[480px] xl:h-[520px]
           overflow-hidden rounded-2xl border border-white/10
           shadow-2xl"
  >
    <!-- IMAGE -->
    <picture>
      <source srcset="/images/hero/hero-main-1280.webp" type="image/webp" />
      <img
        src="/images/hero/hero-main-1280.jpg"
        alt="Professional tree removal service in South Florida"
        width="1280"
        height="960"
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <!-- SUBTLE OVERLAY -->
    <div class="absolute inset-0 bg-linear-to-t from-black/25 via-transparent to-transparent"></div>
  </div>

  <!-- RATING BADGE -->
  <div
    class="absolute top-6 left-6 rounded-xl bg-white/95 px-6 py-4
           text-slate-900 shadow-lg backdrop-blur-sm"
  >
    <div class="flex items-center gap-2 text-3xl font-extrabold leading-none">
      4.8 <span class="text-teal-700">★</span>
    </div>
    <p class="mt-1 text-xs font-semibold">
      Rated by 500+ local customers
    </p>
  </div>
</div>

    </div>
  </div>
</section>
