---
// Form Disclaimer - prikazuje se ispod formi da informira korisnike o uslovima korišćenja
// Koristi se sa: <FormDisclaimer />
---

<div class="mt-6 pt-4 border-t border-slate-200">
  <label class="flex items-start gap-3 cursor-pointer group">
    <input 
      type="checkbox" 
      name="terms_accepted" 
      required 
      class="mt-1 w-4 h-4 rounded border-slate-300 accent-green-500 cursor-pointer shrink-0" 
    />
    <span class="text-xs leading-relaxed text-slate-600">
      By submitting this form, I acknowledge that I have read and agree to the
      <a href="/terms" target="_blank" rel="noopener noreferrer" class="font-bold text-green-600 hover:text-green-700 underline">Terms of Service</a>
      and
      <a href="/privacy" target="_blank" rel="noopener noreferrer" class="font-bold text-green-600 hover:text-green-700 underline">Privacy Policy</a>.
      I understand the risks associated with tree service work and confirm that all information provided is accurate and truthful.
    </span>
  </label>
</div>

<style>
  input[type="checkbox"]:focus {
    ring-width: 2px;
    ring-color: rgb(34 197 94 / 0.2);
  }
</style>
