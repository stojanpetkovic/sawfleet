---
// A colored statement band under the hero, with four short promises we can keep.
const items = [
  { label: "Free estimates" },
  { label: "No obligation" },
  { label: "Active in Fort Lauderdale area" },
  { label: "Urgent requests flagged" },
];
---

<section class="relative overflow-hidden bg-gradient-to-r from-primary-800 to-primary-700 py-12 text-white md:py-16" aria-label="What you get" data-no-reveal>
  <div class="mx-auto grid max-w-site items-center gap-8 px-4 sm:px-6 md:grid-cols-2">
    <p class="font-heading text-3xl font-bold leading-tight md:text-4xl">
      One request. <span class="rounded-md bg-accent px-2 py-0.5 text-black">Local</span> pros.<br class="hidden sm:block" />
      A free estimate.
    </p>
    <ul class="grid gap-3 sm:grid-cols-2 md:justify-self-end" role="list">
      {
        items.map(({ label }) => (
          <li class="flex items-center gap-2.5 text-white/90">
            <svg class="size-5 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span class="font-medium">{label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
