---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import Tracking from "../components/Tracking.astro";
import MobileCta from "../components/MobileCta.astro";
import SeasonBanner from "../components/SeasonBanner.astro";
import { Font } from "astro:assets";
import "../styles/global.css";

// Everything except the content goes straight to SeoHead, which owns the meta
// tags and the structured data.
const {
  title = "SF Tree Removal | Professional Tree Service South Florida",
  description = "Free tree removal estimates in the Fort Lauderdale area, plus permit rules, costs and guides for South Florida.",
  ...seo
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- ================= SEO META ================= -->
    <SeoHead title={title} description={description} {...seo} />

    <!-- ================= FONTS ================= -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body class="min-h-screen bg-white font-sans text-text antialiased">

    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:font-semibold focus:text-primary-fg"
    >
      Skip to content
    </a>

    <!-- ================= TRACKING ================= -->
    <Tracking />

    <SeasonBanner />

    <!-- ================= HEADER ================= -->
    <Header />

    <!-- ================= MAIN CONTENT ================= -->
    <main id="content" class="relative">
      <slot />
    </main>

    <!-- ================= FOOTER ================= -->
    <Footer />

    <MobileCta />

    <script>
      import "../scripts/lead-forms";
      import "../scripts/enhance";
      import "../scripts/steps";
    </script>

  </body>
</html>
